# =============================================================================
# FANDEX 单仓库根 .gitignore
# =============================================================================
# 设计原则：
# 1. 根 .gitignore 负责共享规则与跨子项目的敏感文件排除
# 2. 各子项目（app-web/app-desktop/app-Android-*）保留各自的 .gitignore 作为
#    独立构建时的兜底，与本文件的少量重复属有意设计
# 3. 敏感文件（私钥/密钥库/本地配置）采用最严格策略，前置排除避免误提交
# 4. 目录命名遵循英文简写前缀约定：app-（应用）/cnt-（内容）/shd-（共享）/tls-（工具）/thd-（第三方）/dcs-（文档）
# =============================================================================


# -----------------------------------------------------------------------------
# 密钥与签名材料（最高优先级，严禁入库）
# -----------------------------------------------------------------------------

*.private-key.hex
*.public-key.hex
*.private-key.pem
*.public-key.pem

# Tauri updater 签名密钥
*.tauri-key
tauri-private-key.*

# Android 签名密钥库与本地配置
app-Android-new/fandex-release.jks
app-Android-new/*.jks
app-Android-new/*.keystore
app-Android-new/local.properties

# 通用密钥与证书文件
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
secrets.json
secrets.*.json


# -----------------------------------------------------------------------------
# 环境变量文件
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local
!.env.example


# -----------------------------------------------------------------------------
# 依赖与工具缓存目录
# -----------------------------------------------------------------------------
node_modules/
.pnpm-store/
.yarn/cache/
.yarn/install-state.gz

# Python 运行缓存与虚拟环境
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Astro 缓存
.astro/

# Gradle / Kotlin 编译缓存
.gradle/
.kotlin/

# ESLint 增量缓存
.eslintcache


# -----------------------------------------------------------------------------
# 构建产物
# -----------------------------------------------------------------------------

# 通用构建输出
dist/
dist-mobile/
build/
out/
.output/

# Rust / Tauri 编译产物
target/
src-tauri/target/
app-desktop/src-tauri/target/
*.rs.bk

# Android 构建产物
app-Android-new/app/build/
app-Android-new/build/
app-Android-new/app/.cxx/
*.apk
*.aab
*.ap_
*.dex

# Tauri 打包产物（CI 直接上传到 Release，不入库）
*.nsis.zip
*.app-image.tar.gz
*.app.tar.gz
*.dmg
*.msi
*.sig

# 测试覆盖率
coverage/
*.lcov
.nyc_output/

# Pagefind 索引（构建生成）
public/pagefind/
app-desktop/public/pagefind/

# app-web/reports 构建分析报告（CI 产物，不入库）
app-web/reports/

# app-web/src/content/docs/ markdown 副本（由 cnt-content/full/ 同步生成，不入库）
app-web/src/content/docs/

# TypeScript 增量编译缓存
*.tsbuildinfo


# -----------------------------------------------------------------------------
# IDE / 编辑器
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project
.project
.classpath
.settings/

# Trae IDE 工作区
.trae/

# Cursor
.cursor/
.cursorignore

# IntelliJ 模块文件（子项目各自忽略，此处兜底根目录散落场景）
*.iml


# -----------------------------------------------------------------------------
# 操作系统生成文件
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/


# -----------------------------------------------------------------------------
# PowerShell 脚本与本地运行产物
# -----------------------------------------------------------------------------

# 一次性 PowerShell 脚本（本地运维/调试用，不入库）
*.ps1
*.psm1
*.psd1

# PowerShell 控制台历史与本地 profile
ConsoleHost_history.txt
Microsoft.PowerShell_profile.ps1


# -----------------------------------------------------------------------------
# 日志与临时产物
# -----------------------------------------------------------------------------
*.log
*.tmp
*.temp
*.orig
*.rej
*.bak

# Playwright 测试产物
test-results/
playwright-report/
playwright/.cache/

# Lighthouse CI 本地运行产物
.lighthouseci/

# 内容层同步辅助文件（ID 注册表等历史管线文件已退役，防止再生成入库）
cnt-content/full/_doc-id-map.json
cnt-content/full/_id-registry.json
cnt-content/full/_archived-ids.json
cnt-content/full/_op-list.json


# -----------------------------------------------------------------------------
# 自动生成文档
# -----------------------------------------------------------------------------
CODE_WIKI.md
Code-Wiki.md

# Obsidian 工作区配置（本地编辑器状态，不入库）
.obsidian/
