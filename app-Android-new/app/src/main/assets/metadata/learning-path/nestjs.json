{
  "version": "2.0.0",
  "module": "nestjs",
  "summary": "从三件套到生产规模：模块控制器服务起步，经请求管线与配置校验，走向缓存队列、微服务与测试。",
  "stages": [
    {
      "id": "basics",
      "title": "框架基础",
      "subtitle": "三件套与校验",
      "nodes": [
        {
          "id": "nest-001",
          "title": "概述与快速上手",
          "desc": "IoC 与装饰器心智模型",
          "difficulty": "beginner",
          "doc": "015-NestJSOverview"
        },
        {
          "id": "nest-002",
          "title": "模块、控制器与服务",
          "desc": "组织应用的最小骨架",
          "difficulty": "beginner",
          "doc": "016-ModuleControllerService"
        },
        {
          "id": "nest-003",
          "title": "管道校验与异常处理",
          "desc": "DTO 校验与统一错误",
          "difficulty": "beginner",
          "doc": "017-ValidationPipes"
        }
      ]
    },
    {
      "id": "pipeline-config",
      "title": "请求管线与配置",
      "subtitle": "守卫、拦截器、过滤器与配置",
      "nodes": [
        {
          "id": "nest-101",
          "title": "守卫与请求生命周期",
          "desc": "CanActivate 与角色鉴权",
          "difficulty": "intermediate",
          "doc": "020-GuardsAndLifecycle"
        },
        {
          "id": "nest-102",
          "title": "拦截器与异常过滤器",
          "desc": "环绕逻辑与错误兜底",
          "difficulty": "intermediate",
          "doc": "021-InterceptorsAndFilters"
        },
        {
          "id": "nest-103",
          "title": "配置与环境变量校验",
          "desc": "启动即校验的类型安全配置",
          "difficulty": "intermediate",
          "doc": "022-ConfigEnvValidation"
        }
      ]
    },
    {
      "id": "data-scale",
      "title": "数据与规模化",
      "subtitle": "数据库、缓存队列、微服务与测试",
      "nodes": [
        {
          "id": "nest-201",
          "title": "接入数据库",
          "desc": "Prisma + PostgreSQL 集成",
          "difficulty": "intermediate",
          "doc": "018-DatabaseIntegration"
        },
        {
          "id": "nest-202",
          "title": "缓存与消息队列",
          "desc": "CacheModule 与 BullMQ",
          "difficulty": "advanced",
          "doc": "023-CachingAndQueues"
        },
        {
          "id": "nest-203",
          "title": "微服务与健康检查",
          "desc": "传输层与 ClientProxy",
          "difficulty": "advanced",
          "doc": "024-MicroservicesAndHealth"
        },
        {
          "id": "nest-204",
          "title": "单元与端到端测试",
          "desc": "TestBed 与 E2E",
          "difficulty": "intermediate",
          "doc": "019-Testing"
        }
      ]
    }
  ]
}
