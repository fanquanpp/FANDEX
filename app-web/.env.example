# FANDEX app-web 环境变量模板（入库公开，不含敏感值）
#
# 使用方式：
#   cp .env.example .env.local
#   然后按需填入真实值
#
# .env.local 已被 .gitignore 排除，不会入库。
# 全部变量均为构建期注入（Astro public env），改动后需重新构建生效。

# 站点对外 URL（canonical / og:url / RSS / sitemap 的基准地址）
# 默认：https://fanquanpp.github.io/FANDEX
PUBLIC_SITE_URL=

# 桌面端变体开关：置 1 时 Astro base 切为根路径、CSP 换桌面收紧版、
# 剔除前端实验室与 AI 设置页（由 app-desktop 构建编排自动注入，手动勿设）
# DESKTOP_BUILD=1

# 构建产物分析：置 1 时挂载 rollup-plugin-visualizer 输出体积报告
# ANALYZE_BUNDLE=1

# 本地静态服务器（Playwright / Lighthouse 共用）端口，默认 4173
# LHCI_PORT=4173
