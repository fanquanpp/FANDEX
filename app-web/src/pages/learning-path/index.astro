---
/**
 * 学习路径总览页
 * -----------------------------------------------------------------------------
 * 展示已配置知识地图的技术卡片（按分类分组），每张卡片包含覆盖统计与进度条，
 * 点击进入单技术思维导图页。
 */
import HomeLayout from '@/components/HomeLayout.astro'
import SEO from '@/components/SEO.astro'
import GeoBgDecor from '@/components/GeoBgDecor.astro'
import Footer from '@/components/Footer.astro'
import { SITE, IS_DESKTOP_BUILD } from '@/lib/constants'
import { categoryColors, getModule, getPrimaryCategory } from '@/lib/modules'
import { getCategories } from '@/services'
import {
  getLearningPathModules,
  getLearningPathTechVM,
} from '@/lib/learning-path'
// 复用首页 Hero / 统计 / 功能入口 / 分类组件样式，保证美术与语法速览页完全一致
import '@/styles/pages/index.css'
import '@/styles/pages/learning-path.css'

const base = import.meta.env.BASE_URL

// 技术卡片数据：模块元数据 + 视图模型（服务端组装）
const techCards = getLearningPathModules()
  .map((module) => {
    const meta = getModule(module)
    const vm = getLearningPathTechVM(module, base)
    if (!meta || !vm) return null
    return { module, meta, vm, category: getPrimaryCategory(meta) }
  })
  .filter((card): card is NonNullable<typeof card> => card !== null)

// 按主分类分组（沿用首页分类顺序与配色）
const grouped = getCategories()
  .map((cat) => ({
    ...cat,
    cards: techCards.filter((card) => card.category === cat.id),
  }))
  .filter((group) => group.cards.length > 0)

// 聚合统计
const total = techCards.reduce(
  (acc, card) => ({
    nodes: acc.nodes + card.vm.stats.nodes,
    docs: acc.docs + card.vm.stats.docs,
    gaps: acc.gaps + card.vm.stats.gaps,
  }),
  { nodes: 0, docs: 0, gaps: 0 },
)

/** 已配置思维导图的技术集合（用于知识体系芯片跳转） */
const pathModules = new Set(getLearningPathModules())

/**
 * 职业路线规划数据
 * 依据主流职业发展路径与知识体系结构整理，模块均引用站内真实内容：
 * - 前端：基础（HTML/CSS/JS）→ 框架进阶（TS/Vue/React）→ 工程化与架构
 * - 后端：语言与基础 → 数据与算法 → 架构与工程
 * - 全栈：前端 + 后端 + 贯通交付
 * - DevOps：工具与网络 → 云与自动化 → 平台工程
 * - 数据：语言与数据 → 存储与管道 → AI 素养
 */
const careers = [
  {
    id: 'frontend',
    index: '01',
    title: '前端工程师',
    en: 'Frontend Engineer',
    color: categoryColors.frontend,
    status: '已开放',
    desc: '从 HTML / CSS / JavaScript 起步，经 TypeScript 与主流框架进阶，最终走向工程化与架构设计。',
    stages: [
      { label: '入门基础', points: ['HTML5', 'CSS', 'JavaScript', 'Git'] },
      { label: '框架进阶', points: ['TypeScript', 'Vue 3', 'React'] },
      { label: '工程化架构', points: ['Vite', 'Astro', '工程实践'] },
    ],
    modules: ['html5', 'css', 'javascript', 'git', 'typescript', 'vue3', 'react', 'vite', 'astro', 'engineering-practices'],
    ladder: ['初级 · 独立完成页面开发', '中级 · 框架与复杂模块', '高级 · 性能优化与架构'],
  },
  {
    id: 'backend',
    index: '02',
    title: '后端工程师',
    en: 'Backend Engineer',
    color: categoryColors.backend,
    status: '已开放',
    desc: '以一门后端语言为主线，贯通算法、数据库与计算机基础，再向高并发与系统架构演进。',
    stages: [
      { label: '语言与基础', points: ['Python', 'Go', 'C++', 'Shell'] },
      { label: '数据与算法', points: ['SQL', 'MySQL', 'Redis', '算法'] },
      { label: '架构与工程', points: ['计算机基础', '软件工程', '软件架构'] },
    ],
    modules: ['python', 'go', 'cpp', 'shell', 'sql', 'mysql', 'redis', 'algorithm', 'cs-fundamentals', 'software-engineering', 'software-architecture'],
    ladder: ['初级 · 接口与业务模块', '中级 · 性能与高并发', '高级 · 分布式架构'],
  },
  {
    id: 'fullstack',
    index: '03',
    title: '全栈工程师',
    en: 'Full-stack Engineer',
    color: categoryColors.cs,
    status: '已开放',
    desc: '贯通前端界面与后端服务，掌握数据库与部署交付，具备独立完成完整产品的能力。',
    stages: [
      { label: '前端基础', points: ['HTML5', 'CSS', 'JavaScript', 'TypeScript'] },
      { label: '后端与数据', points: ['Python', 'SQL', 'Redis'] },
      { label: '贯通与交付', points: ['Git', '运维', '工程实践'] },
    ],
    modules: ['html5', 'css', 'javascript', 'typescript', 'react', 'python', 'sql', 'redis', 'git', 'devops', 'engineering-practices'],
    ladder: ['初阶 · 前后端可独立开发', '进阶 · 数据库与部署贯通', '高阶 · 系统设计与架构'],
  },
  {
    id: 'devops',
    index: '04',
    title: 'DevOps / 平台工程师',
    en: 'DevOps / Platform Engineer',
    color: categoryColors.cloud,
    status: '已开放',
    desc: '以脚本、版本控制与网络为基础，向自动化、云计算与平台工程方向持续演进。',
    stages: [
      { label: '基础工具', points: ['Shell', 'Git', 'Networking'] },
      { label: '云与自动化', points: ['运维', '云计算', '网络安全'] },
      { label: '平台工程', points: ['工程实践', '软件测试', 'Monorepo'] },
    ],
    modules: ['shell', 'git', 'python', 'networking', 'devops', 'cloud-computing', 'cybersecurity', 'software-testing', 'engineering-practices', 'pnpm-monorepo'],
    ladder: ['运维 · 基础设施稳定', 'DevOps · 自动化流水线', '平台/SRE · 系统化工程'],
  },
  {
    id: 'data',
    index: '05',
    title: '数据工程师',
    en: 'Data Engineer',
    color: categoryColors.database,
    status: '规划中',
    desc: '从 SQL 与 Python 出发，掌握数据库与数据管道，逐步建立面向 AI 时代的数据素养。',
    stages: [
      { label: '语言与数据', points: ['Python', 'SQL'] },
      { label: '存储与管道', points: ['MySQL', 'Redis', '云计算'] },
      { label: 'AI 素养', points: ['概率统计', '线性代数', '算法'] },
    ],
    modules: ['python', 'sql', 'mysql', 'postgresql', 'redis', 'cloud-computing', 'algorithm', 'probability-statistics', 'linear-algebra'],
    ladder: ['入门 · 数据查询与清洗', '进阶 · 数据管道设计', '专家 · 数据平台架构'],
  },
] as const

---

<HomeLayout title="学习路线">
  <SEO
    slot="head"
    title="学习路线 · FANDEX"
    description="FANDEX 学习路线：以思维导图形式展示各技术的学习知识链，每个知识点都可跳转专项文档。"
    canonical={`${SITE.url}${base}learning-path/`}
    type="website"
  />

  <div class="home-page home-page--sub">
    <!-- 几何背景装饰：learning-path 变体（点状装饰已统一为竖条） -->
    <GeoBgDecor variant="learning-path" />

    <!-- Hero 区域：复用首页美术（渐变标题 + 统计 + SVG 描边入口） -->
    <section class="hero">
      <!-- Hero 标题：中文双字结构，与语法速览/在线编程页统一
           （英文长标题会使 data-text 残影伪元素换行错位产生重影，故统一中文） -->
      <h1 class="hero-title" data-text="学习路线">
        <span class="hero-title-fan">学习</span><span class="hero-title-dex">路线</span>
      </h1>

      <!-- 统计 + 功能入口同一行容器（与首页/语法速览结构一致） -->
      <div class="hero-stats-row">
        <div class="hero-stats">
          <div class="stat-item">
            <span class="stat-num">{techCards.length}</span>
            <span class="stat-label">门技术</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-num">{total.nodes}</span>
            <span class="stat-label">知识点</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-num">{total.docs}</span>
            <span class="stat-label">篇已发布</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-num">{total.gaps}</span>
            <span class="stat-label">篇待补充</span>
          </div>
        </div>

        <!-- 功能入口：首页同款纯文字按钮 + SVG 波浪描边动画 -->
        <nav class="hero-entries" aria-label="功能入口">
          <a href={base} class="entry-btn" data-tooltip="返回首页" data-tooltip-pos="bottom">
            <svg class="entry-border" viewBox="0 0 200 52" preserveAspectRatio="none" aria-hidden="true">
              <path d="M10,26 Q30,6 60,10 T110,26 T160,42 T190,26"/>
            </svg>
            <span class="entry-name">首页</span>
          </a>
          {!IS_DESKTOP_BUILD && (
            <a href={`${base}playground/`} class="entry-btn" data-tooltip="前端实验工作台" data-tooltip-pos="bottom">
              <svg class="entry-border" viewBox="0 0 200 52" preserveAspectRatio="none" aria-hidden="true">
                <path d="M10,26 Q30,6 60,10 T110,26 T160,42 T190,26"/>
              </svg>
              <span class="entry-name">在线编程</span>
            </a>
          )}
          <a href={`${base}syntax/`} class="entry-btn" data-tooltip="语法快速查阅" data-tooltip-pos="bottom">
            <svg class="entry-border" viewBox="0 0 200 52" preserveAspectRatio="none" aria-hidden="true">
              <path d="M10,26 Q30,6 60,10 T110,26 T160,42 T190,26"/>
            </svg>
            <span class="entry-name">语法速览</span>
          </a>
        </nav>
      </div>
    </section>

    <!-- 职业路线规划：按职业目标组织知识体系 -->
    <section class="lp-careers">
      <div class="lp-careers__head">
        <h2>职业路线规划</h2>
        <span class="lp-careers__note">按职业目标组合技术栈，知识体系随路线逐步展开</span>
      </div>
      <div class="lp-careers__grid">
        {careers.map((career) => (
          <article class="lp-career" style={`--career-color:${career.color}`}>
            <!-- 常驻曲线动画：底部波浪装饰线 -->
            <svg class="lp-career__curve" viewBox="0 0 400 12" preserveAspectRatio="none" aria-hidden="true">
              <path class="lp-career__curve-base" d="M2,8 C60,2 120,11 200,6 C280,1 340,10 398,5" />
              <path class="lp-career__curve-flow" d="M2,8 C60,2 120,11 200,6 C280,1 340,10 398,5" />
            </svg>
            <div class="lp-career__main">
              <header class="lp-career__head">
                <span class="lp-career__index" aria-hidden="true">{career.index}</span>
                <div class="lp-career__titles">
                  <h3 class="lp-career__title">{career.title}</h3>
                  <span class="lp-career__en">{career.en}</span>
                </div>
                <span class={`lp-career__status${career.status === '规划中' ? ' is-planned' : ''}`}>
                  {career.status}
                </span>
              </header>
              <p class="lp-career__desc">{career.desc}</p>
              <div class="lp-career__modules">
                {career.modules.map((moduleId) => {
                  const meta = getModule(moduleId)
                  if (!meta) return null
                  const href = pathModules.has(moduleId)
                    ? `${base}learning-path/${moduleId}/`
                    : `${base}${moduleId}/`
                  return (
                    <a class="lp-career__chip" href={href}>
                      {meta.title}
                    </a>
                  )
                })}
              </div>
            </div>
            <div class="lp-career__route">
              {career.stages.map((stage) => (
                <div class="lp-career__stage">
                  <span class="lp-career__stage-label">{stage.label}</span>
                  <span class="lp-career__stage-points">{stage.points.join(' · ')}</span>
                </div>
              ))}
            </div>
            <div class="lp-career__ladder">
              {career.ladder.map((step, stepIndex) => (
                <span class={`lp-career__step${stepIndex === 0 ? ' is-first' : ''}`}>
                  {step}
                </span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- 分类技术卡片 -->
    {grouped.map((group) => (
      <section class="lp-category" data-category={group.id}>
        <!-- 分类标题栏：复用首页 category-header 组件类，附加常驻曲线动画装饰 -->
        <h2 class="category-header lp-category__title" style={`--marker-color:${group.color}`}>
          <span class="category-marker" aria-hidden="true"></span>
          <span class="category-tag">{group.label}</span>
          <span class="category-count">{group.cards.length} 门</span>
          <svg class="lp-category__curve" viewBox="0 0 220 10" preserveAspectRatio="none" aria-hidden="true">
            <path class="lp-category__curve-base" d="M2,6 C40,2 80,9 120,5 C160,1 190,8 218,4" />
            <path class="lp-category__curve-flow" d="M2,6 C40,2 80,9 120,5 C160,1 190,8 218,4" />
          </svg>
        </h2>
        <div class="lp-tech-grid">
          {group.cards.map((card, cardIndex) => {
            const percent = card.vm.stats.nodes > 0
              ? Math.round((card.vm.stats.docs / card.vm.stats.nodes) * 100)
              : 0
            return (
              <a
                class="lp-tech-card"
                href={`${base}learning-path/${card.module}/`}
                style={`--card-color:${group.color};animation-delay:${cardIndex * 40}ms`}
              >
                <div class="lp-tech-card__head">
                  <span class="lp-tech-card__icon" aria-hidden="true">
                    {card.meta.icon}
                  </span>
                  <span class="lp-tech-card__title">{card.meta.title}</span>
                  <span class="lp-tech-card__arrow" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <line x1="5" y1="12" x2="19" y2="12" />
                      <polyline points="12 5 19 12 12 19" />
                    </svg>
                  </span>
                </div>
                <p class="lp-tech-card__desc">{card.vm.summary}</p>
                <div class="lp-tech-card__stats">
                  <span><strong>{card.vm.stats.nodes}</strong> 知识点</span>
                  <i aria-hidden="true"></i>
                  <span><strong>{card.vm.stats.docs}</strong> 已发布</span>
                  <i aria-hidden="true"></i>
                  <span class={card.vm.stats.gaps > 0 ? 'is-gap' : undefined}>
                    <strong>{card.vm.stats.gaps}</strong> 待补充
                  </span>
                </div>
                <svg
                  class="lp-tech-card__bar"
                  viewBox="0 0 100 4"
                  preserveAspectRatio="none"
                  aria-hidden="true"
                >
                  <rect class="bar-track" x="0" y="0" width="100" height="4" />
                  <rect class="bar-fill" x="0" y="0" width={percent} height="4" />
                </svg>
              </a>
            )
          })}
        </div>
      </section>
    ))}

    <Footer />
  </div>
</HomeLayout>
