---
/**
 * 学习路径总览页
 * -----------------------------------------------------------------------------
 * 展示已配置知识地图的技术卡片（按分类分组），每张卡片包含覆盖统计与进度条，
 * 点击进入单技术思维导图页。
 */
import HomeLayout from '@/components/HomeLayout.astro'
import SEO from '@/components/SEO.astro'
import GeoBgDecor from '@/components/GeoBgDecor.astro'
import FeatureNav from '@/components/FeatureNav.astro'
import Footer from '@/components/Footer.astro'
import { SITE } from '@/lib/constants'
import { t } from '@/lib/i18n'
import { categoryColors, getModule, getPrimaryCategory } from '@/lib/modules'
import { getCategories } from '@/services'
import {
  getLearningPathModules,
  getLearningPathTechVM,
} from '@/lib/learning-path'
// 复用首页 Hero / 统计 / 功能入口 / 分类组件样式，保证美术与语法速览页完全一致
import '@/styles/pages/index.css'
import '@/styles/pages/learning-path.css'

const base = import.meta.env.BASE_URL

// 技术卡片数据：模块元数据 + 视图模型（服务端组装）
const techCards = getLearningPathModules()
  .map((module) => {
    const meta = getModule(module)
    const vm = getLearningPathTechVM(module, base)
    if (!meta || !vm) return null
    return { module, meta, vm, category: getPrimaryCategory(meta) }
  })
  .filter((card): card is NonNullable<typeof card> => card !== null)

// 按主分类分组（沿用首页分类顺序与配色）
const grouped = getCategories()
  .map((cat) => ({
    ...cat,
    cards: techCards.filter((card) => card.category === cat.id),
  }))
  .filter((group) => group.cards.length > 0)

// 聚合统计
const total = techCards.reduce(
  (acc, card) => ({
    nodes: acc.nodes + card.vm.stats.nodes,
    docs: acc.docs + card.vm.stats.docs,
    gaps: acc.gaps + card.vm.stats.gaps,
  }),
  { nodes: 0, docs: 0, gaps: 0 },
)

/** 已配置思维导图的技术集合（用于知识体系芯片跳转） */
const pathModules = new Set(getLearningPathModules())

/**
 * 职业路线规划数据
 * 依据主流职业发展路径与知识体系结构整理，模块均引用站内真实内容；
 * 展示文案（标题/状态/描述/阶段/阶梯）收于 i18n 字典（lpCareer.*），
 * SSR 渲染中文，运行时经 data-i18n 属性随界面语言切换：
 * - 前端：基础（HTML/CSS/JS）→ 框架进阶（TS/Vue/React）→ 工程化与架构
 * - 后端：语言与基础 → 数据与算法 → 架构与工程
 * - 全栈：前端 + 后端 + 贯通交付
 * - DevOps：工具与网络 → 云与自动化 → 平台工程
 * - 数据：语言与数据 → 存储与管道 → AI 素养
 */
const careers = [
  {
    id: 'frontend',
    index: '01',
    titleKey: 'lpCareer.frontend.title',
    en: 'Frontend Engineer',
    color: categoryColors.frontend,
    status: 'open',
    descKey: 'lpCareer.frontend.desc',
    stages: [
      { labelKey: 'lpCareer.frontend.stage1', points: ['HTML5', 'CSS', 'JavaScript', 'Git'] },
      { labelKey: 'lpCareer.frontend.stage2', points: ['TypeScript', 'Vue 3', 'React'] },
      { labelKey: 'lpCareer.frontend.stage3', points: ['Vite', 'Astro', 'Monorepo'] },
    ],
    modules: ['html5', 'css', 'javascript', 'git', 'typescript', 'vue3', 'react', 'vite', 'astro'],
    ladderKeys: ['lpCareer.frontend.ladder1', 'lpCareer.frontend.ladder2', 'lpCareer.frontend.ladder3'],
  },
  {
    id: 'backend',
    index: '02',
    titleKey: 'lpCareer.backend.title',
    en: 'Backend Engineer',
    color: categoryColors.backend,
    status: 'open',
    descKey: 'lpCareer.backend.desc',
    stages: [
      { labelKey: 'lpCareer.backend.stage1', points: ['Python', 'Go', 'C++', 'Shell'] },
      { labelKey: 'lpCareer.backend.stage2', points: ['SQL', 'MySQL', 'Redis', '算法'] },
      { labelKey: 'lpCareer.backend.stage3', points: ['计算机基础', '软件工程与测试'] },
    ],
    modules: ['python', 'go', 'cpp', 'shell', 'sql', 'mysql', 'redis', 'algorithm', 'cs-fundamentals', 'software-testing'],
    ladderKeys: ['lpCareer.backend.ladder1', 'lpCareer.backend.ladder2', 'lpCareer.backend.ladder3'],
  },
  {
    id: 'fullstack',
    index: '03',
    titleKey: 'lpCareer.fullstack.title',
    en: 'Full-stack',
    color: categoryColors.cs,
    status: 'open',
    descKey: 'lpCareer.fullstack.desc',
    stages: [
      { labelKey: 'lpCareer.fullstack.stage1', points: ['HTML5', 'CSS', 'JavaScript', 'TypeScript'] },
      { labelKey: 'lpCareer.fullstack.stage2', points: ['Python', 'SQL', 'Redis'] },
      { labelKey: 'lpCareer.fullstack.stage3', points: ['Git', '运维', '工程实践'] },
    ],
    modules: ['html5', 'css', 'javascript', 'typescript', 'react', 'python', 'sql', 'redis', 'git', 'devops', 'software-testing'],
    ladderKeys: ['lpCareer.fullstack.ladder1', 'lpCareer.fullstack.ladder2', 'lpCareer.fullstack.ladder3'],
  },
  {
    id: 'devops',
    index: '04',
    titleKey: 'lpCareer.devops.title',
    en: 'DevOps',
    color: categoryColors.cloud,
    status: 'open',
    descKey: 'lpCareer.devops.desc',
    stages: [
      { labelKey: 'lpCareer.devops.stage1', points: ['Shell', 'Git', 'Networking'] },
      { labelKey: 'lpCareer.devops.stage2', points: ['运维', '云计算', '网络安全'] },
      { labelKey: 'lpCareer.devops.stage3', points: ['软件工程与测试', '消息中间件'] },
    ],
    modules: ['shell', 'git', 'python', 'networking', 'devops', 'cloud-computing', 'cybersecurity', 'software-testing'],
    ladderKeys: ['lpCareer.devops.ladder1', 'lpCareer.devops.ladder2', 'lpCareer.devops.ladder3'],
  },
  {
    id: 'data',
    index: '05',
    titleKey: 'lpCareer.data.title',
    en: 'Data Engineer',
    color: categoryColors.database,
    status: 'planned',
    descKey: 'lpCareer.data.desc',
    stages: [
      { labelKey: 'lpCareer.data.stage1', points: ['Python', 'SQL'] },
      { labelKey: 'lpCareer.data.stage2', points: ['MySQL', 'Redis', '云计算'] },
      { labelKey: 'lpCareer.data.stage3', points: ['概率统计', '线性代数', '算法'] },
    ],
    modules: ['python', 'sql', 'mysql', 'postgresql', 'redis', 'cloud-computing', 'algorithm', 'probability-statistics', 'linear-algebra'],
    ladderKeys: ['lpCareer.data.ladder1', 'lpCareer.data.ladder2', 'lpCareer.data.ladder3'],
  },
] as const

---

<HomeLayout title="学习路线">
  <SEO
    slot="head"
    title="学习路线 · FANDEX"
    description="FANDEX 学习路线：以思维导图形式展示各技术的学习知识链，每个知识点都可跳转专项文档。"
    canonical={`${SITE.url}${base}learning-path/`}
    type="website"
  />

  <div
    class="home-page home-page--sub"
    data-lp-hub
    data-lp-base={base}
    data-lp-colors={JSON.stringify(Object.fromEntries(techCards.map((card) => [card.module, categoryColors[card.category]])))}
  >
    <!-- 几何背景装饰：learning-path 变体（点状装饰已统一为竖条） -->
    <GeoBgDecor variant="learning-path" />

    <!-- Hero 区域：复用首页美术（渐变标题 + 统计 + SVG 描边入口） -->
    <section class="hero">
      <!-- Hero 标题：中文双字结构，与语法速览/在线前端页统一
           （英文长标题会使 data-text 残影伪元素换行错位产生重影，故统一中文） -->
      <h1 class="hero-title" data-text="学习路线">
        <span class="hero-title-fan">学习</span><span class="hero-title-dex">路线</span>
      </h1>

      <!-- 统计 + 功能入口同一行容器（与首页/语法速览结构一致） -->
      <div class="hero-stats-row">
        <div class="hero-stats">
          <div class="stat-item">
            <span class="stat-num">{techCards.length}</span>
            <span class="stat-label" data-i18n="lp.techs">门技术</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-num">{total.nodes}</span>
            <span class="stat-label" data-i18n="lp.nodes">知识点</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-num">{total.docs}</span>
            <span class="stat-label" data-i18n="lp.published">篇已发布</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-num">{total.gaps}</span>
            <span class="stat-label" data-i18n="lp.gaps">篇待补充</span>
          </div>
        </div>

        <!-- 功能入口：共享兄弟入口（FeatureNav 统一维护，避免各页子集缺漏） -->
        <FeatureNav />
      </div>

      <!-- 继续上次学习：直达上次浏览的技术地图（由 lib/lp-progress-ui.ts 点亮） -->
      <div class="lp-resume" data-lp-resume hidden>
        <span class="lp-resume__label" data-i18n="lp.resume">继续上次</span>
        <a class="lp-resume__link" data-lp-resume-link href="#">
          <span class="lp-resume__dot" aria-hidden="true"></span>
          <span data-lp-resume-name></span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </a>
      </div>
    </section>

    <!-- 职业路线规划：按职业目标组织知识体系
         （分区竖条采用五职业主题色纵向渐变，呼应下方各职业卡配色） -->
    <section
      class="lp-careers"
      style={`--career-ramp:linear-gradient(180deg, ${careers.map((career) => career.color).join(', ')})`}
    >
      <div class="lp-careers__head">
        <h2 data-i18n="lp.careersTitle">职业路线规划</h2>
        <span class="lp-careers__note" data-i18n="lp.careersNote">按职业目标组合技术栈，知识体系随路线逐步展开</span>
      </div>
      <div class="lp-careers__grid">
        {careers.map((career) => (
          <article class="lp-career" style={`--career-color:${career.color}`}>
            <!-- 常驻曲线动画：底部波浪装饰线 -->
            <svg class="lp-career__curve" viewBox="0 0 400 12" preserveAspectRatio="none" aria-hidden="true">
              <path class="lp-career__curve-base" d="M2,8 C60,2 120,11 200,6 C280,1 340,10 398,5" />
              <path class="lp-career__curve-flow" d="M2,8 C60,2 120,11 200,6 C280,1 340,10 398,5" />
            </svg>
            <div class="lp-career__main">
              <header class="lp-career__head">
                <span class="lp-career__index" aria-hidden="true">{career.index}</span>
                <div class="lp-career__titles">
                  <h3 class="lp-career__title" data-i18n={career.titleKey}>{t(career.titleKey)}</h3>
                  <span class="lp-career__en">{career.en}</span>
                </div>
                <span class={`lp-career__status${career.status === 'planned' ? ' is-planned' : ''}`} data-i18n={career.status === 'planned' ? 'lp.statusPlanned' : 'lp.statusOpen'}>
                  {career.status === 'planned' ? '规划中' : '已开放'}
                </span>
              </header>
              <p class="lp-career__desc" data-i18n={career.descKey}>{t(career.descKey)}</p>
              <div class="lp-career__modules">
                {career.modules.map((moduleId) => {
                  const meta = getModule(moduleId)
                  if (!meta) return null
                  const href = pathModules.has(moduleId)
                    ? `${base}learning-path/${moduleId}/`
                    : `${base}${moduleId}/`
                  return (
                    <a class="lp-career__chip" href={href}>
                      {meta.title}
                    </a>
                  )
                })}
              </div>
            </div>
            <div class="lp-career__route">
              {career.stages.map((stage) => (
                <div class="lp-career__stage">
                  <span class="lp-career__stage-label" data-i18n={stage.labelKey}>{t(stage.labelKey)}</span>
                  <span class="lp-career__stage-points">{stage.points.join(' · ')}</span>
                </div>
              ))}
            </div>
            <div class="lp-career__ladder">
              {career.ladderKeys.map((ladderKey, stepIndex) => (
                <span class={`lp-career__step${stepIndex === 0 ? ' is-first' : ''}`} data-i18n={ladderKey}>
                  {t(ladderKey)}
                </span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- 分类技术卡片 -->
    {grouped.map((group) => (
      <section class="lp-category" data-category={group.id}>
        <!-- 分类标题栏：复用首页 category-header 组件类，附加常驻曲线动画装饰 -->
        <h2 class="category-header lp-category__title" style={`--marker-color:${group.color}`}>
          <span class="category-marker" aria-hidden="true"></span>
          <span class="category-tag">{group.label}</span>
          <span class="category-count" data-i18n="lp.categoryCount" data-i18n-params={JSON.stringify({ n: group.cards.length })}>{group.cards.length} 门</span>
          <svg class="lp-category__curve" viewBox="0 0 220 10" preserveAspectRatio="none" aria-hidden="true">
            <path class="lp-category__curve-base" d="M2,6 C40,2 80,9 120,5 C160,1 190,8 218,4" />
            <path class="lp-category__curve-flow" d="M2,6 C40,2 80,9 120,5 C160,1 190,8 218,4" />
          </svg>
        </h2>
        <div class="lp-tech-grid">
          {group.cards.map((card, cardIndex) => {
            const percent = card.vm.stats.nodes > 0
              ? Math.round((card.vm.stats.docs / card.vm.stats.nodes) * 100)
              : 0
            return (
              <a
                class="lp-tech-card"
                href={`${base}learning-path/${card.module}/`}
                data-lp-module={card.module}
                data-lp-total={card.vm.stats.nodes}
                style={`--card-color:${group.color};animation-delay:${cardIndex * 40}ms`}
              >
                <div class="lp-tech-card__head">
                  <span class="lp-tech-card__icon" aria-hidden="true">
                    {card.meta.icon}
                  </span>
                  <span class="lp-tech-card__title">{card.meta.title}</span>
                  <span class="lp-tech-card__arrow" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <line x1="5" y1="12" x2="19" y2="12" />
                      <polyline points="12 5 19 12 12 19" />
                    </svg>
                  </span>
                </div>
                <p class="lp-tech-card__desc">{card.vm.summary}</p>
                <div class="lp-tech-card__stats">
                  <span><strong>{card.vm.stats.nodes}</strong> <span data-i18n="lp.cardNodes">知识点</span></span>
                  <i aria-hidden="true"></i>
                  <span><strong>{card.vm.stats.docs}</strong> <span data-i18n="lp.cardPublished">已发布</span></span>
                  <i aria-hidden="true"></i>
                  <span class={card.vm.stats.gaps > 0 ? 'is-gap' : undefined}>
                    <strong>{card.vm.stats.gaps}</strong> <span data-i18n="lp.cardGaps">待补充</span>
                  </span>
                </div>
                <svg
                  class="lp-tech-card__bar"
                  viewBox="0 0 100 4"
                  preserveAspectRatio="none"
                  aria-hidden="true"
                >
                  <rect class="bar-track" x="0" y="0" width="100" height="4" />
                  <rect class="bar-fill" x="0" y="0" width={percent} height="4" />
                </svg>
                <!-- 本机学习进度徽章：由 lib/lp-progress-ui.ts 读取进度表点亮 -->
                <span class="lp-tech-card__progress" data-lp-progress hidden></span>
              </a>
            )
          })}
        </div>
      </section>
    ))}

    <Footer />
  </div>
</HomeLayout>

<!-- 进度直显：「继续上次」芯片 + 技术卡片本机进度徽章 -->
<script>
  import '@/lib/lp-progress-ui';
</script>
