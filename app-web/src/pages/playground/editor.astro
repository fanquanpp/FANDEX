---
import BaseLayout from '@/components/BaseLayout.astro'

const base = import.meta.env.BASE_URL
const target = `${base}playground/`
---

<BaseLayout title="在线前端工作台">
  <meta slot="head" name="robots" content="noindex, follow" />
  <meta slot="head" http-equiv="refresh" content={`1; url=${target}`} />
  <script is:inline define:vars={{ target }}>
    location.replace(target + location.search + location.hash);
  </script>
  <noscript>
    <p style="padding: 2rem; text-align: center">
      在线前端工作台已迁移，<a href={target}>点此进入</a>。
    </p>
  </noscript>
</BaseLayout>
