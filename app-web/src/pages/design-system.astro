---
import HomeLayout from '@/components/HomeLayout.astro';
import SEO from '@/components/SEO.astro';
import { Code } from 'astro:components';
import DesignSystemDemo from '@/islands/DesignSystemDemo';
import { getDocStats, getAllModules } from '@/services';
import { transformerCodeBlockTitle } from '@/plugins/rehype-wrap-code-blocks';
import {
  transformerMetaHighlight,
  transformerNotationDiff,
  transformerNotationFocus,
} from '@shikijs/transformers';

const docStats = await getDocStats();
const allModules = getAllModules();
const stats = {
  totalModules: allModules.length,
  totalDocs: docStats.totalDocs,
};

// ---- 标本数据（规格 5.7.1：本页为第 1 期设计规格的活体标本 / 验收 8.7 目视基准）----

// 按钮：四层级语义钉死（规格 3.2.1），三尺寸 32/40/48 随 --button-size-* 令牌
const buttonLevels = [
  { id: 'primary', use: '主行动：每视图至多一枚（表单提交 / hero CTA）', text: '保存更改' },
  { id: 'secondary', use: '次行动：带边框的并列选项', text: '查看详情' },
  { id: 'ghost', use: '工具栏 / 导航内联操作', text: '筛选' },
  { id: 'danger', use: '仅破坏性操作', text: '删除数据' },
] as const;

// 圆角：使用档收敛 0 / 2 / 4 / 8 / full 五档（规格 3.1），md/xl/2xl/3xl 语义层停用
const radiusSteps = [
  { value: '0', name: '0', use: '直角面板 / 分区内块' },
  { value: 'var(--radius-control)', name: '--radius-control', use: '控件：按钮 / 输入框 / 徽标' },
  { value: 'var(--radius-card)', name: '--radius-card', use: '卡片 / 内容面板' },
  { value: 'var(--radius-modal)', name: '--radius-modal', use: '浮层：模态 / 弹出面板' },
  { value: 'var(--radius-full)', name: '--radius-full', use: '真圆：进度环 / 开关 / 头像（禁用于胶囊按钮）' },
];

// 字号阶梯：数值不变（规格 2.2），补成文纪律
const fontLadder = [
  { token: '--font-size-xs', px: '12px', sample: 'caption 辅助注记 Aa 0123' },
  { token: '--font-size-sm', px: '14px', sample: 'secondary 次要文字 Aa 0123' },
  { token: '--font-size-base', px: '16px', sample: 'body 中文正文基准 Aa 0123' },
  { token: '--font-size-lg', px: '18px', sample: 'body-lg 大正文 Aa 0123' },
  { token: '--font-size-xl', px: '20px', sample: 'heading-4 小标题 Aa 0123' },
  { token: '--font-size-2xl', px: '24px', sample: 'heading-3 中标题 Aa 0123' },
  { token: '--font-size-3xl', px: '30px', sample: 'heading-2 大标题 Aa 0123' },
  { token: '--font-size-4xl', px: '36px', sample: 'heading-1 主标题 Aa 0123' },
  { token: '--font-size-5xl', px: '48px', sample: 'display 展示 Aa 0123' },
  { token: '--font-size-6xl', px: '60px', sample: 'hero 英雄 Aa 0123' },
];

// 表格标本行：数字列验证 tabular-nums（滚动前后列宽稳定）
const tableRows = [
  { module: 'frontend / react', docs: '128', updated: '2026-10-24', status: '已审计' },
  { module: 'backend / database', docs: '96', updated: '2026-10-19', status: '已审计' },
  { module: 'cs / network', docs: '1,204', updated: '2026-10-28', status: '审计中' },
  { module: 'infra / cloud', docs: '57', updated: '2026-09-30', status: '已审计' },
];

const tocDemoItems = [
  { label: '排版体系', depth: 2 },
  { label: '代码块：SSR 化与行级增强', depth: 2, current: true },
  { label: 'transformers 与元信息', depth: 3 },
  { label: '表格与标题精修', depth: 2 },
];

// 代码标本（规格 2.6 / S3）：四例走真实 shiki 管线（Code 组件 + 与 astro.config
// shikiConfig 相同的 transformer 组合与 meta 语法），外层结构复刻
// rehype-wrap-code-blocks 的输出，样式直接消费 code.css 的 .code-block 实物类
const dsCodeTransformers = [
  transformerMetaHighlight(),
  transformerNotationDiff(),
  transformerNotationFocus(),
  transformerCodeBlockTitle(),
];

const codeSpecimens = [
  {
    label: 'title 头栏 · meta title="api-client.ts"',
    lang: 'ts',
    langLabel: 'TypeScript',
    title: 'api-client.ts',
    meta: 'title="api-client.ts"',
    code: [
      'export async function fetchDoc(id: string) {',
      '  const res = await get(`/doc/${id}`);',
      '  return res.json();',
      '}',
    ].join('\n'),
  },
  {
    label: '行高亮 + 行号开关 · meta {2,3} line-numbers',
    lang: 'ts',
    langLabel: 'TypeScript',
    title: '',
    meta: '{2,3} line-numbers',
    code: [
      'function reset(state) {',
      '  state.pending.clear();',
      '  state.frames = 0;',
      '  return true;',
      '}',
    ].join('\n'),
  },
  {
    label: 'diff · [!code --] / [!code ++]',
    lang: 'ts',
    langLabel: 'TypeScript',
    title: '',
    meta: '',
    code: [
      'const cache = new Map();',
      'cache.set(key, value); // [!code --]',
      'cache.set(key, lru(value)); // [!code ++]',
    ].join('\n'),
  },
  {
    label: 'focus · [!code focus]',
    lang: 'ts',
    langLabel: 'TypeScript',
    title: '',
    meta: '',
    code: ['init();', 'observe(el); // [!code focus]', 'teardown();'].join('\n'),
  },
] as const;
---

<HomeLayout title="Design System">
  <SEO
    slot="head"
    title="设计系统 · FANDEX"
    description="FANDEX 设计系统页：第 1 期「仪器面板」语言活体标本（按钮四层级三尺寸、圆角五档、反色墨水选中、刻度线语言、字号阶梯、代码块四例、表格三件、移动端目录），附 Tailwind v4 + shadcn/ui 组件试验场与 fx 动效体系演示。"
    canonical={new URL(Astro.url.pathname, Astro.site).href}
    type="website"
  />
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <div class="ds-page">
    <header class="ds-head">
      <p class="ds-head__marker" aria-hidden="true">fandex://design-system / spec-v1</p>
      <h1 class="ds-head__title">设计系统</h1>
      <p class="ds-head__sub">
        「仪器面板」语言活体标本：以下各节与站点实物同源（同一套令牌与基元类），是第
        1 期验收的目视基准。本页 noindex 且不入 sitemap（astro.config.ts sitemap filter）。
      </p>
    </header>

    {/* 1. 按钮四层级三尺寸 */}
    <section class="ds-section" aria-labelledby="ds-buttons-title">
      <h2 class="ds-section__title" id="ds-buttons-title">按钮：四层级 × 三尺寸</h2>
      <p class="ds-section__note">
        层级数量不再新增；尺寸 sm 32 / md 40 / lg 48 由 --button-size-* 令牌驱动（--size-control-sm/md/lg
        = 2rem / 2.5rem / 3rem）。键盘焦点统一 2px --color-border-focus 外描边（Tab 至任意按钮可见），
        按压态 scale(0.97)（components.css .fndx-button:active 实现值）。
      </p>
      <div class="ds-panel">
        {
          buttonLevels.map((lv) => (
            <div class="ds-btn-row">
              <code class="ds-btn-row__name">.fndx-button--{lv.id}</code>
              <span class="ds-btn-row__use">{lv.use}</span>
              <div class="ds-btn-row__demo">
                <button type="button" class:list={['fndx-button', `fndx-button--${lv.id}`, 'fndx-button--sm']}>
                  {lv.text}
                </button>
                <button type="button" class:list={['fndx-button', `fndx-button--${lv.id}`]}>{lv.text}</button>
                <button type="button" class:list={['fndx-button', `fndx-button--${lv.id}`, 'fndx-button--lg']}>
                  {lv.text}
                </button>
                <button type="button" class:list={['fndx-button', `fndx-button--${lv.id}`]} disabled>
                  禁用
                </button>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    {/* 2. 圆角五档 */}
    <section class="ds-section" aria-labelledby="ds-radius-title">
      <h2 class="ds-section__title" id="ds-radius-title">圆角五档</h2>
      <p class="ds-section__note">
        使用档收敛为 0 / 2 / 4 / 8 / full；md(6) / xl(12) / 2xl(16) / 3xl(24) 保留在 primitive
        但语义层停止引用。现状（规格 3.1 重映射已落 DTCG 批次，2026-11）：语义层映射新档
        （--radius-control = sm 2px、--radius-card = default 4px、--radius-modal = lg 8px、
        --radius-badge = sm 2px），标本引用语义令牌，与站点始终同值。
      </p>
      <div class="ds-panel ds-radius-grid">
        {
          radiusSteps.map((step) => (
            <figure class="ds-radius-item">
              <span
                class="ds-radius-swatch"
                style={`border-radius: ${step.value}; ${step.value === 'var(--radius-full)' ? 'height: auto; aspect-ratio: 1;' : ''}`}
                aria-hidden="true"
              />
              <figcaption>
                <code class="ds-radius-name">{step.name}</code>
                <span class="ds-radius-use">{step.use}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    {/* 3. 反色墨水选中 + 位置指示对照 */}
    <section class="ds-section" aria-labelledby="ds-ink-title">
      <h2 class="ds-section__title" id="ds-ink-title">选中态：反色墨水与位置指示</h2>
      <p class="ds-section__note">
        互斥单选（分段控件 / 菜单 / palette 选中项）用反色墨水：background var(--color-fg-primary)
        + color var(--color-bg-primary)。常驻位置指示（侧栏当前文档 / TOC 当前节）不用——继续用
        刻度线 + 字重。焦点由 2px cyan outline 管，与选中互不替代（规格 3.3）。
      </p>
      <div class="ds-panel ds-ink-grid">
        <div class="ds-ink-demo">
          <p class="ds-ink-demo__label">反色墨水：互斥单选（点击切换）</p>
          <fieldset class="ds-seg">
            <legend class="ds-visually-hidden">视图切换演示</legend>
            <label class="ds-seg__item">
              <input class="ds-visually-hidden" type="radio" name="ds-seg-demo" value="tutorial" />
              <span class="ds-seg__text">教程</span>
            </label>
            <label class="ds-seg__item">
              <input class="ds-visually-hidden" type="radio" name="ds-seg-demo" value="problems" checked />
              <span class="ds-seg__text">题库</span>
            </label>
            <label class="ds-seg__item">
              <input class="ds-visually-hidden" type="radio" name="ds-seg-demo" value="visual" />
              <span class="ds-seg__text">图鉴</span>
            </label>
          </fieldset>
        </div>
        <div class="ds-ink-demo">
          <p class="ds-ink-demo__label">位置指示：刻度线 + 字重（反色墨水不适用场景）</p>
          <ul class="ds-navlist">
            <li><span class="ds-navlist__link">排版体系</span></li>
            <li class="is-current"><span class="ds-navlist__link">代码块：SSR 化与行级增强</span></li>
            <li><span class="ds-navlist__link">表格与标题精修</span></li>
          </ul>
        </div>
      </div>
    </section>

    {/* 4. 刻度线语言 */}
    <section class="ds-section" aria-labelledby="ds-tick-title">
      <h2 class="ds-section__title" id="ds-tick-title">刻度线与角标</h2>
      <p class="ds-section__note">
        1-4px 条形（横线 / 竖线 / 顶线）承担标题、列表、当前项与 hover 语言；角标（左上 4px
        直角描线）仅限精选表面：首页精选卡与本页演示。
      </p>
      <div class="ds-panel ds-tick-grid">
        <div class="ds-tick-demo">
          <p class="ds-tick-demo__label">标题左条（3px）</p>
          <h3 class="ds-tick-heading">学习路径与模块地图</h3>
        </div>
        <div class="ds-tick-demo">
          <p class="ds-tick-demo__label">列表刻度（2px marker）</p>
          <ul class="ds-tick-list">
            <li>行内 2px 刻度替代圆点</li>
            <li>条目命中区垂直外扩 6px</li>
          </ul>
        </div>
        <div class="ds-tick-demo">
          <p class="ds-tick-demo__label">卡片：hover 顶线 scaleX（右卡为常驻精选态 + 角标）</p>
          <div class="ds-cards">
            <article class="ds-card">
              <h4>普通卡</h4>
              <p>悬停观察顶线自左展开，边框同步 tint。</p>
            </article>
            <article class="ds-card ds-card--featured">
              <h4>精选卡</h4>
              <p>顶线常驻 + 左上角 4px 直角描线。</p>
            </article>
          </div>
        </div>
      </div>
    </section>

    {/* 5. 字号阶梯 */}
    <section class="ds-section" aria-labelledby="ds-type-title">
      <h2 class="ds-section__title" id="ds-type-title">字号阶梯</h2>
      <p class="ds-section__note">
        数值阶梯 12-60px 保持（规格 2.2）。纪律：12px 是 CJK 可读下限，禁止新增 11px 档；一级灰
        仅限 caption / meta，不进长正文。
      </p>
      <div class="ds-panel ds-type-list">
        {
          fontLadder.map((row) => (
            <div class="ds-type-row">
              <span class="ds-type-row__meta">
                <code>{row.token}</code>
                <span>{row.px}</span>
              </span>
              <span class="ds-type-row__sample" style={`font-size: var(${row.token})`}>
                {row.sample}
              </span>
            </div>
          ))
        }
      </div>
    </section>

    {/* 6. 代码块四例（站点实物标本：真实 shiki + transformers 管线，结构同 rehype-wrap-code-blocks） */}
    <section class="ds-section" aria-labelledby="ds-code-title">
      <h2 class="ds-section__title" id="ds-code-title">代码块：头栏与行级表达</h2>
      <p class="ds-section__note">
        站点实物标本（.code-block 实类 + code.css，规格 2.6 已落地）：figure.code-block 框架与
        SSR copy 按钮由构建期 rehype-wrap-code-blocks 输出，关 JS 时框架 / 语言名 / 按钮仍在
        HTML 源码；头栏高 2.25rem、1px 底边、语言名右对齐 0.68em mono 大写（原 data-lang 角标
        退役）；行高亮 = accent 12% 背景 + 左缘 2px 刻度；diff 绿/红 tint；focus 非焦点行
        opacity 0.45；行号默认关，meta line-numbers 单块开启。以下四例直接走 shiki +
        transformers 真实管线，明暗随主题切换。
      </p>
      <div class="ds-panel ds-code-grid">
        {
          codeSpecimens.map((item) => (
            <div class="ds-tick-demo">
              <p class="ds-tick-demo__label">{item.label}</p>
              <figure class="code-block" data-lang={item.lang}>
                <div class="code-block__head">
                  {item.title ? <span class="code-block__title">{item.title}</span> : null}
                  <span class="code-block__lang">{item.langLabel}</span>
                  <button type="button" class="copy-btn fndx-icon-btn" aria-label="Copy code">
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <rect x="9" y="9" width="13" height="13" rx="2" />
                      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                    </svg>
                  </button>
                </div>
                <Code
                  code={item.code}
                  lang={item.lang}
                  themes={{ light: 'github-light', dark: 'github-dark' }}
                  defaultColor={false}
                  wrap
                  {...(item.meta ? { meta: item.meta } : {})}
                  transformers={dsCodeTransformers}
                />
              </figure>
            </div>
          ))
        }
      </div>
    </section>

    {/* 7. 表格三件 */}
    <section class="ds-section" aria-labelledby="ds-table-title">
      <h2 class="ds-section__title" id="ds-table-title">表格：降噪表头 / tabular-nums / hover 刻度环</h2>
      <p class="ds-section__note">
        表头 = accent 8% 混合底 + 2px accent 底线（明暗同式，站点实物同式落地于 typography.css）；
        数字列 tabular-nums；行 hover 为 inset 1px 刻度环叠加既有底色（规格 2.7）。
        注：站点实物斑马纹基于 --color-bg-card，此处标本为 --color-fg-primary 3% 近似。
      </p>
      <div class="ds-panel">
        <div class="ds-table-wrap">
          <table class="ds-table">
            <thead>
              <tr>
                <th scope="col">模块</th>
                <th scope="col" class="ds-table__num">文档数</th>
                <th scope="col">更新日期</th>
                <th scope="col">状态</th>
              </tr>
            </thead>
            <tbody>
              {
                tableRows.map((row) => (
                  <tr>
                    <td>{row.module}</td>
                    <td class="ds-table__num">{row.docs}</td>
                    <td>{row.updated}</td>
                    <td>{row.status}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {/* 8. 移动端目录演示 */}
    <section class="ds-section" aria-labelledby="ds-toctitle">
      <h2 class="ds-section__title" id="ds-toctitle">移动端目录（&lt;1024px 吸顶折叠条）</h2>
      <p class="ds-section__note">
        文档页在窄视口把右栏 TOC 重排为吸顶折叠条（规格 4.6，站点实物见 TableOfContents.astro）：
        吸顶条高 2.5rem（.app-main 同步 padding-top 占位）、summary 回显当前标题、展开面板 1px
        边框 + --radius-modal 底角 + max-height 85vh + overscroll-behavior contain。层级：吸顶条
        --z-toc（20，低于 header 40），面板不另设 z-index。下为可交互复刻（原生 details）：
      </p>
      <div class="ds-panel ds-toc-stage">
        <details class="ds-toc">
          <summary class="ds-toc__bar">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="ds-toc__chevron"
              aria-hidden="true"
            >
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
            <span class="ds-toc__label">本页目录</span>
            <span class="ds-toc__current">代码块：SSR 化与行级增强</span>
          </summary>
          <nav class="ds-toc__panel" aria-label="目录演示">
            <ul class="ds-toc__list">
              {
                tocDemoItems.map((item) => (
                  <li class:list={['ds-toc__item', { 'is-current': item.current }]} style={`padding-left: ${(item.depth - 2) * 0.875}rem`}>
                    <a class="ds-toc__link" href="#ds-toctitle">{item.label}</a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </details>
      </div>
    </section>
  </div>

  {/* shadcn/Tailwind 试验场：第三方组件基元原样演示，不代表站点基元。
      client:visible： specimens 区在首屏下方（HTML 中位于 hero/目录之后），
      拖后 hydration 可省 81KB gzip 的首屏 JS（motion + radix 全家桶 + react-dom），
      进入视口才挂载，滚动到即交互，SSR 骨架照常渲染不破版。 */}
  <DesignSystemDemo client:visible stats={stats} />

  <section class="fx-showcase" aria-labelledby="fx-showcase-title">
    <header class="fx-showcase__head">
      <h2 id="fx-showcase-title" class="text-2xl font-semibold text-text-primary border-l-4 border-primary-600 pl-3">
        fx 动效特效体系
      </h2>
      <p class="text-sm text-text-secondary">
        组件化注册表（src/fx）+ data-fx 声明式挂载：画布层受 full / lite / off
        三档能力门控，prefers-reduced-motion 与无 JS 环境始终完整呈现内容。
        唯一背景层承载全部背景装饰。设计约束：不使用光斑与
        色散类装饰，动效一律线与几何。
      </p>
    </header>

    <div class="fx-showcase__grid">
      <article class="fx-showcase__card">
        <h3>split 拆字入场</h3>
        <p class="fx-showcase__demo-text">
          <span data-fx-split="flip" data-fx-split-stagger="40">FLIP-IN</span>
          <span data-fx-split="rise" data-fx-split-stagger="40" data-fx-split-delay="320">RISE-UP</span>
        </p>
      </article>

      <article class="fx-showcase__card">
        <h3>decrypt 解密显形</h3>
