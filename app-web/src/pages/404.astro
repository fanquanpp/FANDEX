---
import '@/styles/site.css';
import '@/styles/pages/error.css';
import ThemeLangBootstrap from '@/components/ThemeLangBootstrap.astro';
import { SITE } from '@/lib/constants';
import { MINIMAL_CSP } from '@/lib/csp';

const base = import.meta.env.BASE_URL;
---

<html lang={SITE.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Security-Policy" content={MINIMAL_CSP} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>404 - 页面未找到 | {SITE.title}</title>

    <link rel="stylesheet" href={`${base}fonts/fonts.css`} />
    <link
      rel="preload"
      href={`${base}fonts/jetbrains-mono-400.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={`${base}fonts/jetbrains-mono-700.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <ThemeLangBootstrap />
  </head>
  <body>
    <div class="error-page">
      <!-- 错误页不挂 SceneBackdrop / fx 脚本链（规格 5.7.2 / 验收 8.7：网络面板零 fx 请求），
           背景为纯令牌底色，视觉重心交给角标框与刻度条 -->
      <main class="error-container">
        <div class="error-code-frame" aria-hidden="true">
          <div class="error-code">404</div>
        </div>
        <h1 class="error-title" data-i18n="error404.title">页面未找到</h1>
        <p class="error-desc" data-i18n="error404.desc">地址不存在或内容已被移动。</p>

        <div class="error-ticks" aria-hidden="true">
          <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
        </div>

        <div class="error-path" id="error-path-block" hidden>
          <span class="error-path-label" data-i18n="error404.invalid">失效链接</span>
          <code class="error-path-value" id="error-path-value"></code>
        </div>

        <nav class="error-actions" aria-label="错误页出口" data-i18n-aria="error404.exitsAria">
          <!-- 主出口：ghost 基元 + 规格 3.6 双层文字滑动（全视图仅此一枚；
               data-i18n 必须落在内层 label 上，i18n-dom 会整节点重写 textContent） -->
          <a href={base} class="fndx-button fndx-button--ghost error-cta">
            <i class="error-cta__tick" aria-hidden="true"></i>
            <span class="error-cta__label" data-i18n="error404.backHome">返回首页</span>
            <span class="error-cta__arrow" aria-hidden="true">→</span>
          </a>
          <a href={`${base}learning-path/`} class="fndx-button fndx-button--ghost" data-i18n="error404.learningPath">学习路线</a>
        </nav>
      </main>
    </div>

    <script>
      import '@/lib/i18n-dom';
    </script>

    <script is:inline>
      (function () {
        var block = document.getElementById('error-path-block');
        var value = document.getElementById('error-path-value');
        if (!block || !value) return;
        value.textContent = window.location.pathname;
        block.hidden = false;
      })();
    </script>
  </body>
</html>
