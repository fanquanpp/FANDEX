---
import '@/styles/site.css';
import '@/styles/pages/error.css';
import GeoBgDecor from '@/components/GeoBgDecor.astro';
import { SITE } from '@/lib/constants';
import { MINIMAL_CSP } from '@/lib/csp';

const base = import.meta.env.BASE_URL;
---

<html lang={SITE.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Security-Policy" content={MINIMAL_CSP} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>404 - 页面未找到 | {SITE.title}</title>

    <link rel="stylesheet" href={`${base}fonts/fonts.css`} />
    <link
      rel="preload"
      href={`${base}fonts/jetbrains-mono-400.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={`${base}fonts/jetbrains-mono-700.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      (function () {
        var raw = localStorage.getItem('fandex-theme');
        var theme;
        if (raw === 'dark' || raw === 'light') {
          theme = raw;
        } else {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.style.colorScheme = theme;
        try {
          var savedLang = localStorage.getItem('fandex-lang');
          if (savedLang === 'en') {
            document.documentElement.setAttribute('data-lang', 'en');
            document.documentElement.setAttribute('lang', 'en');
          } else {
            document.documentElement.setAttribute('data-lang', 'zh');
          }
        } catch (e) {
          /* localStorage 不可用时保持 SSR 中文 */
        }
      })();
    </script>
  </head>
  <body>
    <div class="error-page">
      <GeoBgDecor variant="error" />
      <main class="error-container">
        <div class="error-code-frame" aria-hidden="true">
          <div class="error-code">404</div>
        </div>
        <h1 class="error-title" data-i18n="error404.title">页面未找到</h1>
        <p class="error-desc" data-i18n="error404.desc">地址不存在或内容已被移动。</p>

        <div class="error-ticks" aria-hidden="true">
          <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
        </div>

        <div class="error-path" id="error-path-block" hidden>
          <span class="error-path-label" data-i18n="error404.invalid">失效链接</span>
          <code class="error-path-value" id="error-path-value"></code>
        </div>

        <nav class="error-actions" aria-label="错误页出口" data-i18n-aria="error404.exitsAria">
          <a href={base} class="error-btn error-btn--primary" data-i18n="error404.backHome">返回首页</a>
          <a href={`${base}learning-path/`} class="error-btn" data-i18n="error404.learningPath">学习路线</a>
        </nav>
      </main>
    </div>

    <script>
      import '@/lib/i18n-dom';
    </script>

    <script is:inline>
      (function () {
        var block = document.getElementById('error-path-block');
        var value = document.getElementById('error-path-value');
        if (!block || !value) return;
        value.textContent = window.location.pathname;
        block.hidden = false;
      })();
    </script>
  </body>
</html>
