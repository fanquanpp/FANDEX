---
/**
 * 在线前端工作台（/playground/）
 * -----------------------------------------------------------------------------
 * 功能直达（2026-09-19 入口扁平化）：
 *   - 「在线前端」入口不再经由介绍型落地页中转，点击即进入工作台本体，
 *     对齐 CodePen / StackBlitz 的 editor-first 模式：URL 即工作区
 *   - 灵感图鉴内嵌为工作台「灵感库」面板（?panel=gallery 打开即展开），
 *     能力说明由工具自身的空态与快捷键面板承载，不再单设介绍区块
 *   - 旧 /playground/editor/ 路径由查询保留重定向页接续，历史深链不失效
 *
 * 深链参数：
 *   - ?showcase=<id>  载入灵感图鉴指定成品
 *   - ?panel=gallery  打开时直接展开灵感画廊面板
 *   - ?pen=<id>       打开作品库中指定作品
 *
 * 美术对齐：
 *   - 使用 HomeLayout 全站横幅（FANDEX 标识 / GitHub / 主题切换），与主页同源
 *   - 几何背景装饰复用 playground 专属变体（网格 + 尖括号 + 终端方块）
 */
import HomeLayout from '@/components/HomeLayout.astro'
import SEO from '@/components/SEO.astro'
import GeoBgDecor from '@/components/GeoBgDecor.astro'
import FrontendLab from '@/islands/playground/FrontendLab'
import { SITE } from '@/lib/constants'
import { categoryColors } from '@/lib/modules'
import '@/styles/islands/playground.css'

const base = import.meta.env.BASE_URL
---

<HomeLayout title="在线前端">
  <SEO
    slot="head"
    title="在线前端工作台 · FANDEX"
    description="FANDEX 在线前端工作台：在浏览器中编写 HTML、CSS 与 JavaScript，实时预览效果，内置控制台、灵感图鉴与本地作品库，作品自动保存在本地，无需注册与上传。"
    canonical={`${SITE.url}${base}playground/`}
    type="website"
  />

  <!-- 页面主题色：前端技术分类色。面板标签等装饰竖条跟随主题色，
       不再使用站点品牌青；按钮 / 焦点环等功能性强调仍走全局令牌 -->
  <div class="pg-page" style={`--pg-color:${categoryColors.frontend}`}>
    <!-- 几何背景装饰：playground 专属变体（网格 + 尖括号 + 终端方块） -->
    <GeoBgDecor variant="playground" />
    <!-- 前端实验工作台（客户端岛组件）：进入即用，无中转介绍页 -->
    <FrontendLab client:load />
  </div>
</HomeLayout>
