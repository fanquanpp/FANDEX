---
import { Code } from 'astro:components';
import HomeLayout from '@/components/HomeLayout.astro'
import SEO from '@/components/SEO.astro'
import GeoBgDecor from '@/components/GeoBgDecor.astro'
import Footer from '@/components/Footer.astro'
import { SITE } from '@/lib/constants'
import { getDocsByModule, docSlug } from '@/services'
import {
  ALGO_PROBLEMS,
  ALGO_CATEGORIES,
  DIFFICULTY_LABELS,
  type AlgoProblem,
  type AlgoDifficulty,
} from '@/data/algo-problems'
import '@/styles/pages/algorithms.css'

const DIFF_COLOR: Record<AlgoDifficulty, string> = {
  easy: 'success',
  medium: 'warning',
  hard: 'danger',
}

interface RelatedDoc {
  slug: string;
  title: string;
}

export async function getStaticPaths() {
  const algoDocs = await getDocsByModule('algorithm')
  const docTitleBySlug = new Map(algoDocs.map((doc) => [docSlug(doc.id), doc.data.title]))

  return ALGO_PROBLEMS.map((problem, index) => ({
    params: { slug: problem.slug },
    props: {
      problem,
      index,
      prev: index > 0 ? (ALGO_PROBLEMS[index - 1] ?? null) : null,
      next: index < ALGO_PROBLEMS.length - 1 ? (ALGO_PROBLEMS[index + 1] ?? null) : null,
      related: (problem.related ?? []).map<RelatedDoc>((slug) => ({
        slug,
        title: docTitleBySlug.get(slug) ?? slug,
      })),
    },
  }))
}

interface Props {
  problem: AlgoProblem;
  index: number;
  prev: AlgoProblem | null;
  next: AlgoProblem | null;
  related: RelatedDoc[];
}

const { problem, index, prev, next, related } = Astro.props
const base = import.meta.env.BASE_URL
const category = ALGO_CATEGORIES.find((cat) => cat.id === problem.category)
const statementParas = problem.statement.split('\n\n').filter(Boolean)
---

<HomeLayout title={`${problem.title} · 算法题图鉴`}>
  <SEO
    slot="head"
    title={`${problem.title}（${problem.lc ? `LeetCode ${problem.lc}` : '经典题'}）· 算法题图鉴 - FANDEX`}
    description={problem.brief}
    canonical={`${SITE.url}${base}algorithms/problems/${problem.slug}/`}
    type="article"
  />

  <div class="home-page home-page--sub" style={`--ap-color:var(--color-${DIFF_COLOR[problem.difficulty]}-base)`}>
    <GeoBgDecor variant="minimal" />

    <article class="apd">
      <nav class="apd-crumb" aria-label="面包屑" data-i18n-aria="apd.crumbAria">
        <a href={`${base}algorithms/`} data-i18n="apd.algorithms">算法教学</a>
        <span class="apd-crumb__sep" aria-hidden="true">/</span>
        <a href={`${base}algorithms/?view=problems`} data-i18n="apd.atlas">算法题图鉴</a>
        <span class="apd-crumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">{problem.title}</span>
      </nav>

      <header class="apd-head">
        <p class="apd-head__meta">
          <span class="ap-card__no">{problem.lc ? `LC ${problem.lc}` : <span data-i18n="apd.classicBadge">经典题</span>}</span>
          <span class="ap-crumb__sep" aria-hidden="true">·</span>
          <span>{category?.label}</span>
          <span class="ap-crumb__sep" aria-hidden="true">·</span>
          <span class={`ap-badge ap-badge--${problem.difficulty}`}>{DIFFICULTY_LABELS[problem.difficulty]}</span>
          <span class="ap-crumb__sep" aria-hidden="true">·</span>
          <span data-i18n="apd.index" data-i18n-params={JSON.stringify({ p: index + 1, t: ALGO_PROBLEMS.length })}>第 {index + 1} / {ALGO_PROBLEMS.length} 题</span>
        </p>
        <h1 class="apd-head__title">
          {problem.title}
        </h1>
        <p class="apd-head__en">{problem.titleEn}</p>
        <div class="apd-head__tags">
          {problem.tags.map((tag) => (
            <span class="ap-card__tag">{tag}</span>
          ))}
        </div>
        <div class="apd-progress" data-apd-progress data-apd-slug={problem.slug}>
          <span class="apd-progress__label" data-i18n="apd.localProgress">本机进度</span>
          <button type="button" class="ap-mark ap-mark--lg" data-ap-detail-mark="solved" aria-pressed="false" title="标记为已掌握" data-i18n-title="ap.markSolved">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M4 12.5l5 5L20 6.5" />
            </svg>
            <span data-i18n="ap.solved">已掌握</span>
          </button>
          <button type="button" class="ap-mark ap-mark--lg" data-ap-detail-mark="review" aria-pressed="false" title="标记为待复习" data-i18n-title="ap.markReview">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 3l2.7 5.6 6.3.9-4.5 4.4 1 6.1-5.5-2.9-5.5 2.9 1-6.1L3 9.5l6.3-.9L12 3z" />
            </svg>
            <span data-i18n="ap.review">待复习</span>
          </button>
          <span class="apd-progress__note" data-i18n="apd.progressNote">仅保存在当前浏览器</span>
        </div>
      </header>

      <section class="apd-sec">
        <h2 class="apd-sec__title" data-i18n="apd.desc">题目描述</h2>
        <div class="apd-statement">
          {statementParas.map((para) => (
            <p>{para}</p>
          ))}
        </div>
      </section>

      <section class="apd-sec">
        <h2 class="apd-sec__title" data-i18n="apd.idea">解题思路</h2>
        <ol class="apd-idea">
          {problem.idea.map((point) => (
            <li>{point}</li>
          ))}
        </ol>
      </section>

      <section class="apd-sec">
        <h2 class="apd-sec__title" data-i18n="apd.impl">参考实现</h2>
        <details class="apd-code">
          <summary>
            <span data-i18n="apd.implToggle">查看参考实现</span><em data-i18n="apd.implHint">Python · 建议先自行作答</em>
          </summary>
          <div class="apd-code__body">
            <Code
              code={problem.code}
              lang="python"
              themes={{ light: 'github-light', dark: 'github-dark' }}
              defaultColor={false}
              wrap
            />
          </div>
        </details>
      </section>

      <section class="apd-sec">
        <h2 class="apd-sec__title" data-i18n="apd.meta">复杂度与归属</h2>
        <div class="apd-meta">
          <div class="apd-meta__item">
            <span class="apd-meta__label" data-i18n="apd.time">时间复杂度</span>
            <span class="apd-meta__value">{problem.time}</span>
          </div>
          <div class="apd-meta__item">
            <span class="apd-meta__label" data-i18n="apd.space">空间复杂度</span>
            <span class="apd-meta__value">{problem.space}</span>
          </div>
          <div class="apd-meta__item">
            <span class="apd-meta__label" data-i18n="apd.category">所属分类</span>
            <span class="apd-meta__value">{category?.label}</span>
          </div>
          <div class="apd-meta__item">
            <span class="apd-meta__label" data-i18n="apd.source">题源</span>
            <span class="apd-meta__value">{problem.lc ? `LeetCode ${problem.lc}` : <span data-i18n="apd.sourceClassic">经典算法题</span>}</span>
          </div>
        </div>
      </section>

      {related.length > 0 && (
        <section class="apd-sec">
          <h2 class="apd-sec__title" data-i18n="apd.related">关联教程</h2>
          <div class="apd-rel">
            {related.map((doc) => (
              <a href={`${base}algorithm/${doc.slug}/`}>{doc.title}</a>
            ))}
          </div>
        </section>
      )}

      <nav class="apd-nav" aria-label="前后题目" data-i18n-aria="apd.navAria">
        {prev ? (
          <a class="apd-nav__link" href={`${base}algorithms/problems/${prev.slug}/`}>
            <span class="apd-nav__dir" data-i18n="apd.prev">PREV · 上一题</span>
            <span class="apd-nav__title">{prev.title}</span>
          </a>
        ) : (
          <span class="apd-nav__link is-placeholder" aria-hidden="true"></span>
        )}
        {next ? (
          <a class="apd-nav__link is-next" href={`${base}algorithms/problems/${next.slug}/`}>
            <span class="apd-nav__dir" data-i18n="apd.next">NEXT · 下一题</span>
            <span class="apd-nav__title">{next.title}</span>
          </a>
        ) : (
          <span class="apd-nav__link is-placeholder" aria-hidden="true"></span>
        )}
      </nav>

      <p class="apd-back">
        <a class="ap-chip" data-apd-back href={`${base}algorithms/?view=problems`} data-i18n="apd.back">返回题图鉴</a>
      </p>
    </article>

    <Footer />
  </div>
</HomeLayout>

<script>
  import '@/lib/algo-problems';
</script>
