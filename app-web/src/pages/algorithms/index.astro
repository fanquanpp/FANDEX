---
/**
 * 算法教学页（教程课程表 + 题图鉴双视图 + 外部平台推荐）
 * -----------------------------------------------------------------------------
 * 入口扁平化（2026-09-19）：
 *   - 原独立子页「算法题图鉴」并入本页，成为页内可直切的第二视图：
 *     点击 hero「题图鉴」或视图切换器一步直达刷题功能，不再中转介绍页
 *   - 视图状态同步 URL（?view=problems），深链 / 刷新 / 分享均可还原
 *   - 题目详情页仍位于 /algorithms/problems/<slug>/（内容页，非介绍页）
 *   - 新增「外部刷题平台推荐」：力扣 / PracHub / NeetCode 等第三方资源，
 *     附免责声明（详见 disclaimer 页），仓库维护者不对第三方内容负责
 *
 * 教程组织：algorithm 模块全部教程按学习曲线重组为单元章节课程表，
 * 形成"学教程 -> 站内刷题 -> 外部平台进阶"的完整闭环。
 */
import HomeLayout from '@/components/HomeLayout.astro'
import SEO from '@/components/SEO.astro'
import GeoBgDecor from '@/components/GeoBgDecor.astro'
import FeatureNav from '@/components/FeatureNav.astro'
import Footer from '@/components/Footer.astro'
import { SITE } from '@/lib/constants'
import { categoryColors } from '@/lib/modules'
import { getDocsByModule, docSlug } from '@/services'
import {
  ALGO_PROBLEMS,
  ALGO_CATEGORIES,
  DIFFICULTY_LABELS,
  DIFFICULTY_ORDER,
  countByCategory,
  countByDifficulty,
  type AlgoDifficulty,
} from '@/data/algo-problems'
// 复用首页 Hero / 统计 / 功能入口样式，保证美术与学习路线页完全一致
import '@/styles/pages/index.css'
import '@/styles/pages/algorithms.css'

const base = import.meta.env.BASE_URL

/** 教学文档难度标签映射（frontmatter.difficulty -> 中文短标签） */
const LEVEL_LABELS: Record<string, string> = {
  beginner: '入门',
  intermediate: '进阶',
  advanced: '深入',
}

/**
 * 单元章节定义：slug 分组即学习曲线
 * （顺序参考「数据结构 -> 排序查找 -> 设计范式 -> 图论 -> 字符串 -> 高级结构 -> 实战」）
 */
const UNITS = [
  {
    id: 'foundation',
    index: '01',
    title: '基础与分析',
    en: 'Foundations',
    desc: '复杂度思维起步，吃透数组、栈队列、链表与哈希等线性结构的实现细节。',
    color: categoryColors.cs,
    slugs: [
      '010-AlgorithmAnalysisBasics',
      '020-ArrayAndDynamicArray',
      '040-StackAndQueue',
      '050-SearchAlgorithm',
      '060-LinkedList',
      '070-HashTable',
    ],
  },
  {
    id: 'tree',
    index: '02',
    title: '树形结构',
    en: 'Trees',
    desc: '从二叉树到堆与平衡树，掌握递归结构与层次关系的通用处理模式。',
    color: categoryColors.backend,
    slugs: ['080-Tree', '090-HeapAndPriorityQueue', '100-BalancedTreeAdvanced'],
  },
  {
    id: 'sort-search',
    index: '03',
    title: '排序与查找',
    en: 'Sorting & Searching',
    desc: '经典排序范式对比，二分查找及其在分段有序场景的变形。',
    color: categoryColors.frontend,
    slugs: ['030-SortAlgorithm', '170-BinarySearchAlgorithms'],
  },
  {
    id: 'design',
    index: '04',
    title: '算法设计范式',
    en: 'Design Paradigms',
    desc: '分治、贪心、回溯与动态规划四大设计思想，从暴力到最优的系统演进。',
    color: categoryColors.database,
    slugs: [
      '120-DivideAndConquer',
      '130-GreedyAlgorithm',
      '140-RecursionAndBacktracking',
      '160-DynamicProgramming',
      '240-BitmaskDynamicProgramming',
    ],
  },
  {
    id: 'graph',
    index: '05',
    title: '图论',
    en: 'Graph Theory',
    desc: '遍历与连通性、拓扑排序、最短路、最小生成树，一路走到网络流。',
    color: categoryColors.cloud,
    slugs: [
      '110-GraphAlgorithms',
      '180-UnionFind',
      '250-FloydWarshall',
      '260-KruskalAlgorithm',
      '270-TopologicalSorting',
      '290-NetworkFlow',
    ],
  },
  {
    id: 'string',
    index: '06',
    title: '字符串算法',
    en: 'Strings',
    desc: '字符串处理专题与 KMP 高效匹配。',
    color: categoryColors.math,
    slugs: ['150-StringAlgorithms', '230-KmpStringMatching'],
  },
  {
    id: 'advanced',
    index: '07',
    title: '高级数据结构',
    en: 'Advanced Structures',
    desc: '线段树、树状数组、跳表与布隆过滤器等进阶武器库。',
    color: categoryColors.tools,
    slugs: ['190-SegmentTree', '200-FenwickTree', '210-SkipList', '220-BloomFilter'],
  },
  {
    id: 'practice',
    index: '08',
    title: '理论与实战',
    en: 'Theory & Practice',
    desc: '以计算理论收束知识体系，再用面试题单检验学习成果。',
    color: categoryColors.cs,
    slugs: ['280-AlgorithmTheory', '300-LeetCodeInterviewGuide'],
  },
]

// 拉取 algorithm 模块全部文档并建立 slug 索引（构建期一次查询）
const algoDocs = await getDocsByModule('algorithm')
const docBySlug = new Map(algoDocs.map((doc) => [docSlug(doc.id), doc]))

/** 组装单元视图模型：slug 映射到真实文档元数据，失效 slug 自动剔除 */
const units = UNITS.map((unit) => ({
  ...unit,
  docs: unit.slugs
    .map((slug) => {
      const doc = docBySlug.get(slug)
      if (!doc) return null
      return {
        slug,
        title: doc.data.title,
        description: doc.data.description,
        difficulty: String(doc.data.difficulty),
        order: doc.data.order,
      }
    })
    .filter((doc): doc is NonNullable<typeof doc> => doc !== null),
})).filter((unit) => unit.docs.length > 0)

// 兜底：未归入任何单元的文档并入「更多专题」，防止内容扩充后遗漏
const mappedSlugs = new Set<string>(UNITS.flatMap((unit) => [...unit.slugs]))
const restDocs = algoDocs.filter((doc) => !mappedSlugs.has(docSlug(doc.id)))
if (restDocs.length > 0) {
  units.push({
    id: 'more',
    index: '09',
    title: '更多专题',
    en: 'More',
    desc: '尚未归入上述单元的算法专题文档。',
    color: categoryColors.cs,
    docs: restDocs.map((doc) => ({
      slug: docSlug(doc.id),
      title: doc.data.title,
      description: doc.data.description,
      difficulty: String(doc.data.difficulty),
      order: doc.data.order,
    })),
  } as (typeof units)[number])
}

// 聚合统计：教程篇数 / 单元数 / 题库题量
const docTotal = algoDocs.length
const problemTotal = ALGO_PROBLEMS.length
const categoryTotal = ALGO_CATEGORIES.length

// 题图鉴视图：统计与枚举数据（构建期计算）
const catCounts = countByCategory()
const diffCounts = countByDifficulty()

/** 难度 -> 语义色 token 名（卡片主题色与徽章配色） */
const DIFF_COLOR: Record<AlgoDifficulty, string> = {
  easy: 'success',
  medium: 'warning',
  hard: 'danger',
}

/**
 * 外部刷题平台推荐（第三方资源，中性描述）
 * -----------------------------------------------------------------------------
 * 收录原则：题库规模 / 模式化路线 / 面试真实度 / 竞赛训练各有侧重，互补不重复；
 * 全部为外部独立平台，其内容与服务由各自运营方提供，免责声明见 disclaimer 页。
 */
const EXTERNAL_PLATFORMS = [
  {
    name: '力扣 LeetCode',
    host: 'leetcode.cn',
    href: 'https://leetcode.cn/',
    tag: '综合题库',
    color: categoryColors.frontend,
    desc: '全球规模领先的算法题库，按标签 / 难度 / 企业筛选，在线判题与题解社区完善，站内题图鉴中标注 LC 序号的题目均可在其上提交验证。',
  },
  {
    name: 'PracHub',
    host: 'prachub.com',
    href: 'https://prachub.com/questions',
    tag: '面试准备',
    color: categoryColors.cs,
    desc: '可按公司、岗位、轮次、主题和难度筛选的候选人报告编程面试题，适合在掌握基础模式后按目标公司定向备战。',
  },
  {
    name: 'NeetCode',
    host: 'neetcode.io',
    href: 'https://neetcode.io/',
    tag: '模式路线',
    color: categoryColors.backend,
    desc: '以题型模式（pattern）组织的免费刷题路线与视频讲解，Blind 75 / NeetCode 150 题单是与本站教程搭配的经典进阶路径。',
  },
  {
    name: '洛谷',
    host: 'luogu.com.cn',
    href: 'https://www.luogu.com.cn/',
    tag: '竞赛训练',
    color: categoryColors.math,
    desc: '中文算法竞赛社区，官方题单与训练营覆盖入门到 NOIP / ICPC 水平，适合在课程表之后追求更强的实现能力。',
  },
  {
    name: 'Codeforces',
    host: 'codeforces.com',
    href: 'https://codeforces.com/',
    tag: '竞技比赛',
    color: categoryColors.cloud,
    desc: '全球竞技编程赛事与题库，评级赛制驱动持续练习，锻炼限时高压下的建模与编码能力。',
  },
  {
    name: '牛客网',
    host: 'nowcoder.com',
    href: 'https://www.nowcoder.com/',
    tag: '面试准备',
    color: categoryColors.database,
    desc: '国内笔试面试题库与模拟面试，覆盖校招高频考点与企业真题，求职季的实战演练场。',
  },
] as const
---

<HomeLayout title="算法教学">
  <SEO
    slot="head"
    title="算法教学 · FANDEX"
    description="FANDEX 算法教学：按单元章节组织的算法与数据结构完整教程，页内直切算法题图鉴刷题，并收录力扣、PracHub、NeetCode 等外部刷题平台推荐。"
    canonical={`${SITE.url}${base}algorithms/`}
    type="website"
  />

  <div class="home-page home-page--sub" data-algo-page>
    <!-- 几何背景装饰：复用学习路线变体（竖条刻度语言） -->
    <GeoBgDecor variant="learning-path" />

    <!-- Hero 区域：复用首页美术（渐变标题 + 统计 + SVG 描边入口） -->
    <section class="hero">
      <h1 class="hero-title" data-text="算法教学">
        <span class="hero-title-fan">算法</span><span class="hero-title-dex">教学</span>
      </h1>

      <div class="hero-stats-row">
        <div class="hero-stats">
          <div class="stat-item">
            <span class="stat-num">{units.length}</span>
            <span class="stat-label">大单元</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-num">{docTotal}</span>
            <span class="stat-label">篇教程</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-num">{problemTotal}</span>
            <span class="stat-label">道配套习题</span>
          </div>
        </div>

        <!-- 功能入口：题图鉴直达链接（点击即切页内视图，不再中转独立页） -->
        <FeatureNav
          extra={[{ href: `?view=problems`, label: '题图鉴', tooltip: '直达刷题视图：经典算法题与讲解' }]}
        />
      </div>
    </section>

    <!-- 视图切换器：教程 / 刷题两大功能一步直达（sticky 常驻可达） -->
    <div class="algo-views" data-algo-views role="group" aria-label="教程与题图鉴视图切换">
      <button type="button" class="algo-views__tab is-active" data-view-tab="tutorials" aria-pressed="true">
        教程课程表
        <em>{docTotal} 篇</em>
      </button>
      <button type="button" class="algo-views__tab" data-view-tab="problems" aria-pressed="false">
        算法题图鉴
        <em>{problemTotal} 道题</em>
      </button>
    </div>

    <!-- 视图一：单元章节课程表（默认视图） -->
    <div class="algo-units" data-algo-view="tutorials">
      {units.map((unit) => (
        <section class="algo-section" id={unit.id} data-unit={unit.id}>
          <header class="algo-section__head">
            <h2 class="algo-section__title">
              <span class="algo-section__index" aria-hidden="true">{unit.index}</span>
              {unit.title}
            </h2>
            <span class="algo-section__en">{unit.en} · {unit.desc}</span>
            <span class="algo-section__count">{unit.docs.length} 篇</span>
          </header>
          <div class="algo-unit__grid">
            {unit.docs.map((doc, docIndex) => (
              <a
                class="algo-doc-card"
                href={`${base}algorithm/${doc.slug}/`}
                style={`--card-color:${unit.color};animation-delay:${docIndex * 40}ms`}
              >
                <div class="algo-doc-card__head">
                  <span class="algo-doc-card__no" aria-hidden="true">{String(doc.order).padStart(3, '0')}</span>
                  <h3 class="algo-doc-card__title">{doc.title}</h3>
                  <span class="algo-doc-card__level">{LEVEL_LABELS[doc.difficulty] ?? doc.difficulty}</span>
                </div>
                <p class="algo-doc-card__desc">{doc.description}</p>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>

    <!-- 视图二：题图鉴（原独立子页并入；筛选交互由 lib/algo-problems.ts 驱动） -->
    <section data-algo-view="problems" data-algo-problems hidden>
      <div class="ap-filter">
        <div class="ap-filter__row">
          <span class="ap-filter__label" aria-hidden="true"></span>
          <span class="ap-filter__hint">分类</span>
          <button class="ap-chip is-active" type="button" data-filter-cat="all" aria-pressed="true">
            全部<em>{problemTotal}</em>
          </button>
          {ALGO_CATEGORIES.map((cat) => (
            <button
              class="ap-chip"
              type="button"
              data-filter-cat={cat.id}
              title={cat.desc}
              aria-pressed="false"
            >
              {cat.label}<em>{catCounts[cat.id]}</em>
            </button>
          ))}
        </div>
        <div class="ap-filter__row">
          <span class="ap-filter__label" aria-hidden="true"></span>
          <span class="ap-filter__hint">难度</span>
          <button class="ap-chip is-active" type="button" data-filter-diff="all" aria-pressed="true">
            全部
          </button>
          {DIFFICULTY_ORDER.map((diff) => (
            <button
              class="ap-chip"
              type="button"
              data-filter-diff={diff}
              aria-pressed="false"
            >
              {DIFFICULTY_LABELS[diff]}<em>{diffCounts[diff]}</em>
            </button>
          ))}
        </div>
        <div class="ap-filter__row">
          <span class="ap-filter__label" aria-hidden="true"></span>
          <span class="ap-filter__hint">进度</span>
          <button class="ap-chip is-active" type="button" data-filter-status="all" aria-pressed="true">
            全部
          </button>
          <button class="ap-chip" type="button" data-filter-status="solved" aria-pressed="false" title="只看已标记掌握的题目">
            已掌握<em data-ap-status-count="solved">0</em>
          </button>
          <button class="ap-chip" type="button" data-filter-status="review" aria-pressed="false" title="只看标记待复习的题目">
            待复习<em data-ap-status-count="review">0</em>
          </button>
          <input
            class="ap-search"
            type="search"
            data-filter-search
            placeholder="搜索题名 / 标签"
            aria-label="按题名或标签搜索题目"
          />
        </div>
      </div>

      <!-- 命中计数行：附本机进度说明（进度仅存当前浏览器） -->
      <div class="ap-count-row">
        <p class="ap-count" data-filter-count aria-live="polite"></p>
        <span class="ap-count-note">掌握 / 复习标记仅保存在当前浏览器</span>
      </div>

      <div class="ap-grid">
        {ALGO_PROBLEMS.map((problem, i) => (
          <article
            class="ap-card"
            data-algo-item
            data-cat={problem.category}
            data-diff={problem.difficulty}
            data-slug={problem.slug}
            data-search={`${problem.lc ?? ''} ${problem.title} ${problem.titleEn} ${problem.tags.join(' ')} ${problem.brief}`.toLowerCase()}
            style={`--ap-color:var(--color-${DIFF_COLOR[problem.difficulty]}-base);animation-delay:${Math.min(i, 24) * 30}ms`}
          >
            <a
              class="ap-card__link"
              href={`${base}algorithms/problems/${problem.slug}/`}
              aria-label={`${problem.title}（${DIFFICULTY_LABELS[problem.difficulty]}）`}
            >
              <div class="ap-card__head">
                <span class="ap-card__no" aria-hidden="true">{problem.lc ? `LC ${problem.lc}` : '经典'}</span>
                <h3 class="ap-card__title">{problem.title}</h3>
                <span class={`ap-badge ap-badge--${problem.difficulty}`}>{DIFFICULTY_LABELS[problem.difficulty]}</span>
              </div>
              <p class="ap-card__en">{problem.titleEn}</p>
              <p class="ap-card__brief">{problem.brief}</p>
              <div class="ap-card__tags">
                {problem.tags.map((tag) => (
                  <span class="ap-card__tag">{tag}</span>
                ))}
              </div>
            </a>
            <!-- 本机进度标记：已掌握 / 待复习（z-index 高于拉伸链接） -->
            <div class="ap-card__marks">
              <button
                type="button"
                class="ap-mark"
                data-mark="solved"
                aria-pressed="false"
                title="标记为已掌握"
              >
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M4 12.5l5 5L20 6.5" />
                </svg>
              </button>
              <button
                type="button"
                class="ap-mark"
                data-mark="review"
                aria-pressed="false"
                title="标记为待复习"
              >
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M12 3l2.7 5.6 6.3.9-4.5 4.4 1 6.1-5.5-2.9-5.5 2.9 1-6.1L3 9.5l6.3-.9L12 3z" />
                </svg>
              </button>
            </div>
          </article>
        ))}
      </div>

      <!-- 空状态：筛选无命中时显示，附恢复动作 -->
      <div class="ap-empty" data-ap-empty hidden>
        <p>没有匹配的题目</p>
        <div class="ap-empty__actions">
          <button type="button" class="ap-chip" data-ap-clear-q>清除关键词</button>
          <button type="button" class="ap-chip" data-ap-reset>重置全部筛选</button>
        </div>
      </div>
    </section>

    <!-- 外部刷题平台推荐：站内闭环之后的进阶出口（第三方资源 + 免责声明） -->
    <section class="algo-ext" aria-label="外部刷题平台推荐" data-algo-ext>
      <header class="algo-ext__head">
        <h2 class="algo-section__title">外部刷题平台推荐</h2>
        <span class="algo-ext__note">第三方资源 · 供学完站内教程后按需进阶</span>
      </header>
      <div class="algo-ext__grid">
        {EXTERNAL_PLATFORMS.map((platform) => (
          <a
            class="algo-ext__card"
            href={platform.href}
            target="_blank"
            rel="noopener noreferrer"
            style={`--card-color:${platform.color}`}
          >
            <div class="algo-ext__card-head">
              <h3 class="algo-ext__name">{platform.name}</h3>
              <span class="algo-ext__tag">{platform.tag}</span>
              <svg class="algo-ext__arrow" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <line x1="7" y1="17" x2="17" y2="7" />
                <polyline points="8 7 17 7 17 16" />
              </svg>
            </div>
            <p class="algo-ext__desc">{platform.desc}</p>
            <span class="algo-ext__host">{platform.host}</span>
          </a>
        ))}
      </div>
      <p class="algo-ext__disclaimer">
        以上为外部第三方平台，其内容、账号与服务均由各自运营方提供；收录仅为学习资源参考，
        不构成合作或背书，本站不对使用外部资源产生的各类问题承担责任。详见
        <a href={`${base}disclaimer/`}>免责声明</a>。
      </p>
    </section>

    <Footer />
  </div>
</HomeLayout>

<style>
