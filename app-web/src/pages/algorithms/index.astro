---
import HomeLayout from '@/components/HomeLayout.astro'
import SEO from '@/components/SEO.astro'
import GeoBgDecor from '@/components/GeoBgDecor.astro'
import FeatureNav from '@/components/FeatureNav.astro'
import Footer from '@/components/Footer.astro'
import { SITE } from '@/lib/constants'
import { t } from '@/lib/i18n'
import { categoryColors } from '@/lib/modules'
import { getDocsByModule, docSlug } from '@/services'
import {
  ALGO_PROBLEMS,
  ALGO_CATEGORIES,
  DIFFICULTY_LABELS,
  DIFFICULTY_ORDER,
  countByCategory,
  countByDifficulty,
  type AlgoDifficulty,
} from '@/data/algo-problems'
import '@/styles/pages/index.css'
import '@/styles/pages/algorithms.css'

const base = import.meta.env.BASE_URL

const pageColor = categoryColors.cs

const LEVEL_KEYS: Record<string, string> = {
  beginner: 'algo.level.beginner',
  intermediate: 'algo.level.intermediate',
  advanced: 'algo.level.advanced',
}

const UNITS = [
  {
    id: 'foundation',
    index: '01',
    titleKey: 'algoUnit.foundation.title',
    en: 'Foundations',
    descKey: 'algoUnit.foundation.desc',
    color: categoryColors.cs,
    slugs: [
      '010-AlgorithmAnalysisBasics',
      '020-ArrayAndDynamicArray',
      '040-StackAndQueue',
      '050-SearchAlgorithm',
      '060-LinkedList',
      '070-HashTable',
    ],
  },
  {
    id: 'tree',
    index: '02',
    titleKey: 'algoUnit.tree.title',
    en: 'Trees',
    descKey: 'algoUnit.tree.desc',
    color: categoryColors.backend,
    slugs: ['080-Tree', '090-HeapAndPriorityQueue', '100-BalancedTreeAdvanced'],
  },
  {
    id: 'sort-search',
    index: '03',
    titleKey: 'algoUnit.sortSearch.title',
    en: 'Sorting & Searching',
    descKey: 'algoUnit.sortSearch.desc',
    color: categoryColors.frontend,
    slugs: ['030-SortAlgorithm', '170-BinarySearchAlgorithms'],
  },
  {
    id: 'design',
    index: '04',
    titleKey: 'algoUnit.design.title',
    en: 'Design Paradigms',
    descKey: 'algoUnit.design.desc',
    color: categoryColors.database,
    slugs: [
      '120-DivideAndConquer',
      '130-GreedyAlgorithm',
      '140-RecursionAndBacktracking',
      '160-DynamicProgramming',
      '240-BitmaskDynamicProgramming',
    ],
  },
  {
    id: 'graph',
    index: '05',
    titleKey: 'algoUnit.graph.title',
    en: 'Graph Theory',
    descKey: 'algoUnit.graph.desc',
    color: categoryColors.cloud,
    slugs: [
      '110-GraphAlgorithms',
      '180-UnionFind',
      '250-FloydWarshall',
      '260-KruskalAlgorithm',
      '270-TopologicalSorting',
      '290-NetworkFlow',
    ],
  },
  {
    id: 'string',
    index: '06',
    titleKey: 'algoUnit.string.title',
    en: 'Strings',
    descKey: 'algoUnit.string.desc',
    color: categoryColors.math,
    slugs: ['150-StringAlgorithms', '230-KmpStringMatching'],
  },
  {
    id: 'advanced',
    index: '07',
    titleKey: 'algoUnit.advanced.title',
    en: 'Advanced Structures',
    descKey: 'algoUnit.advanced.desc',
    color: categoryColors.tools,
    slugs: ['190-SegmentTree', '200-FenwickTree', '210-SkipList', '220-BloomFilter'],
  },
  {
    id: 'practice',
    index: '08',
    titleKey: 'algoUnit.practice.title',
    en: 'Theory & Practice',
    descKey: 'algoUnit.practice.desc',
    color: categoryColors.cs,
    slugs: ['280-AlgorithmTheory', '300-LeetCodeInterviewGuide'],
  },
]

const algoDocs = await getDocsByModule('algorithm')
const docBySlug = new Map(algoDocs.map((doc) => [docSlug(doc.id), doc]))

const units = UNITS.map((unit) => ({
  ...unit,
  docs: unit.slugs
    .map((slug) => {
      const doc = docBySlug.get(slug)
      if (!doc) return null
      return {
        slug,
        title: doc.data.title,
        description: doc.data.description,
        difficulty: String(doc.data.difficulty),
        order: doc.data.order,
      }
    })
    .filter((doc): doc is NonNullable<typeof doc> => doc !== null),
})).filter((unit) => unit.docs.length > 0)

const mappedSlugs = new Set<string>(UNITS.flatMap((unit) => [...unit.slugs]))
const restDocs = algoDocs.filter((doc) => !mappedSlugs.has(docSlug(doc.id)))
if (restDocs.length > 0) {
  units.push({
    id: 'more',
    index: '09',
    titleKey: 'algoUnit.more.title',
    en: 'More',
    descKey: 'algoUnit.more.desc',
    color: categoryColors.cs,
    docs: restDocs.map((doc) => ({
      slug: docSlug(doc.id),
      title: doc.data.title,
      description: doc.data.description,
      difficulty: String(doc.data.difficulty),
      order: doc.data.order,
    })),
  } as (typeof units)[number])
}

const docTotal = algoDocs.length
const problemTotal = ALGO_PROBLEMS.length

const catCounts = countByCategory()
const diffCounts = countByDifficulty()

const DIFF_COLOR: Record<AlgoDifficulty, string> = {
  easy: 'success',
  medium: 'warning',
  hard: 'danger',
}

const EXTERNAL_GROUPS = [
  {
    id: 'practice',
    labelKey: 'algoExt.group.practice',
    en: 'Practice & Contests',
    platforms: [
      {
        name: '力扣 LeetCode',
        host: 'leetcode.cn',
        href: 'https://leetcode.cn/',
        tag: '综合题库',
        color: categoryColors.frontend,
        desc: '全球规模领先的算法题库，按标签 / 难度 / 企业筛选，在线判题与题解社区完善，站内题图鉴中标注 LC 序号的题目均可在其上提交验证。',
      },
      {
        name: 'PracHub',
        host: 'prachub.com',
        href: 'https://prachub.com/questions',
        tag: '面试准备',
        color: categoryColors.cs,
        desc: '可按公司、岗位、轮次、主题和难度筛选的候选人报告编程面试题，适合在掌握基础模式后按目标公司定向备战。',
      },
      {
        name: 'NeetCode',
        host: 'neetcode.io',
        href: 'https://neetcode.io/',
        tag: '模式路线',
        color: categoryColors.backend,
        desc: '以题型模式（pattern）组织的免费刷题路线与视频讲解，Blind 75 / NeetCode 150 题单是与本站教程搭配的经典进阶路径。',
      },
      {
        name: '洛谷',
        host: 'luogu.com.cn',
        href: 'https://www.luogu.com.cn/',
        tag: '竞赛训练',
        color: categoryColors.math,
        desc: '中文算法竞赛社区，官方题单与训练营覆盖入门到 NOIP / ICPC 水平，适合在课程表之后追求更强的实现能力。',
      },
      {
        name: 'Codeforces',
        host: 'codeforces.com',
        href: 'https://codeforces.com/',
        tag: '竞技比赛',
        color: categoryColors.cloud,
        desc: '全球竞技编程赛事与题库，评级赛制驱动持续练习；博客区沉淀顶级选手的技巧分享，是限时训练与进阶阅读的双重阵地。',
      },
      {
        name: '牛客网',
        host: 'nowcoder.com',
        href: 'https://www.nowcoder.com/',
        tag: '面试准备',
        color: categoryColors.database,
        desc: '国内笔试面试题库与模拟面试，覆盖校招高频考点与企业真题，求职季的实战演练场。',
      },
      {
        name: 'AtCoder',
        host: 'atcoder.jp',
        href: 'https://atcoder.jp/contests/dp',
        tag: 'DP 专项',
        color: categoryColors.tools,
        desc: '日本竞技编程平台，其 Educational DP Contest 收录 26 道动态规划专项题，从背包到区间 DP 全覆盖，适合作为设计范式单元之后的集中演练。',
      },
    ],
  },
  {
    id: 'visual',
    labelKey: 'algoExt.group.visual',
    en: 'Visualizations',
    platforms: [
      {
        name: 'VisuAlgo',
        host: 'visualgo.net',
        href: 'https://visualgo.net/',
        tag: '算法可视化',
        color: categoryColors.cs,
        desc: '新加坡国立大学 Steven Halim 团队打造的交互式可视化库，50 余种算法逐步动画演示，排序、图遍历与数据结构操作可与站内教程对照观看。',
      },
      {
        name: 'Algorithm Visualizer',
        host: 'algorithm-visualizer.org',
        href: 'https://algorithm-visualizer.org/',
        tag: '代码动画',
        color: categoryColors.frontend,
        desc: '开源可视化平台，支持 JavaScript / Python 代码实时执行并同步生成动画，直观呈现每一步的状态变化，适合验证自己写的模板逻辑。',
      },
      {
        name: 'USFCA 数据结构可视化',
        host: 'cs.usfca.edu',
        href: 'https://www.cs.usfca.edu/~galles/visualization/',
        tag: '结构演示',
        color: categoryColors.backend,
        desc: '旧金山大学 David Galles 制作的交互式演示合集，链表、树、堆、图等经典结构的插入、删除与遍历过程逐帧可操作。',
      },
    ],
  },
  {
    id: 'plan',
    labelKey: 'algoExt.group.plan',
    en: 'Plans & Tracking',
    platforms: [
      {
        name: 'Grind 75',
        host: 'techinterviewhandbook.org',
        href: 'https://www.techinterviewhandbook.org/grind75',
        tag: '计划生成',
        color: categoryColors.cloud,
        desc: '可按剩余周数与每周投入时长自定义题量的刷题计划生成器，自动排布题目顺序，适合求职倒计时阶段安排节奏。',
      },
      {
        name: 'LeetCode 统计面板',
        host: 'leetcode.com',
        href: 'https://leetcode.com/profile/',
        tag: '进度追踪',
        color: categoryColors.database,
        desc: '官方个人统计面板，汇总解题数、提交数与周赛 rating 趋势，可与站内题图鉴的本机掌握标记配合做长期复盘。',
      },
    ],
  },
  {
    id: 'course',
    labelKey: 'algoExt.group.course',
    en: 'Courses & Videos',
    platforms: [
      {
        name: 'MIT 6.006 算法导论',
        host: 'ocw.mit.edu',
        href: 'https://ocw.mit.edu/courses/6-006-introduction-to-algorithms-spring-2020/',
        tag: '公开课',
        color: categoryColors.cs,
        desc: 'Erik Demaine 等主讲的 MIT 经典算法课，Spring 2020 版提供完整视频与习题，覆盖从复杂度分析到高级结构的课程主线。',
      },
      {
        name: 'Stanford CS161',
        host: 'web.stanford.edu',
        href: 'https://web.stanford.edu/class/cs161/',
        tag: '公开课',
        color: categoryColors.cloud,
        desc: 'Tim Roughgarden 主讲的算法设计与分析课程，课程讲义比 CLRS 更精炼，适合在刷题之外补足证明与复杂度分析功底。',
      },
      {
        name: 'Princeton 算法 Part I & II',
        host: 'coursera.org',
        href: 'https://www.coursera.org/learn/algorithms-part1',
        tag: '公开课',
        color: categoryColors.backend,
        desc: 'Sedgewick 主讲、Coursera 上最经典的算法系列课，配套 Java 实现与编程作业，数据结构部分可与站内树形单元互为印证。',
      },
      {
        name: 'Berkeley CS 61B',
        host: 'cs61b.org',
        href: 'https://cs61b.org/',
        tag: '公开课',
        color: categoryColors.frontend,
        desc: 'Josh Hug 主讲的 Java 数据结构课程，实现细节与工程视角兼备，是树、堆、图等单元的理想加深材料。',
      },
      {
        name: 'Back To Back SWE',
        host: 'youtube.com',
        href: 'https://www.youtube.com/@BackToBackSWE',
        tag: '视频频道',
        color: categoryColors.math,
        desc: 'FAANG 工程师视角的算法讲解频道，侧重"为什么这样解"的思路推导而非代码罗列，适合巩固套路背后的直觉。',
      },
      {
        name: 'WilliamFiset',
        host: 'youtube.com',
        href: 'https://www.youtube.com/@WilliamFiset-videos',
        tag: '视频频道',
        color: categoryColors.tools,
        desc: 'Google 工程师的图论与数据结构系列，从邻接表、并查集一路讲到网络流，与站内图论单元逐节互补。',
      },
    ],
  },
] as const
---

<HomeLayout title="算法教学">
  <SEO
    slot="head"
    title="算法教学 · FANDEX"
    description="FANDEX 算法教学：按单元章节组织的算法与数据结构完整教程，页内直切算法题图鉴刷题，并分组收录刷题平台、可视化工具与公开课等外部学习资源推荐。"
    canonical={`${SITE.url}${base}algorithms/`}
    type="website"
  />

  <div class="home-page home-page--sub" data-algo-page style={`--page-color:${pageColor}`}>
    <GeoBgDecor variant="learning-path" />

    <section class="hero">
      <h1 class="hero-title" data-text="算法教学">
        <span class="hero-title-fan">算法</span><span class="hero-title-dex">教学</span>
      </h1>

      <div class="hero-stats-row">
        <div class="hero-stats">
          <div class="stat-item">
            <span class="stat-num">{units.length}</span>
            <span class="stat-label" data-i18n="algo.units">大单元</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-num">{docTotal}</span>
            <span class="stat-label" data-i18n="algo.docs">篇教程</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-num">{problemTotal}</span>
            <span class="stat-label" data-i18n="algo.problems">道配套习题</span>
          </div>
        </div>

        <FeatureNav
          extra={[{ href: `?view=problems`, label: '题图鉴', tooltip: '直达刷题视图：经典算法题与讲解', labelKey: 'algo.atlasEntry.name', tooltipKey: 'algo.atlasEntry.tooltip' }]}
        />
      </div>
    </section>

    <div class="algo-views" data-algo-views role="group" aria-label="教程与题图鉴视图切换" data-i18n-aria="algo.viewsAria">
      <button type="button" class="algo-views__tab is-active" data-view-tab="tutorials" aria-pressed="true">
        <span data-i18n="algo.tabTutorials">教程课程表</span>
        <em data-i18n="algo.tabTutorialsCount" data-i18n-params={JSON.stringify({ n: docTotal })}>{docTotal} 篇</em>
      </button>
      <button type="button" class="algo-views__tab" data-view-tab="problems" aria-pressed="false">
        <span data-i18n="algo.tabProblems">算法题图鉴</span>
        <em data-i18n="algo.tabProblemsCount" data-i18n-params={JSON.stringify({ n: problemTotal })}>{problemTotal} 道题</em>
      </button>
    </div>

    <div class="algo-units" data-algo-view="tutorials">
      {units.map((unit) => (
        <section class="algo-section" id={unit.id} data-unit={unit.id} style={`--unit-color:${unit.color}`}>
          <header class="algo-section__head">
            <h2 class="algo-section__title">
              <span class="algo-section__index" aria-hidden="true">{unit.index}</span>
              <span data-i18n={unit.titleKey}>{t(unit.titleKey)}</span>
            </h2>
            <span class="algo-section__en">{unit.en} · <span data-i18n={unit.descKey}>{t(unit.descKey)}</span></span>
            <span class="algo-section__count" data-i18n="algo.unitDocs" data-i18n-params={JSON.stringify({ n: unit.docs.length })}>{unit.docs.length} 篇</span>
          </header>
          <div class="algo-unit__grid">
            {unit.docs.map((doc, docIndex) => (
              <a
                class="algo-doc-card"
                href={`${base}algorithm/${doc.slug}/`}
                style={`--card-color:${unit.color};animation-delay:${docIndex * 40}ms`}
              >
                <div class="algo-doc-card__head">
                  <span class="algo-doc-card__no" aria-hidden="true">{String(doc.order).padStart(3, '0')}</span>
                  <h3 class="algo-doc-card__title">{doc.title}</h3>
                  <span class="algo-doc-card__level" data-i18n={LEVEL_KEYS[doc.difficulty] ?? undefined}>{doc.difficulty === 'beginner' ? '入门' : doc.difficulty === 'advanced' ? '深入' : '进阶'}</span>
                </div>
                <p class="algo-doc-card__desc">{doc.description}</p>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>

    <section data-algo-view="problems" data-algo-problems hidden>
      <div class="ap-filter">
        <div class="ap-filter__row">
          <span class="ap-filter__label" aria-hidden="true"></span>
          <span class="ap-filter__hint" data-i18n="ap.catLabel">分类</span>
          <button class="ap-chip is-active" type="button" data-filter-cat="all" aria-pressed="true">
            <span data-i18n="ap.all">全部</span><em>{problemTotal}</em>
          </button>
          {ALGO_CATEGORIES.map((cat) => (
            <button
              class="ap-chip"
              type="button"
              data-filter-cat={cat.id}
              title={cat.desc}
              aria-pressed="false"
            >
              {cat.label}<em>{catCounts[cat.id]}</em>
            </button>
          ))}
        </div>
        <div class="ap-filter__row">
          <span class="ap-filter__label" aria-hidden="true"></span>
          <span class="ap-filter__hint" data-i18n="ap.diffLabel">难度</span>
          <button class="ap-chip is-active" type="button" data-filter-diff="all" aria-pressed="true">
            <span data-i18n="ap.all">全部</span>
          </button>
          {DIFFICULTY_ORDER.map((diff) => (
            <button
              class="ap-chip"
              type="button"
              data-filter-diff={diff}
              aria-pressed="false"
            >
              {DIFFICULTY_LABELS[diff]}<em>{diffCounts[diff]}</em>
            </button>
          ))}
        </div>
        <div class="ap-filter__row">
          <span class="ap-filter__label" aria-hidden="true"></span>
          <span class="ap-filter__hint" data-i18n="ap.statusLabel">进度</span>
          <button class="ap-chip is-active" type="button" data-filter-status="all" aria-pressed="true">
            <span data-i18n="ap.all">全部</span>
          </button>
          <button class="ap-chip" type="button" data-filter-status="solved" aria-pressed="false" title="只看已标记掌握的题目" data-i18n-title="ap.solvedTitle">
            <span data-i18n="ap.solved">已掌握</span><em data-ap-status-count="solved">0</em>
          </button>
          <button class="ap-chip" type="button" data-filter-status="review" aria-pressed="false" title="只看标记待复习的题目" data-i18n-title="ap.reviewTitle">
            <span data-i18n="ap.review">待复习</span><em data-ap-status-count="review">0</em>
          </button>
          <input
            class="ap-search"
            type="search"
            data-filter-search
            placeholder="搜索题名 / 标签"
            data-i18n-placeholder="ap.searchPlaceholder"
            aria-label="按题名或标签搜索题目"
            data-i18n-aria="ap.searchAria"
          />
        </div>
      </div>

      <div class="ap-count-row">
        <p class="ap-count" data-filter-count aria-live="polite"></p>
        <span class="ap-count-note" data-i18n="ap.countNote">掌握 / 复习标记仅保存在当前浏览器</span>
      </div>

      <div class="ap-grid">
        {ALGO_PROBLEMS.map((problem, i) => (
          <article
            class="ap-card"
            data-algo-item
            data-cat={problem.category}
            data-diff={problem.difficulty}
            data-slug={problem.slug}
            data-search={`${problem.lc ?? ''} ${problem.title} ${problem.titleEn} ${problem.tags.join(' ')} ${problem.brief}`.toLowerCase()}
            style={`--ap-color:var(--color-${DIFF_COLOR[problem.difficulty]}-base);animation-delay:${Math.min(i, 24) * 30}ms`}
          >
            <a
              class="ap-card__link"
              href={`${base}algorithms/problems/${problem.slug}/`}
              aria-label={`${problem.title}（${DIFFICULTY_LABELS[problem.difficulty]}）`}
            >
              <div class="ap-card__head">
                <span class="ap-card__no" aria-hidden="true">{problem.lc ? `LC ${problem.lc}` : <span data-i18n="ap.classic">经典</span>}</span>
                <h3 class="ap-card__title">{problem.title}</h3>
                <span class={`ap-badge ap-badge--${problem.difficulty}`}>{DIFFICULTY_LABELS[problem.difficulty]}</span>
              </div>
              <p class="ap-card__en">{problem.titleEn}</p>
              <p class="ap-card__brief">{problem.brief}</p>
              <div class="ap-card__tags">
                {problem.tags.map((tag) => (
                  <span class="ap-card__tag">{tag}</span>
                ))}
              </div>
            </a>
            <!-- 本机进度标记：已掌握 / 待复习（z-index 高于拉伸链接） -->
            <div class="ap-card__marks">
              <button
                type="button"
                class="ap-mark"
                data-mark="solved"
                aria-pressed="false"
                title="标记为已掌握"
                data-i18n-title="ap.markSolved"
              >
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M4 12.5l5 5L20 6.5" />
                </svg>
              </button>
              <button
                type="button"
