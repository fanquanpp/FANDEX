                </svg>
              </button>
            </div>
          </article>
        ))}
      </div>

      <div class="ap-empty" data-ap-empty hidden>
        <p data-i18n="ap.empty">没有匹配的题目</p>
        <div class="ap-empty__actions">
          <button type="button" class="ap-chip" data-ap-clear-q data-i18n="ap.clearQ">清除关键词</button>
          <button type="button" class="ap-chip" data-ap-reset data-i18n="ap.reset">重置全部筛选</button>
        </div>
      </div>
    </section>

    <section class="algo-ext" aria-label="外部刷题平台推荐" data-i18n-aria="algoExt.title" data-algo-ext>
