---
import EntryWaveBorder from '@/components/EntryWaveBorder.astro';
import HomeLayout from '@/components/HomeLayout.astro'
import SEO from '@/components/SEO.astro'
import ModuleCard from '@/components/ModuleCard.astro'
import GeoBgDecor from '@/components/GeoBgDecor.astro'
import Footer from '@/components/Footer.astro'
import { getDocStats, getAllModules, getCategories, getModulesByCategory } from '@/services'
import { getFeatureEntries } from '@/lib/feature-entries'
import '@/styles/pages/index.css'

const stats = await getDocStats()
const allModules = getAllModules()

const heroEntries = getFeatureEntries(`${import.meta.env.BASE_URL}`)

const grouped = getCategories()
  .map(cat => ({
    key: cat.id,
    label: cat.label,
    color: cat.color,
    modules: getModulesByCategory(cat.id),
  }))
  .filter(g => g.modules.length > 0)
---

<HomeLayout title="首页">
  <SEO slot="head" title="FANDEX" description="循序渐进的自学之旅，从第一行代码到理解整个世界。覆盖工具链、开发语言、数据库、计算机科学、工程基础设施与数据技术六大领域" type="website" />

  <div class="home-page">
    <GeoBgDecor variant="home" />
    <section class="hero">
      <h1 class="hero-title" data-text="FANDEX">
        <span class="hero-title-fan">FAN</span><span class="hero-title-dex">DEX</span>
      </h1>
      <div class="hero-stats-row">
        <div class="hero-stats">
          <div class="stat-item">
            <span class="stat-num" data-countup={allModules.length} style={`min-width:${String(allModules.length).length}ch`}>{allModules.length}</span>
            <span class="stat-label" data-i18n="home.modules">模块</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-num" data-countup={stats.totalDocs} style={`min-width:${String(stats.totalDocs).length}ch`}>{stats.totalDocs}</span>
            <span class="stat-label" data-i18n="home.docs">文档</span>
          </div>
        </div>
        <nav class="hero-entries" aria-label="功能入口" data-i18n-aria="home.entriesAria">
          {heroEntries.map((entry, i) => (
            <a
              href={entry.href}
              class="entry-btn"
              style={`--entry-i:${i}`}
              data-tooltip={entry.tooltip}
              data-i18n-tooltip={entry.tooltipKey}
              data-tooltip-pos="bottom"
            >
              <EntryWaveBorder />
              <span class="entry-name" data-i18n={entry.nameKey}>{entry.name}</span>
            </a>
          ))}
        </nav>
      </div>

      <div class="hero-terminal" aria-hidden="true">
        <div class="hero-terminal__bar">
          <span class="hero-terminal__title">fandex://init</span>
          <span class="hero-terminal__rec">[REC]</span>
        </div>
        <div class="hero-terminal__body" data-terminal><code data-terminal-log></code><input class="hero-terminal__input" data-terminal-input type="text" readonly tabindex="-1" autocomplete="off" autocapitalize="off" spellcheck="false" /></div>
      </div>
    </section>

    {grouped.map(group => (
      <section class="category-section fndx-scroll-reveal" data-category={group.key}>
        <div class="category-header">
          <!-- 左侧：几何色条 + 标签 + 计数 + 折叠箭头（整体可点击折叠） -->
          <!-- 标题按钮：与 Hero 入口同款 SVG 波浪描边悬停动画
               分类主题色通过按钮上的 --marker-color 注入，
               .entry-border 描边在 hover 时执行路径书写动画 -->
          <button class="category-header__lead" data-toggle type="button" style={`--marker-color:${group.color}`} aria-label={`折叠/展开 ${group.label} 分类`} data-i18n-aria="home.toggleCategory" data-i18n-params={JSON.stringify({ label: group.label })}>
            <EntryWaveBorder />
            <span class="category-marker"></span>
            <span class="category-tag">{group.label}</span>
            <span class="category-count">{group.modules.length}</span>
            <svg class="toggle-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <!-- 右侧：左右导航按钮，统一 fndx-icon-btn 风格 -->
          <div class="category-header__actions">
            <button class="category-nav-btn fndx-icon-btn" data-nav="-1" type="button" aria-label="向左滚动" data-i18n-aria="home.scrollLeft">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <button class="category-nav-btn fndx-icon-btn" data-nav="1" type="button" aria-label="向右滚动" data-i18n-aria="home.scrollRight">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
          </div>
        </div>
        <!-- 横向无限滑动选择器：JS 克隆卡片实现前向无限循环 -->
        <div class="feature-scroller" data-scroller>
          <div class="feature-track" data-track>
            {group.modules.map(mod => (
              <ModuleCard mod={mod} color={group.color} />
            ))}
          </div>
        </div>
      </section>
    ))}

    <Footer />
  </div>
</HomeLayout>

<script>
  import '@/lib/home-interactions';
  import '@/lib/stat-count-up';
  import '@/lib/home-terminal';
</script>
