---
/**
 * 首页
 * 展示所有学习模块，按分类分组显示
 * 包含 Hero 区域（统计信息）、分类模块网格、页脚
 *
 * 样式与交互逻辑已拆分至独立文件：
 * - styles/pages/index.css       页面级样式（容器、Hero、分类网格、响应式）
 * - lib/home-interactions.ts     客户端脚本（分类折叠/展开）
 */
import HomeLayout from '@/components/HomeLayout.astro'
import SEO from '@/components/SEO.astro'
import ModuleCard from '@/components/ModuleCard.astro'
import GeoBgDecor from '@/components/GeoBgDecor.astro'
import Footer from '@/components/Footer.astro'
// 通过 Service 层获取数据，UI 层禁止直接调用 getCollection
import { getDocStats, getAllModules, getCategories, getModulesByCategory } from '@/services'
// 桌面端构建标记：DESKTOP_BUILD=1 时不渲染 playground 入口（桌面端无在线编程）
import { IS_DESKTOP_BUILD } from '@/lib/constants'
import '@/styles/pages/index.css'

// 通过 doc-service 获取文档统计（总数、模块数、分类数、标签数）
const stats = await getDocStats()
// 通过 module-service 获取全部模块（只读数组），用于首页模块计数
const allModules = getAllModules()

// 通过 module-service 获取分类信息并按分类分组模块
// getCategories() 已按 categoryOrder 顺序返回 { id, label, color }
const grouped = getCategories()
  .map(cat => ({
    key: cat.id,
    label: cat.label,
    color: cat.color,
    modules: getModulesByCategory(cat.id),
  }))
  .filter(g => g.modules.length > 0)
---

<HomeLayout title="首页">
  <SEO slot="head" title="FANDEX" description="循序渐进的自学之旅，从第一行代码到理解整个世界。覆盖工具链、开发语言、数据库、计算机科学、工程基础设施与数据技术六大领域" type="website" />

  <div class="home-page">
    <!-- 几何背景装饰层 · home 变体：品牌光晕 + S 曲线 + 涟漪环 + 三角切片等 -->
    <GeoBgDecor variant="home" />
    <!-- Hero 区域：站点标题和统计信息 -->
    <section class="hero">
      <!-- Hero 标题：FAN/DEX 分离 + 渐变背景动效 + 残影伪元素
           data-text 用于 ::after 残影伪元素通过 attr() 读取 -->
      <h1 class="hero-title" data-text="FANDEX">
        <span class="hero-title-fan">FAN</span><span class="hero-title-dex">DEX</span>
      </h1>
      <!-- 统计数据 + 功能入口同一行容器
           左侧：模块/文档数统计；右侧：三大功能入口（纯文字 + SVG border 描边动画） -->
      <div class="hero-stats-row">
        <div class="hero-stats">
          <div class="stat-item">
            <span class="stat-num">{allModules.length}</span>
            <span class="stat-label">模块</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-num">{stats.totalDocs}</span>
            <span class="stat-label">文档</span>
          </div>
        </div>
        <!-- 功能入口区：纯文字按钮 + SVG 路径签名动画
             使用二次贝塞尔曲线（Q 命令）绘制手绘风格波浪路径，
             hover 时 stroke-dashoffset 从 250 → 0 实现路径书写动画
             三个按钮颜色统一使用项目标题主题色 var(--color-accent-base) -->
        <nav class="hero-entries" aria-label="功能入口">
          {!IS_DESKTOP_BUILD && (
            <a href={`${import.meta.env.BASE_URL}playground/`} class="entry-btn" data-tooltip="前端实验工作台" data-tooltip-pos="bottom">
              <svg class="entry-border" viewBox="0 0 200 52" preserveAspectRatio="none" aria-hidden="true">
                <path d="M10,26 Q30,6 60,10 T110,26 T160,42 T190,26"/>
              </svg>
              <span class="entry-name">在线编程</span>
            </a>
          )}
          <a href={`${import.meta.env.BASE_URL}syntax/`} class="entry-btn" data-tooltip="语法快速查阅" data-tooltip-pos="bottom">
            <svg class="entry-border" viewBox="0 0 200 52" preserveAspectRatio="none" aria-hidden="true">
              <path d="M10,26 Q30,6 60,10 T110,26 T160,42 T190,26"/>
            </svg>
            <span class="entry-name">语法速览</span>
          </a>
          <a href={`${import.meta.env.BASE_URL}learning-path/`} class="entry-btn" data-tooltip="系统化学习路径" data-tooltip-pos="bottom">
            <svg class="entry-border" viewBox="0 0 200 52" preserveAspectRatio="none" aria-hidden="true">
              <path d="M10,26 Q30,6 60,10 T110,26 T160,42 T190,26"/>
            </svg>
            <span class="entry-name">学习路线</span>
          </a>
        </nav>
      </div>
    </section>

    <!-- 按分类展示模块卡片（横向无限滑动选择器） -->
    {grouped.map(group => (
      <section class="category-section fndx-scroll-reveal" data-category={group.key}>
        <div class="category-header">
          <!-- 左侧：几何色条 + 标签 + 计数 + 折叠箭头（整体可点击折叠） -->
          <!-- 标题按钮：与 Hero 入口同款 SVG 波浪描边悬停动画
               分类主题色通过按钮上的 --marker-color 注入，
               .entry-border 描边在 hover 时执行路径书写动画 -->
          <button class="category-header__lead" data-toggle type="button" style={`--marker-color:${group.color}`} aria-label={`折叠/展开 ${group.label} 分类`}>
            <svg class="entry-border" viewBox="0 0 200 52" preserveAspectRatio="none" aria-hidden="true">
              <path d="M10,26 Q30,6 60,10 T110,26 T160,42 T190,26"/>
            </svg>
            <span class="category-marker"></span>
            <span class="category-tag">{group.label}</span>
            <span class="category-count">{group.modules.length}</span>
            <svg class="toggle-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <!-- 右侧：左右导航按钮，统一 fndx-icon-btn 风格 -->
          <div class="category-header__actions">
            <button class="category-nav-btn fndx-icon-btn" data-nav="-1" type="button" aria-label="向左滚动">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <button class="category-nav-btn fndx-icon-btn" data-nav="1" type="button" aria-label="向右滚动">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
          </div>
        </div>
        <!-- 横向无限滑动选择器：JS 克隆卡片实现前向无限循环 -->
        <div class="feature-scroller" data-scroller>
          <div class="feature-track" data-track>
            {group.modules.map(mod => (
              <ModuleCard mod={mod} color={group.color} />
            ))}
          </div>
        </div>
      </section>
    ))}

    <!-- 页脚：极简单行版权（后续重新设计） -->
    <Footer />
  </div>
</HomeLayout>

<!-- 客户端交互脚本：分类区域折叠/展开 -->
<script>
  import '@/lib/home-interactions';
</script>
