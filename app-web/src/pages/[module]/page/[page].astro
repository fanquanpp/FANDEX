---
import Layout from '@/components/Layout.astro';
import SEO from '@/components/SEO.astro';
import Sidebar from '@/components/Sidebar.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import ModulePageContent from '@/components/ModulePageContent.astro';
import { getModule } from '@/lib/modules';
import { MODULE_PAGE_SIZE } from '@/lib/constants';
import { getDocsByModule } from '@/services';

export async function getStaticPaths() {
  const { modules } = await import('@/lib/modules');
  const { getDocsByModule } = await import('@/services');
  const paths = [];
  for (const m of modules) {
    const docs = await getDocsByModule(m.id);
    const totalPages = Math.ceil(docs.length / MODULE_PAGE_SIZE);
    for (let p = 2; p <= totalPages; p++) {
      paths.push({ params: { module: m.id, page: String(p) } });
    }
  }
  return paths;
}

const { module, page: pageParam } = Astro.params as { module: string; page: string };
const page = Number.parseInt(pageParam || '1', 10);
const meta = getModule(module || '');

if (!meta || !Number.isFinite(page) || page < 2) {
  return Astro.redirect(`${import.meta.env.BASE_URL}${module || ''}/`);
}

const sortedDocs = await getDocsByModule(module);
const totalPages = Math.ceil(sortedDocs.length / MODULE_PAGE_SIZE);
if (page > totalPages) {
  return Astro.redirect(`${import.meta.env.BASE_URL}${module}/`);
}

const baseUrl = import.meta.env.BASE_URL;
const breadcrumb = [
  { label: '首页', href: `${baseUrl}`, i18nKey: 'breadcrumb.home' },
  { label: meta.title, href: `${baseUrl}${module}/` },
  { label: `第 ${page} 页`, i18nKey: 'breadcrumb.page', i18nParams: { n: page } },
];
---

<Layout title={`${meta.title} · 第 ${page} 页`}>
  <SEO
    slot="head"
    title={`${meta.title} · 第 ${page} 页`}
    description={meta.description}
    canonical={new URL(Astro.url.pathname, Astro.site).href}
  />
  {
}
  <link
    rel="prev"
    href={page === 2 ? new URL(`${baseUrl}${module}/`, Astro.site).href : new URL(`${baseUrl}${module}/page/${page - 1}/`, Astro.site).href}
    slot="head"
  />
  {page < totalPages && <link rel="next" href={new URL(`${baseUrl}${module}/page/${page + 1}/`, Astro.site).href} slot="head" />}
  <Sidebar slot="sidebar" moduleId={module} />

  <Breadcrumb items={breadcrumb} hasSidebar />
  <ModulePageContent module={module} meta={meta} page={page} docs={sortedDocs} />
</Layout>
