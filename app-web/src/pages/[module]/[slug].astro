---
/**
 * 文档详情页路由
 * 动态路由 [module]/[slug]，为每篇文档生成独立页面
 * 包含面包屑导航、前置知识提示、文档内容、知识检测、上下篇导航
 */
import Layout from '@/components/Layout.astro';
import SEO from '@/components/SEO.astro';
import Sidebar from '@/components/Sidebar.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import DocNav from '@/components/DocNav.astro';
import GeoBgDecor from '@/components/GeoBgDecor.astro';
import { render } from 'astro:content';
// KaTeX 样式按需加载：仅含数学公式的页面才引用该 CSS（避免全站 CSS 携带 KaTeX 样式与字体声明）
import katexCssUrl from 'katex/dist/katex.min.css?url';
import { getModule, modulePrerequisites, categoryColors, getPrimaryCategory } from '@/lib/modules';
// 通过 doc-service 获取文档数据与导航信息，UI 层禁止直接调用 getCollection
// docSlug/computeReadingTime/getDocNavigation 均由 Service 层统一提供
import {
  getAllDocs,
  getDocsByModule,
  getDocNavigation,
  computeReadingTime,
  docSlug,
  type DocEntry,
} from '@/services';

/** 生成静态路径：为每篇文档创建一个页面 */
export async function getStaticPaths() {
  // 通过 doc-service 获取全部文档（已按模块和 order 排序）
  const docs = await getAllDocs();
  return docs.map((doc) => {
    const slug = docSlug(doc.id);
    return {
      params: { module: doc.data.module, slug },
      props: { doc },
    };
  });
}

const { doc } = Astro.props as { doc: DocEntry };
const { module, slug } = Astro.params as { module: string; slug: string };
// 渲染 Markdown 内容并获取标题列表
const { Content, headings } = await render(doc);
const meta = getModule(module || '');

// 通过 doc-service 获取当前模块排序后的文档列表，传递给 Sidebar 避免重复查询
const sortedDocs = await getDocsByModule(module);

// 通过 doc-service 计算预计阅读时间（frontmatter 已不再携带 readingTime 字段，统一按正文推算）
const readingTime = computeReadingTime(doc.body || '');

// 通过 doc-service 获取上下篇导航信息，预计算后传递给 DocNav 组件
const navigation = await getDocNavigation(module, slug);

// 面包屑导航数据
const breadcrumb = [
  { label: '首页', href: `${import.meta.env.BASE_URL}` },
  { label: meta?.title || module, href: `${import.meta.env.BASE_URL}${module}/` },
  { label: doc.data.title },
];

/** 计算模块分类色对应的 --module-color 内联样式字符串
 *  用于 .doc-page 容器与 TableOfContents 组件，统一链接装饰色（需求3）
 *  仅在颜色非空时设置，避免空串导致 var() fallback 失效 */
const moduleColor = categoryColors[meta ? getPrimaryCategory(meta) : 'tools'];
const moduleColorStyle = moduleColor ? `--module-color:${moduleColor}` : undefined;

/**
 * 判断文档正文是否包含数学公式（排除代码块），用于决定是否加载 KaTeX 样式
 * 支持 $$...$$ 块级公式与 $...$ 行内公式；转义 \$ 不触发
 */
function containsMath(body: string): boolean {
  const withoutCode = body.replace(/```[\s\S]*?```/g, '');
  return /\$\$[\s\S]*?\$\$|(^|[^\\])\$[^$\n]+?\$/.test(withoutCode);
}
const hasMath = containsMath(doc.body || '');
---

<Layout title={doc.data.title}>
  <SEO
    slot="head"
    title={doc.data.title}
    description={doc.data.description}
    canonical={`${Astro.site}${Astro.url.pathname}`}
    publishedDate={doc.data.updated || undefined}
    modifiedDate={doc.data.updated || undefined}
    breadcrumb={breadcrumb}
  />
  {hasMath && <link rel="stylesheet" href={katexCssUrl} slot="head" />}
  <Sidebar
    slot="sidebar"
    moduleId={module}
    currentSlug={slug}
    sortedDocs={sortedDocs}
  />

  <!-- 目录大纲：通过 toc 插槽渲染到 Layout 右侧栏，由 TableOfContents 共享组件控制显隐
       注入 --module-color 统一 TOC 链接装饰色与侧边栏/文档列表一致（需求3） -->
  <TableOfContents slot="toc" headings={headings} style={moduleColorStyle} />

  <div class="doc-page" style={moduleColorStyle} id="doc-root" data-module={module} data-slug={slug}>
    <!-- 几何背景装饰层 · docs 变体：网格底纹 + 品牌光晕 + 几何线条（克制 8 项） -->
    <GeoBgDecor variant="docs" />
    <!-- 面包屑导航 -->
    <Breadcrumb items={breadcrumb} hasSidebar />
    <!-- 前置知识提示 -->
    {
      (() => {
        const prereqs =
          doc.data.prerequisites?.length > 0
            ? doc.data.prerequisites
            : modulePrerequisites[module] || [];
        if (prereqs.length === 0) return null;
        return (
          <div class="prereq-notice">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <>
                <circle cx="12" cy="12" r="10" />
                <line x1="12" y1="8" x2="12" y2="12" />
                <line x1="12" y1="16" x2="12.01" y2="16" />
              </>
            </svg>
            <span>
              前置知识:{' '}
              {prereqs.map((p: string, i: number) => {
                const parts = p.split('/');
                const modId = parts[0] || ''; // noUncheckedIndexedAccess：数组访问可能返回 undefined，提供兜底
                const modMeta = getModule(modId);
                const label = modMeta ? modMeta.title : p;
                const href =
                  parts.length > 1
                    ? `${import.meta.env.BASE_URL}${p}/`
                    : `${import.meta.env.BASE_URL}${modId}/`;
                return (
                  <>
                    {i > 0 && '、'}
                    <a href={href}>{label}</a>
                  </>
                );
              })}
            </span>
          </div>
        );
      })()
    }
    <!-- 文章主体 -->
    <article class="prose">
      <!-- 标题行 -->
      <div class="doc-title-row fndx-scroll-reveal">
        <h1 class="doc-title">{doc.data.title}</h1>
      </div>
      <!-- 文档元信息：阅读时间、难度、更新日期 -->
      <header class="doc-header fndx-scroll-reveal-fade">
        <div class="doc-meta">
          <span class="doc-meta-item doc-reading-time">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"
              ></polyline></svg
            >
            {readingTime} min
          </span>
          <span
            class={`doc-meta-item doc-difficulty diff-${doc.data.difficulty || 'intermediate'}`}
          >
            {
              doc.data.difficulty === 'beginner'
                ? 'Beginner'
                : doc.data.difficulty === 'advanced'
                  ? 'Advanced'
                  : 'Intermediate'
            }
          </span>
          {
            doc.data.updated && (
              <span class="doc-meta-item doc-updated">
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <>
                    <rect x="3" y="4" width="18" height="18" rx="2" />
                    <line x1="16" y1="2" x2="16" y2="6" />
                    <line x1="8" y1="2" x2="8" y2="6" />
                    <line x1="3" y1="10" x2="21" y2="10" />
                  </>
                </svg>
                {new Date(doc.data.updated).toLocaleDateString('zh-CN')}
              </span>
            )
          }
        </div>
        <!-- 文档描述 -->
        {doc.data.description && <p class="doc-description">{doc.data.description}</p>}
      </header>
      <!-- 文档正文内容 -->
      <Content />
    </article>
    <!-- 上下篇导航：传递预计算的 prev/next，避免组件内部重复查询 -->
    <DocNav prev={navigation.prev} next={navigation.next} />
  </div>
</Layout>

<style>
  /* 文档详情页样式 — 归入 @layer pages，避免未分层 CSS 覆盖 ark 令牌导致主题切换失效 */
  @layer pages {
  /* 文档页面容器：作为装饰层的定位上下文
   注：不设置 overflow:hidden，以保留 .doc-title-row 的 sticky 定位 */
  .doc-page {
    position: relative;
    padding: var(--spacing-md) var(--spacing-lg) var(--spacing-2xl);
    width: 100%;
    /* 限制内容最大宽度并居中，避免宽屏下行宽过长影响阅读体验 */
    /* fallback 与 --content-width 保持一致，防止变量未加载时回退到较窄值 */
    max-width: var(--content-width, 1280px);
    margin-inline: auto;
    min-height: 100%;
  }

  /* 确保文档内容层在几何装饰层之上 */
  .doc-page > :not(.geo-bg-decor) {
    position: relative;
    z-index: 1;
  }

  /* 前置知识提示条 */
  .prereq-notice {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-sm) var(--spacing-md);
    margin-bottom: var(--spacing-md);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-light);
    border-left: 3px solid var(--color-warning);
    font-size: 0.85em;
    color: var(--color-text-secondary);
  }

  .prereq-notice svg {
    flex-shrink: 0;
    color: var(--color-warning);
  }

  .prereq-notice a {
    /* 前置知识链接颜色改为模块分类主题色 */
    color: var(--module-color, var(--color-primary));
    text-decoration: none;
  }

  .prereq-notice a:hover {
    text-decoration: underline;
  }

  /* 文档头部元信息区域 */
  .doc-header {
    margin-bottom: var(--spacing-lg);
    padding-bottom: var(--spacing-lg);
    border-bottom: 1px solid var(--color-border-light);
  }

  /* 标题行：粘性定位，包含标题和进度按钮 */
  .doc-title-row {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-sm);
    padding: var(--spacing-sm) 0;
    border-bottom: 1px solid var(--color-border-light);
    margin-bottom: var(--spacing-sm);
  }

  .doc-header {
    margin-bottom: var(--spacing-xl);
  }

  .doc-title-row .doc-title {
    margin-bottom: 0;
  }

  /* 文档标题 */
  .doc-title {
    margin-bottom: var(--spacing-sm);
    font-size: 1.6em;
    line-height: 1.3;
  }

  /* 元信息行 */
  .doc-meta {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
    margin-bottom: var(--spacing-sm);
  }

  .doc-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-display);
    font-size: 0.78em;
    color: var(--color-text-tertiary);
  }

  /* 难度标签：不同难度使用不同颜色 */
  .doc-difficulty {
    padding: 2px 8px;
    border-radius: 3px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  /* 入门级：成功色（绿） */
  .diff-beginner {
    background: color-mix(in srgb, var(--color-success) 15%, var(--color-bg));
    color: var(--color-success);
  }

  /* 中级：警告色（橙） */
  .diff-intermediate {
    background: color-mix(in srgb, var(--color-warning) 15%, var(--color-bg));
    color: var(--color-warning);
  }

  /* 高级：危险色（红） */
  .diff-advanced {
    background: color-mix(in srgb, var(--color-danger) 15%, var(--color-bg));
    color: var(--color-danger);
  }

  /* 文档描述 */
  .doc-description {
    margin-top: var(--spacing-sm);
    font-size: 0.92em;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* 移动端适配 */
  @media (max-width: 768px) {
    .doc-page {
      padding: var(--spacing-sm) var(--spacing-md) var(--spacing-2xl);
    }

    .doc-title {
      font-size: 1.3em;
    }

    .doc-meta {
      gap: 6px;
    }
  }
  } /* end @layer pages */
</style>

<!-- 客户端脚本：Mermaid 图表惰性渲染（仅文档页引入）
     扫描 ```mermaid 代码块，临近视口时按需加载 mermaid ESM 渲染为 SVG；
     页面不含图表时零网络请求、零运行时开销 -->
<script>
  import '@/lib/mermaid-render';
</script>

<!-- 客户端脚本：学习进度记录与装饰（侧边栏已读标记 / 模块进度条） -->
<script>
  import '@/lib/progress';
</script>
