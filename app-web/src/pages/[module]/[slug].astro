---
import Layout from '@/components/Layout.astro';
import SEO from '@/components/SEO.astro';
import Sidebar from '@/components/Sidebar.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import DocNav from '@/components/DocNav.astro';
import GeoBgDecor from '@/components/GeoBgDecor.astro';
import { render } from 'astro:content';
import { getModule, modulePrerequisites, categoryColors, getPrimaryCategory } from '@/lib/modules';
import {
  getAllDocs,
  getDocsByModule,
  getDocNavigation,
  computeReadingTime,
  docSlug,
  type DocEntry,
} from '@/services';

export async function getStaticPaths() {
  const docs = await getAllDocs();
  return docs.map((doc) => {
    const slug = docSlug(doc.id);
    return {
      params: { module: doc.data.module, slug },
      props: { doc },
    };
  });
}

const { doc } = Astro.props as { doc: DocEntry };
const { module, slug } = Astro.params as { module: string; slug: string };
const { Content, headings } = await render(doc);
const meta = getModule(module || '');

const sortedDocs = await getDocsByModule(module);

const readingTime = computeReadingTime(doc.body || '');

const navigation = await getDocNavigation(module, slug);

// 与 TableOfContents 的过滤/最小数量逻辑保持一致：不足时彻底不渲染 toc 插槽，
// 否则 Layout 会保留 has-toc 的 16rem 右栏留白
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const showToc = tocHeadings.length >= 3;

const breadcrumb = [
  { label: '首页', href: `${import.meta.env.BASE_URL}`, i18nKey: 'breadcrumb.home' },
  { label: meta?.title || module, href: `${import.meta.env.BASE_URL}${module}/` },
  { label: doc.data.title },
];

const moduleColor = categoryColors[meta ? getPrimaryCategory(meta) : 'tools'];
const moduleColorStyle = moduleColor ? `--module-color:${moduleColor}` : undefined;
---

<Layout title={doc.data.title}>
  <SEO
    slot="head"
    title={doc.data.title}
    description={doc.data.description}
    canonical={new URL(Astro.url.pathname, Astro.site).href}
    publishedDate={doc.data.updated || undefined}
    modifiedDate={doc.data.updated || undefined}
    breadcrumb={breadcrumb}
  />
  <Sidebar
    slot="sidebar"
    moduleId={module}
    currentSlug={slug}
    sortedDocs={sortedDocs}
  />

  {showToc && <TableOfContents slot="toc" headings={headings} style={moduleColorStyle} />}

  <div class="doc-page" style={moduleColorStyle} id="doc-root" data-module={module} data-slug={slug}>
    <GeoBgDecor variant="docs" />
    <Breadcrumb items={breadcrumb} hasSidebar />
    {
      (() => {
        const prereqs =
          doc.data.prerequisites?.length > 0
            ? doc.data.prerequisites
            : modulePrerequisites[module] || [];
        if (prereqs.length === 0) return null;
        return (
          <div class="prereq-notice">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <>
                <circle cx="12" cy="12" r="10" />
                <line x1="12" y1="8" x2="12" y2="12" />
                <line x1="12" y1="16" x2="12.01" y2="16" />
              </>
            </svg>
            <span data-i18n="doc.prereq">前置知识: </span>
            <span>
            {prereqs.map((p: string, i: number) => {
                const parts = p.split('/');
                const modId = parts[0] || '';
                const modMeta = getModule(modId);
                const label = modMeta ? modMeta.title : p;
                const href =
                  parts.length > 1
                    ? `${import.meta.env.BASE_URL}${p}/`
                    : `${import.meta.env.BASE_URL}${modId}/`;
                return (
                  <>
                    {i > 0 && '、'}
                    <a href={href}>{label}</a>
                  </>
                );
              })}
            </span>
          </div>
        );
      })()
    }
    <article class="prose">
      <div class="doc-title-row fndx-scroll-reveal">
        <h1 class="doc-title">{doc.data.title}</h1>
      </div>
      <header class="doc-header fndx-scroll-reveal-fade">
        <div class="doc-meta">
          <span class="doc-meta-item doc-reading-time">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"
              ></polyline></svg
            >
            {readingTime} min
          </span>
          <span
            class={`doc-meta-item doc-difficulty diff-${doc.data.difficulty || 'intermediate'}`}
          >
            {
              <span data-i18n={`doc.difficulty.${doc.data.difficulty || 'intermediate'}`}>
                {doc.data.difficulty === 'beginner'
                  ? '入门'
                  : doc.data.difficulty === 'advanced'
                    ? '高级'
                    : '中级'}
              </span>
            }
          </span>
          {
            doc.data.updated && (
              <span class="doc-meta-item doc-updated">
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <>
                    <rect x="3" y="4" width="18" height="18" rx="2" />
                    <line x1="16" y1="2" x2="16" y2="6" />
                    <line x1="8" y1="2" x2="8" y2="6" />
                    <line x1="3" y1="10" x2="21" y2="10" />
                  </>
                </svg>
                <time datetime={new Date(doc.data.updated).toISOString()} data-i18n-date={new Date(doc.data.updated).toISOString()}>
                  {new Date(doc.data.updated).toLocaleDateString('zh-CN')}
                </time>
              </span>
            )
          }
        </div>
        {doc.data.description && <p class="doc-description">{doc.data.description}</p>}
      </header>
      <Content />
    </article>
    <DocNav prev={navigation.prev} next={navigation.next} />
  </div>
</Layout>

<style>
  @layer pages {
  .doc-page {
    position: relative;
    padding: var(--space-4) var(--space-6) var(--space-12);
    width: 100%;
    max-width: var(--content-width, 1280px);
    margin-inline: auto;
    min-height: 100%;
  }

  .doc-page > :not(.decor-bg) {
    position: relative;
    z-index: 1;
  }

  .prereq-notice {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    margin-bottom: var(--space-4);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-light);
    border-left: 3px solid var(--color-warning-base);
    font-size: 0.85em;
    color: var(--color-text-secondary);
  }

  .prereq-notice svg {
    flex-shrink: 0;
    color: var(--color-warning-base);
  }

  .prereq-notice a {
    color: var(--module-color, var(--color-accent-base));
    text-decoration: none;
  }

  .prereq-notice a:hover {
    text-decoration: underline;
  }

  .doc-header {
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border-light);
  }

  .doc-title-row {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--color-bg-primary);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-border-light);
    margin-bottom: var(--space-2);
  }

  .doc-header {
    margin-bottom: var(--space-8);
  }

  .doc-title-row .doc-title {
    margin-bottom: 0;
  }

  .doc-title {
    margin-bottom: var(--space-2);
    font-size: 1.6em;
    line-height: 1.3;
  }

  .doc-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: var(--space-2);
  }

  .doc-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-family-heading);
    font-size: 0.78em;
    color: var(--color-text-tertiary);
  }

  .doc-difficulty {
    padding: 2px 8px;
    border-radius: 3px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .diff-beginner {
    background: color-mix(in srgb, var(--color-success-base) 15%, var(--color-bg-primary));
    color: var(--color-success-base);
  }

  .diff-intermediate {
    background: color-mix(in srgb, var(--color-warning-base) 15%, var(--color-bg-primary));
    color: var(--color-warning-base);
  }

  .diff-advanced {
    background: color-mix(in srgb, var(--color-danger) 15%, var(--color-bg-primary));
    color: var(--color-danger);
  }

  .doc-description {
    margin-top: var(--space-2);
    font-size: 0.92em;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .doc-page {
      padding: var(--space-2) var(--space-4) var(--space-12);
    }

    .doc-title {
      font-size: 1.3em;
    }

    .doc-meta {
      gap: 6px;
    }
  }
  }
</style>

<script>
  import '@/lib/mermaid-render';
</script>
