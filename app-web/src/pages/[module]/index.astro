---
/**
 * 模块文档列表页（第 1 页）
 * 第 2 页起由 [module]/page/[page].astro 承载，两者共用 ModulePageContent 组件。
 * 超大模块（300+ 篇）经分页后单页体积与 viewport 预取带宽显著下降。
 */
import Layout from '@/components/Layout.astro';
import SEO from '@/components/SEO.astro';
import Sidebar from '@/components/Sidebar.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import ModulePageContent from '@/components/ModulePageContent.astro';
import { getModule } from '@/lib/modules';
import { MODULE_PAGE_SIZE } from '@/lib/constants';
import { getDocsByModule } from '@/services';
// 学习进度：客户端记录与装饰（进度条、侧边栏已读标记）
import '@/lib/progress';

export async function getStaticPaths() {
  const { modules } = await import('@/lib/modules');
  return modules.map((m) => ({ params: { module: m.id } }));
}

const { module } = Astro.params as { module: string };
const meta = getModule(module || '');

if (!meta) {
  return Astro.redirect(`${import.meta.env.BASE_URL}404`);
}

// 通过 doc-service 获取当前模块的文档列表（已按 order 升序排序）
const sortedDocs = await getDocsByModule(module);

const breadcrumb = [{ label: '首页', href: `${import.meta.env.BASE_URL}` }, { label: meta.title }];
const totalPages = Math.ceil(sortedDocs.length / MODULE_PAGE_SIZE);
---

<Layout title={meta.title}>
  <SEO
    slot="head"
    title={meta.title}
    description={meta.description}
    canonical={`${Astro.site}${Astro.url.pathname}`}
  />
  {/* 分页关系提示：便于搜索引擎理解第 1 页与后续分页的关系 */}
  {totalPages > 1 && <link rel="next" href={`${Astro.site}${Astro.url.pathname}page/2/`} slot="head" />}
  <Sidebar slot="sidebar" moduleId={module} />

  <ModulePageContent module={module} meta={meta} page={1} docs={sortedDocs} />
</Layout>
