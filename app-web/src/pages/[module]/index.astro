---
import Layout from '@/components/Layout.astro';
import SEO from '@/components/SEO.astro';
import Sidebar from '@/components/Sidebar.astro';
import ModulePageContent from '@/components/ModulePageContent.astro';
import { getModule } from '@/lib/modules';
import { MODULE_PAGE_SIZE } from '@/lib/constants';
import { getDocsByModule } from '@/services';

export async function getStaticPaths() {
  const { modules } = await import('@/lib/modules');
  return modules.map((m) => ({ params: { module: m.id } }));
}

const { module } = Astro.params as { module: string };
const meta = getModule(module || '');

if (!meta) {
  return Astro.redirect(`${import.meta.env.BASE_URL}404`);
}

const sortedDocs = await getDocsByModule(module);

const totalPages = Math.ceil(sortedDocs.length / MODULE_PAGE_SIZE);
---

<Layout title={meta.title}>
  <SEO
    slot="head"
    title={meta.title}
    description={meta.description}
    canonical={new URL(Astro.url.pathname, Astro.site).href}
  />
  {}
  {totalPages > 1 && <link rel="next" href={new URL(`${Astro.url.pathname}page/2/`, Astro.site).href} slot="head" />}
  <Sidebar slot="sidebar" moduleId={module} />

  <ModulePageContent module={module} meta={meta} page={1} docs={sortedDocs} />
</Layout>
