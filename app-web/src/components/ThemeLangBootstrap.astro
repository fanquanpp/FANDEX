---
/**
 * 首屏防闪烁引导脚本：绘制前从 localStorage 恢复主题、语言与侧栏折叠态。
 * BaseLayout 与独立的 404 / 免责声明页共用，避免三处脚本各自漂移。
 * 所有读取都在 try/catch 内：localStorage 被禁用（隐私模式/安全设置）时
 * 抛出的异常不能中断脚本，否则主题与语言都会回退到默认值。
 */
---

<script is:inline>
  (function () {
    var theme = null;
    try {
      var raw = localStorage.getItem('fandex-theme');
      if (raw === 'dark' || raw === 'light') theme = raw;
    } catch (e) {
      /* 存储不可用时回退到系统偏好 */
    }
    if (!theme) {
      theme =
        window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light';
    }
    document.documentElement.setAttribute('data-theme', theme);
    document.documentElement.style.colorScheme = theme;
    var meta = document.querySelector('meta[name="theme-color"]');
    if (meta) {
      meta.setAttribute('content', theme === 'dark' ? '#0a0e14' : '#EBEFF3');
    }

    try {
      if (localStorage.getItem('fandex-sidebar-collapsed') === '1') {
        document.documentElement.classList.add('sidebar-collapsed');
      }
    } catch (e) {
      /* localStorage 不可用时静默降级 */
    }

    try {
      var savedLang = localStorage.getItem('fandex-lang');
      if (savedLang === 'en') {
        document.documentElement.setAttribute('data-lang', 'en');
        document.documentElement.setAttribute('lang', 'en');
      } else {
        document.documentElement.setAttribute('data-lang', 'zh');
      }
    } catch (e) {
      /* localStorage 不可用时保持 SSR 中文 */
    }
  })();
</script>
