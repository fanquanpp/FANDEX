---
interface Props {
  scrollContainer?: string;
  enabled?: boolean;
}

const {
  scrollContainer = '#app-main',
  enabled = true,
} = Astro.props;

const scrollConfig = JSON.stringify({ container: scrollContainer });
---

{
  enabled && (
    <div
      class="fndx-reading-progress"
      role="progressbar"
      aria-label="阅读进度"
      data-i18n-aria="readingProgress.ariaLabel"
      aria-valuenow={0}
      aria-valuemin={0}
      aria-valuemax={100}
      data-reading-progress-config={scrollConfig}
    >
      <div class="fndx-reading-progress__bar" id="fndx-reading-progress-bar" />
    </div>
  )
}

<script>

  let rafId: number | null = null;

  let prevScrollHandler: (() => void) | null = null;
  let prevScrollContainer: HTMLElement | null = null;

  // 站点滚动容器是 #app-main 而非 window，Astro ClientRouter 只恢复 window 滚动，
  // 后退/前进时需自行恢复文档阅读位置
  const SCROLL_KEY_PREFIX = 'fandex-doc-scroll:';
  let pendingPopRestore = false;

  function readScrollConfig(progressEl: HTMLElement): string {
    const raw = progressEl.getAttribute('data-reading-progress-config');
    if (!raw) return '#app-main';
    try {
      const parsed = JSON.parse(raw) as { container?: string };
      return parsed.container || '#app-main';
    } catch {
      return '#app-main';
    }
  }

  function saveScrollPosition(container: HTMLElement): void {
    try {
      sessionStorage.setItem(SCROLL_KEY_PREFIX + window.location.pathname, String(container.scrollTop));
    } catch {
      /* sessionStorage 不可用时静默降级 */
    }
  }

  function initReadingProgress(): void {
    if (prevScrollHandler && prevScrollContainer) {
      prevScrollContainer.removeEventListener('scroll', prevScrollHandler);
      window.removeEventListener('resize', prevScrollHandler);
    }
    if (rafId !== null) {
      cancelAnimationFrame(rafId);
      rafId = null;
    }

    const progressEl = document.querySelector<HTMLElement>('.fndx-reading-progress');
    if (!progressEl) return;

    const bar = progressEl.querySelector<HTMLElement>('.fndx-reading-progress__bar');
    if (!bar) return;

    const progressElNonNull: HTMLElement = progressEl;
    const barNonNull: HTMLElement = bar;

    const containerSelector = readScrollConfig(progressElNonNull);
    const scrollContainer =
      document.querySelector<HTMLElement>(containerSelector) || document.documentElement;

    function updateProgress(): void {
      const { scrollTop, scrollHeight, clientHeight } = scrollContainer;
      const maxScroll = scrollHeight - clientHeight;

      if (maxScroll <= 0) {
        barNonNull.style.width = '0%';
        progressElNonNull.setAttribute('aria-valuenow', '0');
        return;
      }

      const percent = Math.min(100, Math.max(0, (scrollTop / maxScroll) * 100));
      barNonNull.style.width = `${percent}%`;
      progressElNonNull.setAttribute('aria-valuenow', String(Math.round(percent)));
    }

    function onScroll(): void {
      if (rafId !== null) return;
      rafId = requestAnimationFrame(() => {
        updateProgress();
        rafId = null;
      });
    }

    updateProgress();

    scrollContainer.addEventListener('scroll', onScroll, { passive: true });

    window.addEventListener('resize', onScroll, { passive: true });

    prevScrollHandler = onScroll;
    prevScrollContainer = scrollContainer;
  }

  window.addEventListener('popstate', () => {
    pendingPopRestore = true;
  });

  // 离开当前文档前保存阅读位置（内部导航与刷新/关闭都覆盖）
  document.addEventListener('astro:before-swap', () => {
    const container = document.getElementById('app-main');
    if (container) saveScrollPosition(container);
  });
  window.addEventListener('pagehide', () => {
    if (!pendingPopRestore) {
      const container = document.getElementById('app-main');
      if (container) saveScrollPosition(container);
    }
  });

  document.addEventListener('astro:after-swap', () => {
    if (!pendingPopRestore) return;
    pendingPopRestore = false;
    const container = document.getElementById('app-main');
    if (!container) return;
    try {
      const raw = sessionStorage.getItem(SCROLL_KEY_PREFIX + window.location.pathname);
      if (raw) container.scrollTop = Number(raw);
    } catch {
      /* sessionStorage 不可用时静默降级 */
    }
  });

  initReadingProgress();
  document.addEventListener('astro:page-load', initReadingProgress);
</script>
