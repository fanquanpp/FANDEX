---
import { getFeatureEntries } from '@/lib/feature-entries';
const base = import.meta.env.BASE_URL;
const entries = getFeatureEntries(base);
const currentPath = decodeURI(Astro.url.pathname);
const isCurrent = (href: string): boolean => {
  const bare = href.replace(/\/$/, '');
  return currentPath === href || currentPath === bare;
};
---
<nav class="header-feature-links" aria-label="功能直达" data-i18n-aria="nav.featureLinksAria">
  {
    entries.map(entry => (
      <a
        href={entry.href}
        class:list={['header-feature-link', { 'is-current': isCurrent(entry.href) }]}
        aria-current={isCurrent(entry.href) ? 'page' : undefined}
        data-tooltip={entry.tooltip}
        data-i18n-tooltip={entry.tooltipKey}
        data-tooltip-pos="bottom"
        data-i18n={entry.nameKey}
      >
        {entry.name}
      </a>
    ))
  }
</nav>
