---
import { categoryColors, getPrimaryCategory } from '@/lib/modules'
import {
  getModule,
  getDocsByModule,
  docSlug,
  type DocEntry,
  type Module,
} from '@/services'

const { moduleId, currentSlug, sortedDocs } = Astro.props as {
  moduleId: string
  currentSlug?: string
  headings?: { depth: number; slug: string; text: string }[]
  sortedDocs?: DocEntry[]
}

const sorted = sortedDocs || await getDocsByModule(moduleId)
const meta = getModule(moduleId)
const base = import.meta.env.BASE_URL

function docHref(slug: string): string {
  return `${base}${moduleId}/${slug}/`
}

function moduleColor(m: Module | undefined): string {
  if (!m) return categoryColors.tools ?? ''
  return categoryColors[getPrimaryCategory(m)] ?? categoryColors.tools ?? ''
}

function moduleColorStyle(m: Module | undefined): string | undefined {
  const color = moduleColor(m)
  return color ? `--module-color:${color}` : undefined
}
---

<aside
  id="app-sidebar"
  class="fndx-sidebar"
  aria-label="侧边栏"
  data-i18n-aria="sidebar.asideAria"
  data-module={moduleId}
  style={moduleColorStyle(meta)}
>
  <button
    type="button"
    id="sidebar-close-btn"
    class="fndx-sidebar__close fndx-icon-btn"
    aria-label="关闭侧边栏"
    data-i18n-aria="sidebar.close"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <line x1="18" y1="6" x2="6" y2="18" />
      <line x1="6" y1="6" x2="18" y2="18" />
    </svg>
  </button>

  <div class="fndx-sidebar__top">
    <button
      type="button"
      id="sidebar-collapse-btn"
      class="fndx-sidebar__collapse fndx-icon-btn"
      aria-label="折叠侧边栏"
      data-i18n-aria="sidebar.collapse"
      data-tooltip="折叠侧边栏"
      data-i18n-tooltip="sidebar.collapse"
      data-tooltip-pos="right"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="15 18 9 12 15 6" />
      </svg>
    </button>

    <div class="fndx-sidebar__view-tabs" role="tablist" aria-label="侧边栏视图切换" data-i18n-aria="sidebar.viewTabsAria">
      <button
        type="button"
        class="fndx-sidebar__view-tab is-active"
        data-view="chapters"
        role="tab"
        aria-selected="true"
        data-i18n="sidebar.chapters"
      >
        章节
      </button>
      <button
        type="button"
        class="fndx-sidebar__view-tab"
        data-view="modules"
        role="tab"
        aria-selected="false"
        data-i18n="sidebar.all"
      >
        全部
      </button>
    </div>

    <a
      href={base}
      class="fndx-sidebar__back fndx-icon-btn"
      aria-label="返回首页"
      data-i18n-aria="sidebar.backHome"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
        <polyline points="9 22 9 12 15 12 15 22" />
      </svg>
    </a>
  </div>

  <nav
    id="sidebar-chapters-panel"
    class="fndx-sidebar__panel"
    aria-label="章节导航"
    data-i18n-aria="sidebar.chaptersAria"
  >
    <div
      id="sidebar-scroll"
      class="fndx-sidebar__scroll"
    >
      <h2 class="fndx-sidebar__title fndx-sidebar__title--module">
        {meta?.title || moduleId}
      </h2>
      <ul
        id="sidebar-panel-chapters"
        class="fndx-sidebar__list"
      >
        {
          sorted.map((doc, index) => {
            const slug = docSlug(doc.id)
            const isActive = currentSlug === slug
            return (
              <li>
                <a
                  href={docHref(slug)}
                  class={`fndx-sidebar__link${isActive ? ' is-active' : ''}`}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {}
                  <span class="fndx-sidebar__link-index" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span class="fndx-sidebar__link-text">{doc.data.title}</span>
                </a>
              </li>
            )
          })
        }
      </ul>
    </div>
  </nav>

  <nav
    id="sidebar-all-modules-panel"
    class="fndx-sidebar__panel is-hidden"
    aria-label="全部模块"
    data-i18n-aria="sidebar.allModulesAria"
  >
    <div
      id="sidebar-all-modules-scroll"
      class="fndx-sidebar__scroll"
      data-module-id={moduleId}
      data-current-slug={currentSlug ?? ''}
    >
    </div>
  </nav>
</aside>

<button
  type="button"
  id="sidebar-expand-fab"
  class="fndx-sidebar__expand-fab fndx-icon-btn fndx-icon-btn--labeled"
  aria-label="展开侧边栏"
  data-i18n-aria="sidebar.expandAria"
  data-tooltip="展开侧边栏"
  data-i18n-tooltip="sidebar.expandAria"
  data-tooltip-pos="right"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <polyline points="9 18 15 12 9 6" />
  </svg>
  <span class="fndx-sidebar__expand-fab-text" data-i18n="sidebar.expand">展开</span>
</button>

<script>
  import '@/lib/sidebar-interactions';
  import '@/lib/sidebar-modules-mount';
</script>
