---
import { docSlug, type DocEntry } from '@/services';
import '@/styles/components/doc-nav.css';

const { prev, next } = Astro.props as { prev: DocEntry | null; next: DocEntry | null };
---

<nav class="doc-nav" class:list={{ 'single-btn': !prev || !next }}>
  {
    prev ? (
      <a
        href={`${import.meta.env.BASE_URL}${prev.data.module}/${docSlug(prev.id)}/`}
        class="nav-btn nav-btn--prev fndx-icon-btn fndx-icon-btn--labeled"
        rel="prev"
      >
        <svg
          width="12"
          height="12"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <polyline points="18 6 6 12 18 18" />
        </svg>
        <div>
          <span class="nav-label" data-i18n="docNav.prev">上一篇</span>
          <span class="nav-title">{prev.data.title}</span>
        </div>
      </a>
    ) : (
      <div />
    )
  }
  {
    next ? (
      <a
        href={`${import.meta.env.BASE_URL}${next.data.module}/${docSlug(next.id)}/`}
        class="nav-btn nav-btn--next fndx-icon-btn fndx-icon-btn--labeled"
        rel="next"
        style="text-align:right"
      >
        <div>
          <span class="nav-label" data-i18n="docNav.next">下一篇</span>
          <span class="nav-title">{next.data.title}</span>
        </div>
        <svg
          width="12"
          height="12"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <polyline points="6 6 18 12 6 18" />
        </svg>
      </a>
    ) : (
      <div />
    )
  }
</nav>
