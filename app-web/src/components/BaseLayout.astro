---
import '@/styles/site.css';
import { SITE, IS_DESKTOP_BUILD } from '@/lib/constants';
import { MAIN_CSP, DESKTOP_CSP } from '@/lib/csp';
import { ClientRouter } from 'astro:transitions';
import ThemeLangBootstrap from '@/components/ThemeLangBootstrap.astro';
import WebVitalsTracker from '@/islands/WebVitalsTracker';
import faviconMeta from '@fandex/shared-assets/icons/favicon.svg';
import appleTouchIconMeta from '@fandex/shared-assets/icons/apple-touch-icon.png';
const faviconUrl: string = (faviconMeta as unknown as { src: string }).src;
const appleTouchIconUrl: string = (appleTouchIconMeta as unknown as { src: string }).src;

const base = import.meta.env.BASE_URL;
const csp = IS_DESKTOP_BUILD ? DESKTOP_CSP : MAIN_CSP;
---

<html lang={SITE.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#EBEFF3" id="meta-theme-color" />
    <ClientRouter />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <link rel="apple-touch-icon" href={appleTouchIconUrl} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.title} 订阅`}
      href={`${base}rss.xml`}
    />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    {!IS_DESKTOP_BUILD && (
      <>
        <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
        <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
      </>
    )}

    <link
      rel="stylesheet"
      href={`${base}fonts/fonts.css`}
      media="print"
      onload="this.media='all'"
    />
    <link
      rel="preload"
      href={`${base}fonts/ibm-plex-sans-400.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={`${base}fonts/chakra-petch-600.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={`${base}fonts/jetbrains-mono-400.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <ThemeLangBootstrap />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <WebVitalsTracker client:idle />
  </body>
</html>

<script>
  import { initThemePersistence } from '@/lib/theme';
  initThemePersistence();
</script>

<script>
  import '@/lib/i18n-dom';
</script>

<script>
  import '@/lib/search-palette';
</script>

<script>
  import '@/lib/pwa-install';
</script>

<script>
  import '@/lib/sw-update';
</script>
