---
import '@/styles/site.css';
import { SITE, IS_DESKTOP_BUILD } from '@/lib/constants';
import { MAIN_CSP, DESKTOP_CSP } from '@/lib/csp';
import { ClientRouter } from 'astro:transitions';
import ThemeLangBootstrap from '@/components/ThemeLangBootstrap.astro';
import WebVitalsTracker from '@/islands/WebVitalsTracker';
import faviconMeta from '@fandex/shared-assets/icons/favicon.svg';
import appleTouchIconMeta from '@fandex/shared-assets/icons/apple-touch-icon.png';
const faviconUrl: string = (faviconMeta as unknown as { src: string }).src;
const appleTouchIconUrl: string = (appleTouchIconMeta as unknown as { src: string }).src;

const base = import.meta.env.BASE_URL;
const csp = IS_DESKTOP_BUILD ? DESKTOP_CSP : MAIN_CSP;
---

<html lang={SITE.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#EBEFF3" id="meta-theme-color" />
    <ClientRouter />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <link rel="apple-touch-icon" href={appleTouchIconUrl} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.title} 订阅`}
      href={`${base}rss.xml`}
    />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <link
      rel="stylesheet"
      href={`${base}fonts/fonts.css`}
      media="print"
      onload="this.media='all'"
    />
    <link
      rel="preload"
      href={`${base}fonts/ibm-plex-sans-400.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={`${base}fonts/chakra-petch-600.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={`${base}fonts/jetbrains-mono-400.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <ThemeLangBootstrap />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#app-main" data-i18n="a11y.skipToContent">跳转到主要内容</a>
    <slot />
    <WebVitalsTracker client:idle />
  </body>
</html>

<style is:global>
  /* 键盘 / 读屏用户跳过头部与侧栏直达正文；默认移出屏幕，聚焦时显现 */
  .skip-link {
    position: fixed;
    left: 0.75rem;
    top: 0.75rem;
    z-index: 10000;
    transform: translateY(-200%);
    padding: 0.5rem 1rem;
    background: var(--color-accent-base, #14716a);
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: var(--radius-md, 4px);
    box-shadow: var(--shadow-lg, 0 4px 12px rgb(0 0 0 / 0.2));
    transition: transform 0.15s ease;
  }

  .skip-link:focus-visible,
  .skip-link:focus {
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .skip-link {
      transition: none;
    }
  }
</style>

<script>
  import { initThemePersistence } from '@/lib/theme';
  initThemePersistence();
</script>

<script>
  import '@/lib/i18n-dom';
</script>

<script>
  import '@/lib/search-palette';
</script>

<script>
  import '@/lib/pwa-install';
</script>

<script>
  import '@/lib/sw-update';
</script>
