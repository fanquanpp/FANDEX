---
import '@/styles/site.css';
import { SITE, IS_DESKTOP_BUILD } from '@/lib/constants';
import { MAIN_CSP, DESKTOP_CSP } from '@/lib/csp';
import { ClientRouter } from 'astro:transitions';
import WebVitalsTracker from '@/islands/WebVitalsTracker';
import faviconMeta from '@fandex/shared-assets/icons/favicon.svg';
import appleTouchIconMeta from '@fandex/shared-assets/icons/apple-touch-icon.png';
const faviconUrl: string = (faviconMeta as unknown as { src: string }).src;
const appleTouchIconUrl: string = (appleTouchIconMeta as unknown as { src: string }).src;

const base = import.meta.env.BASE_URL;
const csp = IS_DESKTOP_BUILD ? DESKTOP_CSP : MAIN_CSP;
---

<html lang={SITE.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#EBEFF3" id="meta-theme-color" />
    <ClientRouter />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <link rel="apple-touch-icon" href={appleTouchIconUrl} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.title} 订阅`}
      href={`${base}rss.xml`}
    />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    {
}
    {!IS_DESKTOP_BUILD && (
      <>
        <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
        <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
      </>
    )}

    <link
      rel="stylesheet"
      href={`${base}fonts/fonts.css`}
      media="print"
      onload="this.media='all'"
    />
    <link
      rel="preload"
      href={`${base}fonts/ibm-plex-sans-400.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={`${base}fonts/chakra-petch-600.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={`${base}fonts/jetbrains-mono-400.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      (function () {
        var raw = localStorage.getItem('fandex-theme');
        var theme;
        if (raw === 'dark' || raw === 'light') {
          theme = raw;
        } else {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.style.colorScheme = theme;
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) {
          meta.setAttribute('content', theme === 'dark' ? '#0a0e14' : '#EBEFF3');
        }

        try {
          if (localStorage.getItem('fandex-sidebar-collapsed') === '1') {
            document.documentElement.classList.add('sidebar-collapsed');
          }
        } catch (e) {
          /* localStorage 不可用时静默降级（如隐私模式） */
        }

        try {
          var savedLang = localStorage.getItem('fandex-lang');
          if (savedLang === 'en') {
            document.documentElement.setAttribute('data-lang', 'en');
            document.documentElement.setAttribute('lang', 'en');
          } else {
            document.documentElement.setAttribute('data-lang', 'zh');
          }
        } catch (e) {
          /* localStorage 不可用时静默降级：保持 SSR 中文 */
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />
    <WebVitalsTracker client:idle />
  </body>
</html>

<script>
  import { initThemePersistence } from '@/lib/theme';
  initThemePersistence();
</script>

<script>
  import '@/lib/i18n-dom';
</script>

<script>
  import '@/lib/search-palette';
</script>

<script>
  import '@/lib/pwa-install';
</script>

<script>
  import '@/lib/sw-update';
</script>
