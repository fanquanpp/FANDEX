---
import '@/styles/site.css';
import { SITE, IS_DESKTOP_BUILD } from '@/lib/constants';
import { MAIN_CSP, DESKTOP_CSP } from '@/lib/csp';
import { ClientRouter } from 'astro:transitions';
import SceneBackdrop from '@/components/SceneBackdrop.astro';
import ThemeLangBootstrap from '@/components/ThemeLangBootstrap.astro';
import faviconMeta from '@fandex/shared-assets/icons/favicon.svg';
import appleTouchIconMeta from '@fandex/shared-assets/icons/apple-touch-icon.png';
const faviconUrl: string = (faviconMeta as unknown as { src: string }).src;
const appleTouchIconUrl: string = (appleTouchIconMeta as unknown as { src: string }).src;

const base = import.meta.env.BASE_URL;
const csp = IS_DESKTOP_BUILD ? DESKTOP_CSP : MAIN_CSP;

interface Props {
  /** 页面标题（转发语义，实际 title 由各页 SEO/meta 负责） */
  title?: string;
  /** fx 律动装饰变奏（fx/decor-config.ts），在唯一背景层内渲染 */
  fxDecor?: import('@/fx/decor-config').GeoBgVariant;
  /** fx 页面轨道号覆盖（如算法页 04），缺省用变体默认 */
  fxNum?: string;
}

const { fxDecor, fxNum } = Astro.props;
---

<html lang={SITE.lang}>
  <head>
    <meta charset="UTF-8" />
    <!-- 级联层顺序声明：必须先于任何分块样式表出现。Astro 会把页面私有 chunk
        （如文档页的 KaTeX + 页面样式）排在全局样式表之前，@layer 的优先级
        按"首次出现"确立，若不在此处先声明，base 层会排在 components 之后，
        其 * { margin: 0; padding: 0 } 会压掉全站 components 层的间距。 -->
    <style is:inline>
      @layer theme, reset, tokens, base, components, pages, islands, utilities;
    </style>
    <!-- fx 就绪标记：先于首帧写入，隐藏态样式只在 [data-fx-ready] 下生效，
        无 JS（爬虫 / 禁脚本）时 reveal/split 等内容始终完整可见 -->
    <script is:inline>
      document.documentElement.dataset.fxReady = '1';
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#EBEFF3" id="meta-theme-color" />
    <ClientRouter />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <link rel="apple-touch-icon" href={appleTouchIconUrl} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.title} 订阅`}
      href={`${base}rss.xml`}
    />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <link
      rel="stylesheet"
      href={`${base}fonts/fonts.css`}
      media="print"
      onload="this.media='all'"
    />
    <link
      rel="preload"
      href={`${base}fonts/ibm-plex-sans-400.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={`${base}fonts/chakra-petch-600.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={`${base}fonts/jetbrains-mono-400.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <ThemeLangBootstrap />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#app-main" data-i18n="a11y.skipToContent">跳转到主要内容</a>
    <SceneBackdrop decor={fxDecor} num={fxNum} />
    <slot />
  </body>
</html>

<style is:global>
  /* 键盘 / 读屏用户跳过头部与侧栏直达正文；默认移出屏幕，聚焦时显现 */
  .skip-link {
    position: fixed;
    left: 0.75rem;
    top: 0.75rem;
    /* 10000 为全站唯一特例（规格 4.2）：无障碍直达入口必须浮于一切
       非 top-layer 元素之上，不参与 --z-* 常规刻度 */
    z-index: 10000;
    transform: translateY(-200%);
    padding: 0.5rem 1rem;
    background: var(--color-accent-base, #14716a);
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: var(--radius-control);
    box-shadow: var(--shadow-lg, 0 4px 12px rgb(0 0 0 / 0.2));
    transition: transform 0.15s ease;
  }

  .skip-link:focus-visible,
  .skip-link:focus {
    transform: translateY(0);
  }
  /* reduced-motion 由 global.css 全局兜底（transition-duration 0.01ms），
     此处不再重复 @media（规格 C6） */
</style>

<script>
  import { initThemePersistence } from '@/lib/theme';
  initThemePersistence();
</script>

<script>
  // WebVitalsTracker vanilla 模块（S4 去 React 化）：纯观测上报，无 DOM 标记。
  // 整页会话注册一次，监听跨 ClientRouter 换页持续有效，无需 before-swap 清理。
  import { initWebVitalsTracking } from '@/lib/web-vitals';
  initWebVitalsTracking();
</script>

<script>
  import '@/lib/i18n-dom';
</script>

<script>
  import '@/lib/search-palette';
</script>

<script>
  import '@/lib/pwa-install';
</script>

<script>
  import '@/lib/sw-update';
</script>

<script>
  // fx 动效特效体系单一入口：注册表 + 生命周期 + 全部画布层与 DOM 特效
  import '@/fx';
</script>
