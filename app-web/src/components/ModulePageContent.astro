---
/**
 * 模块页共享内容组件（页头 + 文档列表 + 分页控件）
 * 由 [module]/index.astro（第 1 页）与 [module]/page/[page].astro（第 2 页起）复用，
 * 保证分页前后页头、列表与样式完全一致。
 *
 * 分页说明：
 * - 每页 PAGE_SIZE 篇，超大模块（如 python/java 300+ 篇）列表页从 ~180KB 降至 ~40KB/页，
 *   同时减少 viewport 预取在列表页的一次性带宽压力；
 * - 第 2 页起路由为 {module}/page/{n}/，不使用 Astro paginate()：
 *   paginate 的 [...page] rest 参数会与文档详情路由 [module]/[slug] 冲突，
 *   且 page/1/ 会与 index.astro 产生重复页面，故手动分页并跳过第 1 页。
 */
import { categoryColors, getPrimaryCategory } from '@/lib/modules';
import { MODULE_PAGE_SIZE } from '@/lib/constants';
// docSlug 由 modules.ts 唯一定义，通过 services 桶文件统一导出
import { docSlug, type DocEntry, type Module } from '@/services';

interface Props {
  /** 模块 ID */
  module: string;
  /** 模块元数据（getModule 结果，调用方已校验存在） */
  meta: Module;
  /** 当前页码（从 1 开始） */
  page: number;
  /** 该模块全量文档（已按 order 升序，由调用方通过 doc-service 获取） */
  docs: DocEntry[];
}

const { module, meta, page, docs } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const moduleColor = categoryColors[getPrimaryCategory(meta)];
const moduleColorStyle = moduleColor ? `--module-color:${moduleColor}` : undefined;

const totalPages = Math.max(1, Math.ceil(docs.length / MODULE_PAGE_SIZE));
const pageDocs = docs.slice((page - 1) * MODULE_PAGE_SIZE, page * MODULE_PAGE_SIZE);

/** 分页链接：第 1 页固定为模块首页，第 n 页为 page/n/ */
function pageHref(n: number): string {
  return n <= 1 ? `${baseUrl}${module}/` : `${baseUrl}${module}/page/${n}/`;
}
---

<div class="module-page" style={moduleColorStyle}>
  <div class="module-header fndx-scroll-reveal">
    <div class="header-body">
      <h1 class="header-title">{meta.title}</h1>
      <p class="header-desc">{meta.description}</p>
    </div>
    <div class="header-docs">
      {/* 文档总数 chip 与学习进度指示（lib/progress.ts 客户端填充） */}
      <span class="doc-progress" data-progress-module data-module={module} data-total={docs.length} aria-label="本模块学习进度"></span>
      <span class="doc-chip doc-chip--count" aria-label={`本模块共 ${docs.length} 篇文档`}>
        <span class="doc-chip-icon">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <polyline points="14 2 14 8 20 8" />
            <line x1="16" y1="13" x2="8" y2="13" />
            <line x1="16" y1="17" x2="8" y2="17" />
          </svg>
        </span>
        <span class="doc-chip-label">共 {docs.length} 篇</span>
      </span>
      {
        meta.officialDocs && meta.officialDocs.length > 0 && (
          meta.officialDocs.map((doc) => (
            <a
              href={doc.url}
              class={`doc-chip doc-chip--${doc.type}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${doc.label}（在新标签页打开）`}
            >
              <span class="doc-chip-icon">
                {doc.type === 'api' ? (
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="16 18 22 12 16 6" />
                    <polyline points="8 6 2 12 8 18" />
                  </svg>
                ) : doc.type === 'spec' ? (
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                  </svg>
                ) : (
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                  </svg>
                )}
              </span>
              <span class="doc-chip-label">{doc.label}</span>
              <svg class="doc-chip-external" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                <polyline points="15 3 21 3 21 9" />
                <line x1="10" y1="14" x2="21" y2="3" />
              </svg>
            </a>
          ))
        )
      }
    </div>
  </div>

  <ul class="doc-list fndx-scroll-reveal-fade">
    {
      pageDocs.map((doc, idx) => (
        <li class="doc-list-item">
          <a
            href={`${baseUrl}${module}/${docSlug(doc.id)}/`}
            class="doc-list-link"
          >
            {/* SVG border 描边动画：hover 时 rect 从隐藏到显示，实现描边效果
                preserveAspectRatio="none" 让 rect 拉伸适配链接尺寸 */}
            <svg class="doc-list-border" aria-hidden="true" preserveAspectRatio="none">
              <rect x="1" y="1" width="calc(100% - 2px)" height="calc(100% - 2px)"></rect>
            </svg>
            <span
              class="doc-list-icon"
              style={`background:${moduleColor}`}
            >
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                <polyline points="14 2 14 8 20 8" />
                <line x1="16" y1="13" x2="8" y2="13" />
                <line x1="16" y1="17" x2="8" y2="17" />
              </svg>
            </span>
            <span class="doc-list-seq">{String((page - 1) * MODULE_PAGE_SIZE + idx + 1).padStart(3, '0')}</span>
            <span class={`doc-list-difficulty diff-${doc.data.difficulty || 'intermediate'}`}>
              {doc.data.difficulty === 'beginner'
                ? '入门'
                : doc.data.difficulty === 'advanced'
                  ? '进阶'
                  : '中级'}
            </span>
            <span class="doc-list-title">{doc.data.title}</span>
            {doc.data.description && <span class="doc-list-desc">{doc.data.description}</span>}
          </a>
        </li>
      ))
    }
  </ul>

  {
    totalPages > 1 && (
      <nav class="pager" aria-label="文档列表分页">
        {page > 1 ? (
          <a class="pager-link" href={pageHref(page - 1)} rel="prev">
            上一页
          </a>
        ) : (
          <span class="pager-link pager-link--disabled" aria-disabled="true">
            上一页
          </span>
        )}
        <span class="pager-status">
          第 {page} / {totalPages} 页
        </span>
        {page < totalPages ? (
          <a class="pager-link" href={pageHref(page + 1)} rel="next">
            下一页
          </a>
        ) : (
          <span class="pager-link pager-link--disabled" aria-disabled="true">
            下一页
          </span>
        )}
      </nav>
    )
  }
</div>

<style>
  /* 模块文档列表页样式 — 归入 @layer pages，避免未分层 CSS 覆盖 ark 令牌
   * 紧凑化重构：减小图标尺寸、优化间距、添加 max-width 防止大屏越界
   * 宽度自适应桌面端 94vw，移除 48rem 限制 */
  @layer pages {
  .module-page {
    padding: var(--spacing-sm) var(--spacing-md);
    width: 94vw;
    max-width: 100%;
    margin-inline: auto;
  }

  .module-header {
    margin-bottom: var(--spacing-md);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-light);
    border-radius: var(--fandex-radius-md, 4px);
  }

  .header-body {
    padding: var(--spacing-sm) var(--spacing-md);
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    flex-wrap: wrap;
  }

  .header-title {
    font-family: var(--font-display);
    font-size: 1.05em;
    font-weight: 600;
    margin: 0;
    letter-spacing: 0.01em;
  }

  .header-desc {
    font-size: 0.78em;
    color: var(--color-text-secondary);
    margin: 0;
    flex-basis: 100%;
  }

  /* 官方文档链接区：紧贴 header-body 下方，顶部分隔线区分层级
   * 仅在模块配置了 officialDocs 时渲染，几何科技风格、紧凑无装饰 */
  .header-docs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
    padding: var(--spacing-xs) var(--spacing-md);
    border-top: 1px solid var(--color-border-light);
  }

  /* 文档链接 chip：透明底 + 细边框，悬停使用模块分类色
   * 直角设计（border-radius: 2px）保持几何科技风格一致性 */
  .doc-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 8px;
    border: 1px solid var(--color-border-light);
    border-radius: 2px;
    font-family: var(--font-display);
    font-size: 0.68em;
    color: var(--color-text-secondary);
    text-decoration: none;
    background: transparent;
    transition: color var(--motion-duration-instant) var(--motion-easing-out),
                border-color var(--motion-duration-instant) var(--motion-easing-out),
                background-color var(--motion-duration-instant) var(--motion-easing-out);
  }

  .doc-chip:hover {
    color: var(--module-color, var(--color-accent-base));
    border-color: color-mix(in oklch, var(--module-color, var(--color-accent-base)) 50%, transparent);
    background-color: color-mix(in oklch, var(--module-color, var(--color-accent-base)) 6%, transparent);
  }

  /* chip 前置图标：根据 type 区分（docs=书 / api=代码 / spec=文件） */
  .doc-chip-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--module-color, var(--color-accent-base));
    opacity: 0.85;
  }

  /* chip 标签文本 */
  .doc-chip-label {
    letter-spacing: 0.01em;
  }

  /* 外链图标：默认弱化，悬停时显眼 */
  .doc-chip-external {
    opacity: 0.5;
    transition: opacity var(--motion-duration-instant) var(--motion-easing-out);
  }

  .doc-chip:hover .doc-chip-external {
    opacity: 1;
  }

  /* API 类型 chip：使用代码符号图标色调微调 */
  .doc-chip--api .doc-chip-icon {
    opacity: 1;
  }

  /* spec 类型 chip：规范文档，图标饱和度略高 */
  .doc-chip--spec .doc-chip-icon {
    opacity: 1;
  }

  .doc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border: 1px solid var(--color-border-light);
  }

  .doc-list-item {
    border-bottom: 1px solid var(--color-border-light);
  }

  .doc-list-item:last-child {
    border-bottom: none;
  }

  /* 文档链接：flex-wrap 允许标题与描述分行显示，增高卡片以容纳多行内容
   * 布局：第一行 = 图标 + 序号 + 难度 + 标题；第二行 = 描述（flex-basis: 100% 强制换行）
   * 左侧竖线装饰：移除 border-radius 圆角，改为几何直角线条
   * SVG border 描边动画：相对定位 + .doc-list-border 绝对定位填满链接 */
  .doc-list-link {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-xs) var(--spacing-sm);
    padding: var(--spacing-xs) var(--spacing-sm);
    border-radius: 0;
    color: var(--color-text);
    text-decoration: none;
    border-left: 2px solid transparent;
    position: relative;
    transition: background-color var(--motion-duration-instant) var(--motion-easing-out),
                color var(--motion-duration-instant) var(--motion-easing-out),
                border-color var(--motion-duration-instant) var(--motion-easing-out);
  }

  /* 悬停：统一使用 --module-color 驱动背景与边框色（与 sidebar__link / toc__link 一致） */
  .doc-list-link:hover {
    background-color: color-mix(in oklch, var(--module-color, var(--color-accent-base)) 8%, var(--color-bg-hover));
    border-left-color: color-mix(in oklch, var(--module-color, var(--color-accent-base)) 60%, transparent);
  }

  /* SVG border 描边动画（替代已删除的脉冲闪光特效）
   * rect 通过 stroke-dasharray + stroke-dashoffset 实现描边动画：
   * 默认 offset:1000 完全隐藏（pathLength 等效），hover 时 offset:0 完全显示 */
  .doc-list-border {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
  }

  .doc-list-border rect {
    fill: none;
    stroke: var(--module-color, var(--color-accent-base));
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
    transition: stroke-dashoffset 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .doc-list-link:hover .doc-list-border rect {
    stroke-dashoffset: 0;
  }

  /* 尊重用户减少动效偏好：禁用描边动画，直接显示边框 */
  @media (prefers-reduced-motion: reduce) {
    .doc-list-border rect {
      stroke-dashoffset: 0;
      transition: none;
    }
  }

  /* 文档图标：紧凑化 24px，使用模块分类色而非青色 */
  .doc-list-icon {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-radius: 3px;
    color: var(--color-text-inverse, #fff);
  }

  .doc-list-icon svg {
    width: 12px;
    height: 12px;
  }

  .doc-list-seq {
    font-family: var(--font-display);
    font-size: 0.68em;
    color: var(--color-text-tertiary);
    flex-shrink: 0;
    min-width: 1.8em;
  }

  /* 标题：允许完整显示，超长时换行而非截断 */
  .doc-list-title {
    font-family: var(--font-display);
    font-size: 0.82em;
    font-weight: 500;
    flex: 1 1 auto;
    min-width: 0;
    word-break: break-word;
    line-height: 1.4;
  }

  .doc-list-difficulty {
    font-size: 0.65em;
    padding: 1px 6px;
    border-radius: 2px;
    flex-shrink: 0;
    font-weight: 500;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .diff-beginner {
    background: color-mix(in srgb, var(--color-success) 15%, var(--color-bg));
    color: var(--color-success);
  }

  .diff-intermediate {
    background: color-mix(in srgb, var(--color-warning) 15%, var(--color-bg));
    color: var(--color-warning);
  }

  /* 进阶难度标识：加强背景色强调（原 --color-danger 变量语义令牌为 --color-error） */
  .diff-advanced {
    background: color-mix(in srgb, var(--color-error) 28%, var(--color-bg));
    color: var(--color-error);
    font-weight: 600;
  }

  /* 描述：独占一行显示 —— flex-basis:100% 强制换行到新行 */
  .doc-list-desc {
    flex-basis: 100%;
    padding-left: calc(24px + var(--spacing-sm));
    font-size: 0.72em;
    color: var(--color-text-tertiary);
    line-height: 1.5;
    word-break: break-word;
  }

  /* 分页控件：直角几何风格，与列表边框语言一致 */
  .pager {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
    margin-top: var(--spacing-md);
  }

  .pager-link {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    border: 1px solid var(--color-border-light);
    border-radius: 2px;
    font-family: var(--font-display);
    font-size: 0.75em;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--motion-duration-instant) var(--motion-easing-out),
                border-color var(--motion-duration-instant) var(--motion-easing-out);
  }

  a.pager-link:hover {
    color: var(--module-color, var(--color-accent-base));
    border-color: color-mix(in oklch, var(--module-color, var(--color-accent-base)) 50%, transparent);
  }

  .pager-link--disabled {
    opacity: 0.4;
    cursor: default;
  }

  .pager-status {
    font-family: var(--font-display);
    font-size: 0.72em;
    color: var(--color-text-tertiary);
    letter-spacing: 0.02em;
  }
  } /* end @layer pages */
</style>
