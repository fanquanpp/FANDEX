---
import { categoryColors, getPrimaryCategory } from '@/lib/modules';
import { MODULE_PAGE_SIZE } from '@/lib/constants';
import { docSlug, type DocEntry, type Module } from '@/services';

interface Props {
  module: string;
  meta: Module;
  page: number;
  docs: DocEntry[];
}

const { module, meta, page, docs } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const moduleColor = categoryColors[getPrimaryCategory(meta)];
const moduleColorStyle = moduleColor ? `--module-color:${moduleColor}` : undefined;

const totalPages = Math.max(1, Math.ceil(docs.length / MODULE_PAGE_SIZE));
const pageDocs = docs.slice((page - 1) * MODULE_PAGE_SIZE, page * MODULE_PAGE_SIZE);

function pageHref(n: number): string {
  return n <= 1 ? `${baseUrl}${module}/` : `${baseUrl}${module}/page/${n}/`;
}
---

<div class="module-page" style={moduleColorStyle}>
  <div class="module-header fndx-scroll-reveal">
    <div class="header-body">
      <h1 class="header-title">{meta.title}</h1>
      <p class="header-desc">{meta.description}</p>
    </div>
    <div class="header-docs">
      {}
      <span
        class="doc-chip doc-chip--count"
        aria-label={`本模块共 ${docs.length} 篇文档`}
        data-i18n-aria="modulePage.docCountAria"
        data-i18n-params={JSON.stringify({ n: docs.length })}
      >
        <span class="doc-chip-icon">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <polyline points="14 2 14 8 20 8" />
            <line x1="16" y1="13" x2="8" y2="13" />
            <line x1="16" y1="17" x2="8" y2="17" />
          </svg>
        </span>
        <span
          class="doc-chip-label"
          data-i18n="modulePage.docCount"
          data-i18n-params={JSON.stringify({ n: docs.length })}
        >
          共 {docs.length} 篇
        </span>
      </span>
      {
        meta.officialDocs && meta.officialDocs.length > 0 && (
          meta.officialDocs.map((doc) => (
            <a
              href={doc.url}
              class={`doc-chip doc-chip--${doc.type}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${doc.label}（在新标签页打开）`}
              data-i18n-aria="modulePage.openExternal"
              data-i18n-params={JSON.stringify({ label: doc.label })}
            >
              <span class="doc-chip-icon">
                {doc.type === 'api' ? (
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="16 18 22 12 16 6" />
                    <polyline points="8 6 2 12 8 18" />
                  </svg>
                ) : doc.type === 'spec' ? (
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                  </svg>
                ) : (
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                  </svg>
                )}
              </span>
              <span class="doc-chip-label">{doc.label}</span>
              <svg class="doc-chip-external" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                <polyline points="15 3 21 3 21 9" />
                <line x1="10" y1="14" x2="21" y2="3" />
              </svg>
            </a>
          ))
        )
      }
    </div>
  </div>

  <ul class="doc-list fndx-scroll-reveal-fade">
    {
      pageDocs.map((doc, idx) => (
        <li class="doc-list-item">
          <a
            href={`${baseUrl}${module}/${docSlug(doc.id)}/`}
            class="doc-list-link"
          >
            {
}
            <svg class="doc-list-border" aria-hidden="true" preserveAspectRatio="none">
              <rect x="1" y="1" width="calc(100% - 2px)" height="calc(100% - 2px)"></rect>
            </svg>
            <span
              class="doc-list-icon"
              style={`background:${moduleColor}`}
            >
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                <polyline points="14 2 14 8 20 8" />
                <line x1="16" y1="13" x2="8" y2="13" />
                <line x1="16" y1="17" x2="8" y2="17" />
              </svg>
            </span>
            <span class="doc-list-seq">{String((page - 1) * MODULE_PAGE_SIZE + idx + 1).padStart(3, '0')}</span>
            <span class={`doc-list-difficulty diff-${doc.data.difficulty || 'intermediate'}`}>
              {
                <span
                  data-i18n={`modulePage.difficulty.${doc.data.difficulty || 'intermediate'}`}
                >
                  {doc.data.difficulty === 'beginner'
                    ? '入门'
                    : doc.data.difficulty === 'advanced'
                      ? '进阶'
                      : '中级'}
                </span>
              }
            </span>
            <span class="doc-list-title">{doc.data.title}</span>
            {doc.data.description && <span class="doc-list-desc">{doc.data.description}</span>}
          </a>
        </li>
      ))
    }
  </ul>

  {
    totalPages > 1 && (
      <nav class="pager" aria-label="文档列表分页" data-i18n-aria="modulePage.pagerAria">
        {page > 1 ? (
          <a class="pager-link" href={pageHref(page - 1)} rel="prev" data-i18n="modulePage.prev">
            上一页
          </a>
        ) : (
          <span class="pager-link pager-link--disabled" aria-disabled="true" data-i18n="modulePage.prev">
            上一页
          </span>
        )}
        <span
          class="pager-status"
          data-i18n="modulePage.status"
          data-i18n-params={JSON.stringify({ p: page, t: totalPages })}
        >
          第 {page} / {totalPages} 页
        </span>
        {page < totalPages ? (
          <a class="pager-link" href={pageHref(page + 1)} rel="next" data-i18n="modulePage.next">
            下一页
          </a>
        ) : (
          <span class="pager-link pager-link--disabled" aria-disabled="true" data-i18n="modulePage.next">
            下一页
          </span>
        )}
      </nav>
    )
  }
</div>

<style>
  @layer pages {
  .module-page {
    padding: var(--space-2) var(--space-4);
    width: 94vw;
    max-width: 100%;
    margin-inline: auto;
  }

  .module-header {
    margin-bottom: var(--space-4);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md, 4px);
  }

  .header-body {
    padding: var(--space-2) var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-1);
    flex-wrap: wrap;
  }

  .header-title {
    font-family: var(--font-family-heading);
    font-size: 1.05em;
    font-weight: 600;
    margin: 0;
    letter-spacing: 0.01em;
  }

  .header-desc {
    font-size: 0.78em;
    color: var(--color-text-secondary);
    margin: 0;
    flex-basis: 100%;
  }

  .header-docs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-4);
    border-top: 1px solid var(--color-border-light);
  }

  .doc-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 8px;
    border: 1px solid var(--color-border-light);
    border-radius: 2px;
    font-family: var(--font-family-heading);
    font-size: 0.68em;
    color: var(--color-text-secondary);
    text-decoration: none;
    background: transparent;
    transition: color var(--motion-duration-instant) var(--motion-easing-out),
                border-color var(--motion-duration-instant) var(--motion-easing-out),
                background-color var(--motion-duration-instant) var(--motion-easing-out);
  }

  .doc-chip:hover {
    color: var(--module-color, var(--color-accent-base));
    border-color: color-mix(in oklch, var(--module-color, var(--color-accent-base)) 50%, transparent);
    background-color: color-mix(in oklch, var(--module-color, var(--color-accent-base)) 6%, transparent);
  }

  .doc-chip-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--module-color, var(--color-accent-base));
    opacity: 0.85;
  }

  .doc-chip-label {
    letter-spacing: 0.01em;
  }

  .doc-chip-external {
    opacity: 0.5;
    transition: opacity var(--motion-duration-instant) var(--motion-easing-out);
  }

  .doc-chip:hover .doc-chip-external {
    opacity: 1;
  }

  .doc-chip--api .doc-chip-icon {
    opacity: 1;
  }

  .doc-chip--spec .doc-chip-icon {
    opacity: 1;
  }

  .doc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border: 1px solid var(--color-border-light);
  }

  .doc-list-item {
    border-bottom: 1px solid var(--color-border-light);
  }

  .doc-list-item:last-child {
    border-bottom: none;
  }

  .doc-list-link {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    padding: var(--space-1) var(--space-2);
    border-radius: 0;
    color: var(--color-fg-primary);
    text-decoration: none;
    border-left: 2px solid transparent;
    position: relative;
    transition: background-color var(--motion-duration-instant) var(--motion-easing-out),
                color var(--motion-duration-instant) var(--motion-easing-out),
                border-color var(--motion-duration-instant) var(--motion-easing-out);
  }

  .doc-list-link:hover {
    background-color: color-mix(in oklch, var(--module-color, var(--color-accent-base)) 8%, var(--color-bg-hover));
    border-left-color: color-mix(in oklch, var(--module-color, var(--color-accent-base)) 60%, transparent);
  }

  .doc-list-border {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
  }

  .doc-list-border rect {
    fill: none;
    stroke: var(--module-color, var(--color-accent-base));
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
    transition: stroke-dashoffset 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .doc-list-link:hover .doc-list-border rect {
    stroke-dashoffset: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .doc-list-border rect {
      stroke-dashoffset: 0;
      transition: none;
    }
  }

  .doc-list-icon {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-radius: 3px;
    color: var(--color-text-inverse, #fff);
  }

  .doc-list-icon svg {
    width: 12px;
    height: 12px;
  }

  .doc-list-seq {
    font-family: var(--font-family-heading);
    font-size: 0.68em;
    color: var(--color-text-tertiary);
    flex-shrink: 0;
    min-width: 1.8em;
  }

  .doc-list-title {
    font-family: var(--font-family-heading);
    font-size: 0.82em;
    font-weight: 500;
    flex: 1 1 auto;
    min-width: 0;
    word-break: break-word;
    line-height: 1.4;
  }

  .doc-list-difficulty {
    font-size: 0.65em;
    padding: 1px 6px;
    border-radius: 2px;
    flex-shrink: 0;
    font-weight: 500;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .diff-beginner {
    background: color-mix(in srgb, var(--color-success-base) 15%, var(--color-bg-primary));
    color: var(--color-success-base);
  }

  .diff-intermediate {
    background: color-mix(in srgb, var(--color-warning-base) 15%, var(--color-bg-primary));
    color: var(--color-warning-base);
  }

  .diff-advanced {
    background: color-mix(in srgb, var(--color-danger-base) 28%, var(--color-bg-primary));
    color: var(--color-danger-base);
    font-weight: 600;
  }

  .doc-list-desc {
    flex-basis: 100%;
    padding-left: calc(24px + var(--space-2));
    font-size: 0.72em;
    color: var(--color-text-tertiary);
    line-height: 1.5;
    word-break: break-word;
  }

  .pager {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .pager-link {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    border: 1px solid var(--color-border-light);
    border-radius: 2px;
    font-family: var(--font-family-heading);
    font-size: 0.75em;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--motion-duration-instant) var(--motion-easing-out),
                border-color var(--motion-duration-instant) var(--motion-easing-out);
  }

  a.pager-link:hover {
    color: var(--module-color, var(--color-accent-base));
    border-color: color-mix(in oklch, var(--module-color, var(--color-accent-base)) 50%, transparent);
  }

  .pager-link--disabled {
    opacity: 0.4;
    cursor: default;
  }

  .pager-status {
    font-family: var(--font-family-heading);
    font-size: 0.72em;
    color: var(--color-text-tertiary);
    letter-spacing: 0.02em;
  }
  }
</style>
