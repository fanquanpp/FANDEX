---
/**
 * SceneBackdrop — 全站唯一背景特效层（单图层铁律）。
 *
 * 底色 + 暗角 + CSS 律动装饰（均衡条/轨道星系/音符/星尘/编号铭牌）+
 * 字符故障场，全部 render 在这一个 fixed 容器里，整层 z-index -1 垫底：
 * 背景装饰在结构上不可能遮挡内容，也不存在第二个背景图层
 * （GeoBgDecor / AmbientLayers 已并入本组件后删除，波浪线场已删除）。
 *
 * Props：
 *   decor   — 律动装饰变奏（fx/decor-config.ts 的 GeoBgVariant），缺省无线
 *   num     — 页面轨道号覆盖（如算法页 04），缺省用变体默认
 */
import { GEO_DECOR_CONFIG, NUM_DEFAULTS, type GeoBgVariant } from '@/fx/decor-config';

export interface Props {
  decor?: GeoBgVariant | undefined;
  num?: string | undefined;
  ambient?: boolean;
}

const { decor, num } = Astro.props;
const items = decor ? GEO_DECOR_CONFIG[decor] : [];
const numInfo = decor
  ? num
    ? { num, label: NUM_DEFAULTS[decor]?.label ?? 'FANDEX' }
    : NUM_DEFAULTS[decor]
  : null;
---

<div class="fx-backdrop" aria-hidden="true">
  {
    items.map((item) => {
      if (item.children === 'rings') {
        return (
          <div class="decor-orbit" style={item.style}>
            <span class="decor-orbit__ring decor-orbit__ring--a">
              <i />
            </span>
            <span class="decor-orbit__ring decor-orbit__ring--b">
              <i />
            </span>
            <span class="decor-orbit__ring decor-orbit__ring--c">
              <i />
            </span>
          </div>
        );
      }
      if (item.className === 'decor-trio') {
        return (
          <div class="decor-trio" style={item.style}>
            <span />
            <span />
            <span />
          </div>
        );
      }
      if (item.className === 'decor-num' && numInfo) {
        return (
          <div class={item.className} style={item.style} data-label={numInfo.label}>
            {numInfo.num}
          </div>
        );
      }
      return <div class={item.className} style={item.style} />;
    })
  }
  {
    numInfo && !items.some((item) => item.className === 'decor-num') && (
      <div
        class="decor-num"
        style="left:2%;bottom:4%;font-size:clamp(110px,16vw,220px)"
        data-label={numInfo.label}
      >
        {numInfo.num}
      </div>
    )
  }
  {
    <div
      data-fx="letter-glitch"
        data-letter-glitch-font-size="18"
        data-letter-glitch-spacing="0.8"
        data-letter-glitch-density="0.4"
        data-letter-glitch-base-opacity="0.16"
        data-letter-glitch-glitch-amount="0.5"
        data-letter-glitch-speed="1"
        data-letter-glitch-flow="0.6"
        data-letter-glitch-cursor-radius="140"
        data-letter-glitch-click-effect="tear"
    />
  }
</div>
