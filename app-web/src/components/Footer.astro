---
import { SITE } from '@/lib/constants';
import { IS_DESKTOP_BUILD } from '@/lib/constants';

interface Props {
  currentPath?: string;
}

const { currentPath: _currentPath } = Astro.props;
const base = import.meta.env.BASE_URL;

const PROJECT_START_YEAR = 2026;
const currentYear = new Date().getFullYear();
const yearRange =
  currentYear > PROJECT_START_YEAR
    ? `${PROJECT_START_YEAR}-${currentYear}`
    : `${PROJECT_START_YEAR}`;
---

<footer class="fndx-footer fndx-footer--plain" role="contentinfo" aria-label="站点页脚" data-i18n-aria="footer.footerAria">
  <div class="fndx-footer__container">
    <div class="fndx-footer__sections">
      <div class="fndx-footer__section footer-brand">
        <p class="footer-brand__mark">
          <span class="footer-brand__fan">FAN</span><span class="footer-brand__dex">DEX</span>
          <span class="footer-brand__marker" aria-hidden="true">://</span>
        </p>
        <p class="footer-brand__tagline" data-i18n="footer.tagline">循序渐进，从第一行代码到理解整个世界。</p>
        <p class="footer-brand__meta" data-i18n="footer.meta" data-i18n-params={JSON.stringify({ author: SITE.author })}>计算机科学自学平台 · {SITE.author}</p>
      </div>

      <nav class="fndx-footer__section" aria-label="学习入口" data-i18n-aria="footer.learnAria">
        <h2 class="fndx-footer__section-title footer-section-title" data-i18n="footer.learnTitle">学习入口</h2>
        {!IS_DESKTOP_BUILD && (
          <a href={`${base}playground/`} class="fndx-footer__link" data-i18n="footer.playground">在线前端</a>
        )}
        <a href={`${base}syntax/`} class="fndx-footer__link" data-i18n="footer.syntax">语法速览</a>
        <a href={`${base}learning-path/`} class="fndx-footer__link" data-i18n="footer.learningPath">学习路线</a>
        <a href={`${base}algorithms/`} class="fndx-footer__link" data-i18n="footer.algorithms">算法教学</a>
        <a href={base} class="fndx-footer__link" data-i18n="footer.moduleOverview">模块总览</a>
      </nav>

      <nav class="fndx-footer__section" aria-label="项目资源" data-i18n-aria="footer.resourcesAria">
        <h2 class="fndx-footer__section-title footer-section-title" data-i18n="footer.resourcesTitle">项目资源</h2>
        <a
          href="https://github.com/fanquanpp/FANDEX"
          class="fndx-footer__link"
          target="_blank"
          rel="noopener noreferrer"
          data-i18n="footer.github"
        >
          GitHub 仓库
        </a>
        <a
          href="https://github.com/fanquanpp/FANDEX/releases"
          class="fndx-footer__link"
          target="_blank"
          rel="noopener noreferrer"
          data-i18n="footer.releases"
        >
          版本发布
        </a>
        <a
          href="https://github.com/fanquanpp/FANDEX/issues"
          class="fndx-footer__link"
          target="_blank"
          rel="noopener noreferrer"
          data-i18n="footer.issues"
        >
          问题反馈
        </a>
        <a
          href="https://github.com/fanquanpp/FANDEX/blob/main/LICENSE"
          class="fndx-footer__link"
          target="_blank"
          rel="noopener noreferrer"
        >
          MIT License
        </a>
        <a href={`${base}disclaimer/`} class="fndx-footer__link" data-i18n="footer.disclaimer">免责声明</a>
      </nav>
    </div>

    {}
    <div class="fndx-footer__bottom">
      <p
        class="fndx-footer__copyright"
        data-i18n="footer.copyright"
        data-i18n-params={JSON.stringify({ year: yearRange, author: SITE.author || 'fanquanpp' })}
      >
        Copyright (c) {yearRange} {SITE.author || 'fanquanpp'} · 计算机科学自学平台 · 内容仅供学习参考
      </p>
      <p class="footer-build-note">ASTRO // STATIC BUILD</p>
    </div>
  </div>
</footer>

<style>
  .fndx-footer--plain {
    background: transparent;
    border-top: none;
    background-image: linear-gradient(
      to right,
      transparent,
      var(--color-border-light) 12%,
      var(--color-border-light) 88%,
      transparent
    );
    background-size: 100% 1px;
    background-position: top;
    background-repeat: no-repeat;
    margin-top: var(--space-8);
    padding-block: var(--space-6) var(--space-6);
  }

  .footer-brand {
    gap: var(--space-stack-sm);
  }

  .footer-brand__mark {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    margin: 0;
    font-family: var(--font-family-heading);
    font-size: 1.15rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.08em;
    color: var(--color-fg-primary);
    line-height: 1.2;
  }

  .footer-brand__dex {
    color: var(--color-accent-base);
  }

  .footer-brand__marker {
    font-family: var(--font-family-mono, monospace);
    font-size: 0.72rem;
    color: var(--color-fg-tertiary);
    letter-spacing: 0;
  }

  .footer-brand__tagline {
    margin: 0;
    font-size: var(--font-size-secondary);
    color: var(--color-fg-secondary);
    line-height: var(--font-line-height-body);
  }

  .footer-brand__meta {
    margin: 0;
    font-size: var(--font-size-caption);
    color: var(--color-fg-tertiary);
    font-family: var(--font-family-mono, monospace);
    letter-spacing: 0.04em;
  }

  .footer-section-title {
    display: flex;
    align-items: center;
    gap: var(--space-inline-sm);
    letter-spacing: var(--font-letter-spacing-label);
  }

  .footer-section-title::before {
    content: '';
    width: 3px;
    height: 12px;
    border-radius: 1px;
    background: var(--color-accent-base);
    flex-shrink: 0;
  }

  .footer-build-note {
    margin: 0;
    font-family: var(--font-family-mono, monospace);
    font-size: var(--font-size-caption);
    color: var(--color-fg-tertiary);
    letter-spacing: 0.08em;
  }

  @media (max-width: 767px) {
    .footer-build-note {
      display: none;
    }
  }
</style>
