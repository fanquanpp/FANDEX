---
import BaseLayout from '@/components/BaseLayout.astro';
import ThemeToggle from '@/islands/ThemeToggle';
import LangToggle from '@/components/LangToggle.astro';
import PerformanceMonitor from '@/components/PerformanceMonitor.astro';
import ReadingProgress from '@/components/ReadingProgress.astro';
import HeaderFeatureLinks from '@/components/HeaderFeatureLinks.astro';
import { getFeatureSheetEntries } from '@/lib/feature-entries';
import { SITE } from '@/lib/constants';

const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
const sheetEntries = getFeatureSheetEntries(base);
const hasSidebar = Astro.slots.has('sidebar');
const hasToc = Astro.slots.has('toc');
---

<BaseLayout title={title}>
  <slot name="head" slot="head" />

  <style is:inline>
    @layer base {
    html {
      height: 100%;
      overscroll-behavior: none;
    }
    body {
      height: 100vh;
      height: 100dvh;
      overflow: hidden;
      overscroll-behavior: none;
    }
    }
  </style>
  {hasSidebar && <div class="fndx-sidebar-backdrop" id="sidebar-backdrop" />}
  <ReadingProgress />
  <div
    class="app-layout"
    class:list={{ 'no-sidebar': !hasSidebar, 'has-toc': hasToc }}
  >
    <header class="app-nav">
      <div class="nav-left">
        <a href={base} class="nav-logo">
          <span class="logo-text">{SITE.title}</span>
        </a>
        <HeaderFeatureLinks />
      </div>
      <div class="nav-right">
        <button class="nav-search-btn fndx-icon-btn fndx-icon-btn--labeled" type="button" data-search-trigger aria-label="搜索" data-i18n-aria="nav.searchAria" data-tooltip="搜索（Ctrl+K）" data-i18n-tooltip="nav.searchTooltip" data-tooltip-pos="bottom">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
          </svg>
          <span class="nav-search-text" data-i18n="nav.search">搜索</span>
        </button>
        <button class="nav-back-to-top fndx-icon-btn fndx-icon-btn--labeled" id="nav-back-to-top" aria-label="返回顶部" data-i18n-aria="nav.backToTop" data-tooltip="返回顶部" data-i18n-tooltip="nav.backToTop" data-tooltip-pos="bottom">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <polyline points="18 15 12 9 6 15"></polyline>
          </svg>
          <span class="nav-back-to-top-text" data-i18n="nav.top">Top</span>
        </button>
        <button class="nav-install-btn fndx-icon-btn" type="button" data-install-app hidden aria-label="安装应用" data-i18n-aria="nav.install" data-tooltip="安装到桌面 / 主屏幕" data-i18n-tooltip="nav.installTooltip" data-tooltip-pos="bottom">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
        </button>
        <LangToggle />
        <ThemeToggle client:load />
      </div>
    </header>
    <slot name="sidebar" />
    <main class="app-main" id="app-main">
      <slot />
    </main>
    {hasToc && <slot name="toc" />}
  </div>
  <nav class="mobile-nav">
    <a href={base} class="mobile-nav-link">
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
        <polyline points="9 22 9 12 15 12 15 22"></polyline>
      </svg>
      <span data-i18n="nav.home">首页</span>
    </a>
    {
      hasSidebar && (
        <button class="mobile-nav-link" id="mobile-sidebar-btn" aria-label="模块" data-i18n-aria="nav.modulesAria">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
          </svg>
          <span data-i18n="nav.modules">模块</span>
        </button>
      )
    }
    <button class="mobile-nav-link" id="mobile-features-btn" aria-label="功能" data-i18n-aria="nav.featuresAria" aria-expanded="false" aria-controls="feature-sheet">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="7" height="7" rx="1"></rect>
        <rect x="14" y="3" width="7" height="7" rx="1"></rect>
        <rect x="3" y="14" width="7" height="7" rx="1"></rect>
        <rect x="14" y="14" width="7" height="7" rx="1"></rect>
      </svg>
      <span data-i18n="nav.features">功能</span>
    </button>
    <button class="mobile-nav-link" id="mobile-fullscreen-btn" aria-label="全屏" data-i18n-aria="nav.fullscreenAriaMobile">
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"
        ></path>
      </svg>
      <span data-i18n="nav.fullscreenLabel">全屏</span>
    </button>
  </nav>
  <div class="feature-sheet-backdrop" id="feature-sheet-backdrop" />
  <nav class="feature-sheet" id="feature-sheet" aria-label="功能直达" data-i18n-aria="nav.featureSheetAria" aria-hidden="true">
    <p class="feature-sheet__title" data-i18n="nav.featureSheetTitle">功能直达</p>
    {
      sheetEntries.map(entry => (
        <a href={entry.href} class="feature-sheet__link">
          <span class="feature-sheet__name" data-i18n={entry.nameKey}>{entry.name}</span>
          <span class="feature-sheet__hint" data-i18n={entry.tooltipKey}>{entry.tooltip}</span>
          <svg class="feature-sheet__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </a>
      ))
    }
  </nav>
  <PerformanceMonitor />
</BaseLayout>

<script>
  import '@/lib/layout-interactions';
</script>

<style>
  @layer components {
  .nav-toggle {
    display: none;
  }

  @media (max-width: 768px) {
    .nav-toggle {
      display: flex;
    }
  }
  }
</style>
