---
/**
 * 文档页主布局组件
 * 提供文档页面的整体结构：顶部导航栏、侧边栏、主内容区、移动端底部导航
 * 支持暗色模式切换、全屏模式、侧边栏状态持久化、代码复制等功能
 * 继承 BaseLayout 的共享 head 与样式引入，仅保留文档页特有的结构与脚本
 */
import BaseLayout from '@/components/BaseLayout.astro';
import ThemeToggle from '@/islands/ThemeToggle';
import PerformanceMonitor from '@/components/PerformanceMonitor.astro';
import ReadingProgress from '@/components/ReadingProgress.astro';
import { SITE } from '@/lib/constants';

const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
// 检测是否包含侧边栏/目录大纲插槽，用于条件渲染遮罩层、移动端导航按钮和三栏布局
const hasSidebar = Astro.slots.has('sidebar');
const hasToc = Astro.slots.has('toc');
---

<BaseLayout title={title}>
  <slot name="head" slot="head" />

  <!-- 文档页滚动架构：body 禁止滚动，所有纵向滚动由 .app-main 内部容器处理
       防止快速上下滑动时 body 扩展产生无限空页面（item 12 修复） -->
  <style is:inline>
    @layer base {
    html {
      height: 100%;
      /* 禁止 html 层级的过度滚动，防止链式滚动传播 */
      overscroll-behavior: none;
    }
    body {
      /* 固定高度而非 min-height，防止 body 扩展产生空白滚动区 */
      height: 100vh;
      height: 100dvh;
      /* 禁止 body 滚动，所有滚动由 .app-main 处理 */
      overflow: hidden;
      overscroll-behavior: none;
    }
    }
  </style>
  <!-- 侧边栏遮罩层：移动端打开侧边栏时显示，点击关闭（使用共享 .fndx-sidebar-backdrop 样式） -->
  {hasSidebar && <div class="fndx-sidebar-backdrop" id="sidebar-backdrop" />}
  <!-- 阅读进度条：固定于页面顶部，由本地组件提供（原 @fandex/astro-components 已迁入 app-web） -->
  <ReadingProgress />
  <!-- 主布局容器：根据侧边栏/目录大纲存在情况添加不同类名，支持三栏布局 -->
  <div
    class="app-layout"
    class:list={{ 'no-sidebar': !hasSidebar, 'has-toc': hasToc }}
  >
    <!-- 顶部导航栏 -->
    <header class="app-nav">
      <div class="nav-left">
        <a href={base} class="nav-logo">
          <span class="logo-text">{SITE.title}</span>
        </a>
      </div>
      <div class="nav-right">
        <!-- 全站搜索：打开命令面板（Ctrl/Cmd + K），纯 DOM 实现无岛屿水合 -->
        <button class="nav-search-btn fndx-icon-btn fndx-icon-btn--labeled" type="button" data-search-trigger aria-label="搜索" data-tooltip="搜索（Ctrl+K）" data-tooltip-pos="bottom">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
          </svg>
          <span class="nav-search-text">搜索</span>
        </button>
        <!-- 返回顶部按钮：图标 + Top 文字标注，统一 fndx-icon-btn 风格 -->
        <button class="nav-back-to-top fndx-icon-btn fndx-icon-btn--labeled" id="nav-back-to-top" aria-label="返回顶部" data-tooltip="返回顶部" data-tooltip-pos="bottom">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <polyline points="18 15 12 9 6 15"></polyline>
          </svg>
          <span class="nav-back-to-top-text">Top</span>
        </button>
        <!-- PWA 安装入口：默认隐藏，可安装（beforeinstallprompt / iOS）时由 lib/pwa-install 点亮 -->
        <button class="nav-install-btn fndx-icon-btn" type="button" data-install-app hidden aria-label="安装应用" data-tooltip="安装到桌面 / 主屏幕" data-tooltip-pos="bottom">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
        </button>
        <!-- 主题切换按钮（React 岛屿组件） -->
        <ThemeToggle client:load />
      </div>
    </header>
    <!-- 侧边栏插槽 -->
    <slot name="sidebar" />
    <!-- 主内容区域 -->
    <main class="app-main" id="app-main">
      <slot />
    </main>
    <!-- 目录大纲插槽（仅桌面端显示，由 .fndx-toc CSS 控制响应式显隐） -->
    {hasToc && <slot name="toc" />}
  </div>
  <!-- 移动端底部导航栏 -->
  <nav class="mobile-nav">
    <a href={base} class="mobile-nav-link">
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
        <polyline points="9 22 9 12 15 12 15 22"></polyline>
      </svg>
      <span>首页</span>
    </a>
    <!-- 模块切换按钮：仅在有侧边栏时显示 -->
    {
      hasSidebar && (
        <button class="mobile-nav-link" id="mobile-sidebar-btn" aria-label="模块">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
          </svg>
          <span>模块</span>
        </button>
      )
    }
    <!-- 全屏切换按钮 -->
    <button class="mobile-nav-link" id="mobile-fullscreen-btn" aria-label="全屏">
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"
        ></path>
      </svg>
      <span>全屏</span>
    </button>
  </nav>
  <!-- 性能监控面板：仅开发环境渲染（组件内部通过 import.meta.env.DEV 控制） -->
  <PerformanceMonitor />
</BaseLayout>

<!-- 客户端交互脚本：侧边栏开关、全屏切换、代码复制、SW 注册等 -->
<script>
  import '@/lib/layout-interactions';
</script>

<style>
  /* 菜单切换按钮：默认隐藏，移动端显示
   * 注：遮罩层样式已迁移至 @fandex/styles 的 .fndx-sidebar-backdrop
   * 归入 @layer components，避免未分层 CSS 覆盖 ark 令牌 */
  @layer components {
  .nav-toggle {
    display: none;
  }

  @media (max-width: 768px) {
    .nav-toggle {
      display: flex;
    }
  }
  }
</style>
