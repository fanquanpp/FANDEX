---
import BaseLayout from '@/components/BaseLayout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import Footer from '@/components/Footer.astro';
import PerformanceMonitor from '@/components/PerformanceMonitor.astro';
import ReadingProgress from '@/components/ReadingProgress.astro';
import { getFeatureSheetEntries } from '@/lib/feature-entries';

const { title, fxDecor, fxNum } = Astro.props;
const base = import.meta.env.BASE_URL;
const sheetEntries = getFeatureSheetEntries(base);
const hasSidebar = Astro.slots.has('sidebar');
const hasToc = Astro.slots.has('toc');
---

<BaseLayout title={title} fxDecor={fxDecor} fxNum={fxNum}>
  <slot name="head" slot="head" />

  <style is:inline>
    @layer base {
    html {
      height: 100%;
      overscroll-behavior: none;
    }
    body {
      height: 100vh;
      height: 100dvh;
      overflow: hidden;
      overscroll-behavior: none;
    }
    }
  </style>
  {hasSidebar && <div class="fndx-sidebar-backdrop" id="sidebar-backdrop" />}
  <ReadingProgress />
  <div
    class="app-layout"
    class:list={{ 'no-sidebar': !hasSidebar, 'has-toc': hasToc }}
  >
    <SiteHeader variant="doc" />
    <slot name="sidebar" />
    <main class="app-main" id="app-main">
      <slot />
      {/* 页脚上收到壳（规格 4.7）：文档壳页此前缺页脚（视检第 2 期第 3 项） */}
      <Footer />
    </main>
    {hasToc && <slot name="toc" />}
  </div>
  <nav class="mobile-nav" aria-label="移动端导航" data-i18n-aria="nav.mobileNavAria">
    <a href={base} class="mobile-nav-link">
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
        <polyline points="9 22 9 12 15 12 15 22"></polyline>
      </svg>
      <span data-i18n="nav.home">首页</span>
    </a>
    {
      hasSidebar && (
        <button class="mobile-nav-link" id="mobile-sidebar-btn" aria-label="模块" data-i18n-aria="nav.modulesAria">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
          </svg>
          <span data-i18n="nav.modules">模块</span>
        </button>
      )
    }
    <button class="mobile-nav-link" id="mobile-features-btn" aria-label="功能" data-i18n-aria="nav.featuresAria" aria-expanded="false" aria-controls="feature-sheet">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="7" height="7" rx="1"></rect>
        <rect x="14" y="3" width="7" height="7" rx="1"></rect>
        <rect x="3" y="14" width="7" height="7" rx="1"></rect>
        <rect x="14" y="14" width="7" height="7" rx="1"></rect>
      </svg>
      <span data-i18n="nav.features">功能</span>
    </button>
    <button class="mobile-nav-link" id="mobile-fullscreen-btn" aria-label="全屏" data-i18n-aria="nav.fullscreenAriaMobile">
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"
        ></path>
      </svg>
      <span data-i18n="nav.fullscreenLabel">全屏</span>
    </button>
  </nav>
  <div class="feature-sheet-backdrop" id="feature-sheet-backdrop" />
  <nav class="feature-sheet" id="feature-sheet" aria-label="功能直达" data-i18n-aria="nav.featureSheetAria" aria-hidden="true">
    <p class="feature-sheet__title" data-i18n="nav.featureSheetTitle">功能直达</p>
    {
      sheetEntries.map(entry => (
        <a href={entry.href} class="feature-sheet__link">
          <span class="feature-sheet__name" data-i18n={entry.nameKey}>{entry.name}</span>
          <span class="feature-sheet__hint" data-i18n={entry.tooltipKey}>{entry.tooltip}</span>
          <svg class="feature-sheet__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </a>
      ))
    }
  </nav>
  <PerformanceMonitor />
</BaseLayout>

<script>
  import '@/lib/layout-interactions';
</script>

<!-- .nav-toggle 的样式单点在 styles/components/breadcrumb.css（按钮本体在
     Breadcrumb.astro 内，scoped 选择器匹配不到 slot 内容，原此处的死块已删，
     连带清除唯一的 max-width:768px 孤儿断点，规格 4.3） -->
