---
import { t } from '@/lib/i18n';
import '@/styles/islands/LangToggle.css';
---

<button
  type="button"
  class="fndx-lang-toggle fndx-icon-btn"
  data-lang-toggle
  aria-label={t('langToggle.aria')}
  data-i18n-aria="langToggle.aria"
  data-tooltip={t('langToggle.tooltip')}
  data-i18n-tooltip="langToggle.tooltip"
  data-tooltip-pos="bottom"
>
  <span class="fndx-lang-toggle__label" data-i18n="langToggle.label">{t('langToggle.label')}</span>
</button>
