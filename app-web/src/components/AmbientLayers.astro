---
/**
 * AmbientLayers — 环境画布层组合（fx 体系的字符场）。
 *
 * 纯声明式：以 data-fx 标记宿主，fx 注册表在 full 档挂载实际实现，
 * lite 档 / 无 JS 时整层为空壳零成本。
 *
 * preset：
 *   full — 二进制字符故障场（首页舞台）
 */
export interface Props {
  preset?: 'full';
}

const { preset = 'full' } = Astro.props;
---

<div class="fx-ambient" aria-hidden="true">
  {
    preset === 'full' && (
      <div
        data-fx="letter-glitch"
        data-letter-glitch-characters="01"
        data-letter-glitch-font-size="8"
        data-letter-glitch-spacing="0.8"
        data-letter-glitch-density="1"
        data-letter-glitch-base-opacity="0.2"
        data-letter-glitch-glitch-amount="0.5"
        data-letter-glitch-speed="1"
        data-letter-glitch-flow="0.5"
        data-letter-glitch-cursor-radius="140"
        data-letter-glitch-click-effect="tear"
      />
    )
  }
</div>
