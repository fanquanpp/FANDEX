---
import EntryWaveBorder from '@/components/EntryWaveBorder.astro';
import { IS_DESKTOP_BUILD } from '@/lib/constants';
/**
 * 子功能页共享功能入口导航
 * -----------------------------------------------------------------------------
 * 六个子功能页（在线编程 / 语法速览 / 学习路线 / 算法教学 / 题图鉴）共用同一组
 * 兄弟功能入口，保证跨功能跳转的入口一致性与可预期性（此前各页维护的内联
 * nav 子集互相缺漏，如题图鉴页缺语法速览、语法页缺题图鉴）。
 *
 * 页面专属入口（如在线编程主页的"进入工作台/灵感图鉴"）通过 extra 前置渲染。
 * 桌面端构建不含 playground，"在线编程"入口自动隐藏。
 */
interface FeatureEntry {
  /** 跳转地址 */
  href: string;
  /** 入口文案 */
  label: string;
  /** 悬停提示 */
  tooltip: string;
}

interface Props {
  /** 页面专属入口（渲染在标准兄弟入口之前） */
  extra?: FeatureEntry[];
}

const base = import.meta.env.BASE_URL
const { extra = [] } = Astro.props

/** 标准兄弟入口：所有子功能页共享（顺序即跨页跳转的心智模型） */
const siblings: FeatureEntry[] = [
  { href: base, label: '首页', tooltip: '返回首页' },
  { href: `${base}syntax/`, label: '语法速览', tooltip: '语法快速查阅' },
  { href: `${base}learning-path/`, label: '学习路线', tooltip: '系统化学习路径' },
  { href: `${base}algorithms/`, label: '算法教学', tooltip: '算法教程与刷题图鉴' },
  ...(!IS_DESKTOP_BUILD
    ? [{ href: `${base}playground/`, label: '在线编程', tooltip: '在线编写与运行代码' }]
    : []),
]

const entries: FeatureEntry[] = [...extra, ...siblings]
---

<nav class="hero-entries" aria-label="功能入口">
  {
    entries.map((entry) => (
      <a href={entry.href} class="entry-btn" data-tooltip={entry.tooltip} data-tooltip-pos="bottom">
        <EntryWaveBorder />
        <span class="entry-name">{entry.label}</span>
      </a>
    ))
  }
</nav>
