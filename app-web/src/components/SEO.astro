---
import { SITE } from '@/lib/constants';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description?: string | undefined;
  canonical?: string;
  type?: 'article' | 'website';
  publishedDate?: string | Date | undefined;
  modifiedDate?: string | Date | undefined;
  breadcrumb?: BreadcrumbItem[];
}

const {
  title,
  description,
  canonical,
  type = 'article',
  publishedDate,
  modifiedDate,
  breadcrumb,
} = Astro.props;

const SITE_TITLE_SUFFIX = new RegExp(`(?:^|[\\s·|—-])${SITE.title}\\s*$`);
const fullTitle =
  title === SITE.title || SITE_TITLE_SUFFIX.test(title) ? title : `${title} | ${SITE.title}`;
const pageUrl = canonical || SITE.url;
const pageDescription = description || SITE.subtitle;

const ogImageUrl = new URL(`${import.meta.env.BASE_URL}og-image.png`, SITE.url).href;

const toIso = (d: string | Date | undefined): string | undefined => {
  if (d === undefined) return undefined;
  try {
    const date = new Date(d);
    if (Number.isNaN(date.getTime())) return undefined;
    return date.toISOString();
  } catch {
    return undefined;
  }
};
const datePublished = toIso(publishedDate) || new Date().toISOString();
const dateModified = toIso(modifiedDate) || toIso(publishedDate) || new Date().toISOString();

const ldJson =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: title,
        description: pageDescription,
        url: pageUrl,
        mainEntityOfPage: {
          '@type': 'WebPage',
          '@id': pageUrl,
        },
        image: ogImageUrl,
        datePublished,
        dateModified,
        author: {
          '@type': 'Person',
          name: SITE.author,
          url: `https://github.com/${SITE.author}`,
        },
        publisher: {
          '@type': 'Organization',
          name: SITE.title,
          url: SITE.url,
          logo: {
            '@type': 'ImageObject',
            url: ogImageUrl,
          },
        },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: SITE.title,
        url: SITE.url,
        description: SITE.subtitle,
        publisher: {
          '@type': 'Organization',
          name: SITE.title,
          url: SITE.url,
        },
      };

const breadcrumbJson =
  breadcrumb && breadcrumb.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumb.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: item.label,
          ...(item.href ? { item: new URL(item.href, SITE.url).href } : {}),
        })),
      }
    : null;
---

<title>{fullTitle}</title>
<meta name="description" content={pageDescription} />

<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:type" content={type} />
<meta property="og:url" content={pageUrl} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:locale" content="zh_CN" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta name="twitter:image" content={ogImageUrl} />

<link rel="canonical" href={pageUrl} />

<script type="application/ld+json" is:inline set:html={JSON.stringify(ldJson)} />
{
  breadcrumbJson && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJson)} />
  )
}
