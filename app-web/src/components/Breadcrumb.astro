---
import '@/styles/components/breadcrumb.css';

const { items, hasSidebar = false } = Astro.props as {
  items: { label: string; href?: string; i18nKey?: string; i18nParams?: Record<string, string | number> }[];
  hasSidebar?: boolean;
};
---

<nav class="breadcrumb" aria-label="面包屑" data-i18n-aria="breadcrumb.ariaLabel">
  {
    hasSidebar && (
      <button class="nav-toggle" id="nav-toggle" aria-label="展开侧边栏" data-i18n-aria="sidebar.expandAria" aria-controls="app-sidebar">
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    )
  }
  {
    items.map((item, i) => {
      const isMobileHidden = items.length > 2 && i > 0 && i < items.length - 1;
      // 移动端中间项折叠为一个省略号：仅第一处显示“/ …”，其余中间项的
      // 前导分隔线一并隐藏，避免出现 “首页 / … / / 标题” 这类重复分隔
      const sepHiddenOnMobile = isMobileHidden && i !== 1;
      return (
        <>
          {i > 0 && (
            <span class={`bc-sep${sepHiddenOnMobile ? ' bc-sep-hide-mobile' : ''}`}>/</span>
          )}
          {isMobileHidden && i === 1 && (
            <span class="bc-ellipsis" aria-hidden="true">
              ...
            </span>
          )}
          {item.href ? (
            <a
              href={item.href}
              class={`bc-link${isMobileHidden ? ' bc-mobile-hide' : ''}`}
              data-i18n={item.i18nKey}
              data-i18n-params={item.i18nParams ? JSON.stringify(item.i18nParams) : undefined}
            >
              {item.label}
            </a>
          ) : (
            <span
              class={`bc-current${isMobileHidden ? ' bc-mobile-hide' : ''}`}
              aria-current={isMobileHidden ? undefined : 'page'}
              data-i18n={item.i18nKey}
              data-i18n-params={item.i18nParams ? JSON.stringify(item.i18nParams) : undefined}
            >
              {item.label}
            </span>
          )}
        </>
      );
    })
  }
</nav>
