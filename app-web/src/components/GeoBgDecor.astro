---
/**
 * GeoBgDecor — 律动装饰背景渲染器。
 *
 * 组件化改造：变奏配置（轨道号 + 编制清单）全部来自 fx/decor-config.ts
 * 单一数据源，本组件只负责把配置映射为 decor DOM；新增页面变奏或调整
 * 编制只改配置文件。
 *
 * ambient prop 组合 fx 环境画布层（AmbientLayers）：
 *   'none'（默认）— 仅 CSS 律动装饰，文档页保持阅读优先；
 *   'full' / 'grid' — 挂指针网格（与字符场），full 档浏览器生效。
 */
import AmbientLayers from '@/components/AmbientLayers.astro';
import { GEO_DECOR_CONFIG, NUM_DEFAULTS } from '@/fx/decor-config';

interface Props {
  variant?: keyof typeof GEO_DECOR_CONFIG;
  num?: string;
  ambient?: 'none' | 'full' | 'grid';
}

const { variant = 'minimal', num, ambient = 'none' } = Astro.props;
const items = GEO_DECOR_CONFIG[variant];
const numInfo = num ? { num, label: NUM_DEFAULTS[variant]?.label ?? 'FANDEX' } : NUM_DEFAULTS[variant];
---

<div class="decor-bg" aria-hidden="true">
  {
    items.map((item) => {
      if (item.children === 'rings') {
        return (
          <div class="decor-orbit" style={item.style}>
            <span class="decor-orbit__ring decor-orbit__ring--a">
              <i />
            </span>
            <span class="decor-orbit__ring decor-orbit__ring--b">
              <i />
            </span>
            <span class="decor-orbit__ring decor-orbit__ring--c">
              <i />
            </span>
          </div>
        );
      }
      if (item.className === 'decor-trio') {
        return (
          <div class="decor-trio" style={item.style}>
            <span />
            <span />
            <span />
          </div>
        );
      }
      if (item.className === 'decor-num' && numInfo) {
        return (
          <div class={item.className} style={item.style} data-label={numInfo.label}>
            {numInfo.num}
          </div>
        );
      }
      return <div class={item.className} style={item.style} />;
    })
  }
  {
    numInfo && !items.some((item) => item.className === 'decor-num') && (
      <div
        class="decor-num"
        style="left:2%;bottom:4%;font-size:clamp(110px,16vw,220px)"
        data-label={numInfo.label}
      >
        {numInfo.num}
      </div>
    )
  }
  {ambient !== 'none' && <AmbientLayers preset={ambient} />}
</div>
