---

export type GeoBgVariant =
  | 'home'
  | 'docs'
  | 'list'
  | 'learning-path'
  | 'minimal'
  | 'loading'
  | 'error'
  | 'info'
  | 'playground';

type GeoDecorItem = string | { readonly className: string; readonly style?: string };

const GEO_DECOR_CONFIG: Record<GeoBgVariant, GeoDecorItem[]> = {
  home: [
    'geo-curve-s',
    'geo-ripple-tr',
    'geo-triangle-rt',
    'geo-bars-marks',
    'geo-spiral-ccw',
    'geo-pulse-ring',
    'geo-float-block',
    'geo-orbit-ring',
    'geo-crosshair',
  ],
  docs: [
    'geo-bg-grid',
    'geo-curve-s',
    'geo-cross-marks',
    'geo-dots-radial',
    'geo-bezier-flow',
    'geo-pulse-ring',
    'geo-float-block',
  ],
  list: [
    'geo-bg-grid',
    'geo-parallel-lines',
    'geo-cross-marks',
    { className: 'geo-hatch-block', style: 'top:12%;right:4%' },
    'geo-dots-radial',
    'geo-chevron-stack',
    'geo-bezier-flow',
  ],
  'learning-path': [
    'geo-bg-grid',
    'geo-curve-s',
    'geo-triangle-rt',
    'geo-bars-marks',
    'geo-bars-radial',
    'geo-bars-pulse',
    'geo-float-block',
    'geo-bars-float',
  ],
  minimal: ['geo-bg-grid', 'geo-bars-marks'],
  loading: ['geo-bg-grid', 'geo-dots-sm'],
  error: ['geo-bg-grid', 'geo-bars-marks', 'geo-bars-pulse', 'geo-scan-line'],
  info: [
    'geo-bg-grid',
    'geo-curve-s',
    'geo-cross-marks',
    'geo-dots-radial',
    'geo-pulse-ring',
    'geo-float-block',
  ],
  playground: [
    'geo-bg-grid',
    'geo-bracket-pair',
    'geo-terminal-block',
    'geo-parallel-lines',
    'geo-bars-radial',
    'geo-bars-marks',
    'geo-bars-pulse',
    'geo-scan-line',
    'geo-code-cursor',
    'geo-bezier-flow',
  ],
};

interface Props {
  variant?: GeoBgVariant;
}

const { variant = 'minimal' } = Astro.props;
const items = GEO_DECOR_CONFIG[variant];
---

<div class="geo-bg-decor" aria-hidden="true">
  {
    items.map((item) => {
      const className = typeof item === 'string' ? item : item.className;
      const style = typeof item === 'string' ? undefined : item.style;
      return <div class={className} style={style} />;
    })
  }
</div>
