---
export type GeoBgVariant =
  | 'home'
  | 'docs'
  | 'list'
  | 'learning-path'
  | 'minimal'
  | 'loading'
  | 'error'
  | 'info'
  | 'playground';

interface GeoDecorItem {
  readonly className: string;
  readonly style?: string;
  readonly content?: string;
}

/*
 * 律动装饰系统 — 每个页面只讲一个「声音可视化」母题的强弱变奏：
 *   home          全编制：音波 + 均衡条 + 轨道环 + 音符 + 幽灵数字 01/39（歌姬元素）
 *   docs / list   轻编制：阅读优先，仅保留一两条声轨
 *   playground    代码变奏：括号、终端、光标（青绿着色）
 *   error         扫描线变奏
 */
const GEO_DECOR_CONFIG: Record<GeoBgVariant, GeoDecorItem[]> = {
  home: [
    { className: 'decor-grid' },
    { className: 'decor-wave', style: 'top:26%' },
    { className: 'decor-eq', style: 'bottom:16%;left:9%' },
    { className: 'decor-orbit', style: 'top:11%;right:7%' },
    { className: 'decor-note', style: 'top:44%;left:5%' },
    { className: 'decor-note', style: 'top:60%;right:24%;animation-delay:-5s' },
    { className: 'decor-num', style: 'left:3%;bottom:4%;font-size:clamp(150px,22vw,280px)', content: '01' },
    { className: 'decor-num decor-num--accent', style: 'right:2%;top:12%;font-size:clamp(110px,15vw,190px)', content: '39' },
  ],
  docs: [
    { className: 'decor-grid' },
    { className: 'decor-wave', style: 'top:8%;opacity:.5' },
    { className: 'decor-eq', style: 'bottom:9%;right:5%;height:38px' },
  ],
  list: [
    { className: 'decor-grid' },
    { className: 'decor-orbit', style: 'top:12%;right:9%;width:130px;height:130px' },
    { className: 'decor-eq', style: 'bottom:11%;left:7%' },
  ],
  'learning-path': [
    { className: 'decor-grid' },
    { className: 'decor-wave', style: 'bottom:4%' },
    { className: 'decor-eq', style: 'top:15%;right:6%' },
  ],
  minimal: [{ className: 'decor-grid' }],
  loading: [
    { className: 'decor-grid' },
    { className: 'decor-eq', style: 'bottom:14%;left:50%;margin-left:-25px' },
  ],
  error: [
    { className: 'decor-grid' },
    { className: 'decor-scanline' },
    { className: 'decor-eq', style: 'bottom:12%;left:8%' },
  ],
  info: [
    { className: 'decor-grid' },
    { className: 'decor-wave', style: 'top:12%' },
    { className: 'decor-orbit', style: 'top:16%;right:6%' },
  ],
  playground: [
    { className: 'decor-grid' },
    { className: 'decor-brackets', style: 'top:12%;left:3%' },
    { className: 'decor-terminal', style: 'bottom:12%;right:4%' },
    { className: 'decor-scanline' },
    { className: 'decor-caret', style: 'bottom:17%;right:13%' },
  ],
};

interface Props {
  variant?: GeoBgVariant;
}

const { variant = 'minimal' } = Astro.props;
const items = GEO_DECOR_CONFIG[variant];
---

<div class="decor-bg" aria-hidden="true">
  {
    items.map((item) =>
      item.className === 'decor-eq' ? (
        <div class="decor-eq" style={item.style}>
          <i />
          <i />
          <i />
        </div>
      ) : (
        <div class={item.className} style={item.style}>
          {item.content}
        </div>
      )
    )
  }
</div>
