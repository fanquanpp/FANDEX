      "50": { "$value": "#E5FFFD", "$description": "FANDEX accent-50" },
      "100": { "$value": "#B8FFFA", "$description": "FANDEX accent-100" },
      "200": { "$value": "#80FFF6", "$description": "FANDEX accent-200" },
      "300": { "$value": "#40FFF1", "$description": "FANDEX accent-300" },
      "400": { "$value": "#00FFED", "$description": "FANDEX accent-400（深色主色）" },
