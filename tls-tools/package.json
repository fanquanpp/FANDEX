{
  "name": "@fandex/tools",
  "version": "1.0.0",
  "description": "FANDEX 工具链：manifest 生成、ID 分配（当前阶段仅保留 generate-manifest 用于内容索引，签名/验证流程已移除）",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "generate-manifest": "tsx src/generate-manifest.ts",
    "allocate-id": "tsx src/allocate-id.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx src/**/*.test.ts"
  },
  "dependencies": {
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "commander": "catalog:",
    "fast-glob": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
