{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FANDEX",
  "version": "4.1.0",
  "identifier": "com.fandexpp.desktop",
  "build": {
    "beforeBuildCommand": "pnpm --filter @fandex/desktop build",
    "frontendDist": "../../app-web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
